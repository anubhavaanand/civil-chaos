# ===========================================
# Astro Web App - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit .env to git

# Strapi CMS Connection
# ---------------------
# Public URL for client-side fetching (visible in browser)
PUBLIC_STRAPI_URL=http://localhost:1337

# Public site URL (used for absolute URLs, SEO)
PUBLIC_SITE_URL=https://dreamoftheholyhimalayas.com

# MapTiler API Key (free tier: 100k loads/month)
# Get yours at: https://cloud.maptiler.com/
PUBLIC_MAPTILER_KEY=your_maptiler_key_here

# Server-Only Secrets
# -------------------
# Strapi API token with read + create permissions on booking-request
# Generate in Strapi Admin > Settings > API Tokens
STRAPI_API_TOKEN=

# Secret for validating Strapi webhook calls
# Must match WEB_REVALIDATE_SECRET in Strapi's .env
STRAPI_WEBHOOK_SECRET=your_webhook_secret_here

# Email notifications (Resend or SMTP)
# ------------------------------------
# Option 1: Resend API key (https://resend.com)
RESEND_API_KEY=

# Option 2: SMTP credentials (alternative to Resend)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourdomain.com

# Cloudflare Cache Purge (optional but recommended)
# -------------------------------------------------
# Required for ISR-style revalidation
# Get from Cloudflare dashboard > My Profile > API Tokens
CF_ZONE_ID=
CF_API_TOKEN=

# Phase 2: Razorpay (DO NOT CONFIGURE YET)
# ----------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
