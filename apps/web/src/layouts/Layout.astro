---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import ChatBot from '../components/ChatBot.astro';
import { SITE_CONFIG } from '../config/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Small-batch Himalayan trekking expeditions from Mautar, Uttarkashi. Led by 100% NIM and WFR certified native guides.",
  // The 1200x630 social card is not yet authored locally; this Unsplash frame is
  // the same one the homepage JSON-LD already declares, so the OG image is a
  // real, absolute, correctly-sized URL rather than a dangling reference.
  ogImage = "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?q=80&w=1200&h=630&auto=format&fit=crop"
} = Astro.props;

// ogImage may arrive as a full URL (pass a per-page card) or a site-relative
// path; only the latter needs the canonical origin prepended.
const canonicalUrl = new URL(Astro.url.pathname, SITE_CONFIG.canonicalUrl).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, SITE_CONFIG.canonicalUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{title}</title>
    <ViewTransitions fallback="animate" />
    <slot name="head" />
  </head>
  <body class="bg-slate-950 text-ink font-body min-h-screen">
    <!-- Aave-style refraction filter: referenced by .glass-refract layers.
         Displacement map encodes bend direction per channel; neutral core
         rgb(128,128,0) leaves most pixels unmoved. Decorative layers only. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <filter id="alpine-refraction" x="-6%" y="-6%" width="112%" height="112%" color-interpolation-filters="sRGB">
          <feImage
            href="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%27120%27%20height%3D%2780%27%3E%3Cdefs%3E%3ClinearGradient%20id%3D%27L%27%20x1%3D%270%27%20y1%3D%270%27%20x2%3D%271%27%20y2%3D%271%27%3E%3Cstop%20offset%3D%270%27%20stop-color%3D%27rgb(255%2C128%2C0)%27%2F%2F3E%3Cstop%20offset%3D%271%27%20stop-color%3D%27rgb(128%2C128%2C0)%27%2F%2F3E%3C%2FlinearGradient%3E%3ClinearGradient%20id%3D%27R%27%20x1%3D%270%27%20y1%3D%270%27%20x2%3D%271%27%3E%3Cstop%20offset%3D%270%27%20stop-color%3D%27rgb(128%2C128%2C0)%27%2F%2F3E%3Cstop%20offset%3D%271%27%20stop-color%3D%27rgb(128%2C128%2C0)%27%2F%2F3E%3C%2FlinearGradient%3E%3ClinearGradient%20id%3D%27T%27%20x1%3D%270%27%20y1%3D%270%27%20x2%3D%270%27%20y2%3D%271%27%3E%3Cstop%20offset%3D%270%27%20stop-color%3D%27rgb(128%2C128%2C0)%27%2F%2F3E%3Cstop%20offset%3D%271%27%20stop-color%3D%27rgb(128%2C128%2C0)%27%2F%2F3E%3C%2FlinearGradient%3E%3ClinearGradient%20id%3D%27B%27%20x1%3D%270%27%20y1%3D%270%27%20x2%3D%271%27%20y2%3D%271%27%3E%3Cstop%20offset%3D%270%27%20stop-color%3D%27rgb(128%2C128%2C0)%27%2F%2F3E%3Cstop%20offset%3D%271%27%20stop-color%3D%27rgb(128%2C128%2C0)%27%2F%2F3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Crect%20width%3D%27120%27%20height%3D%2780%27%20fill%3D%27rgb(128%2C128%2C0)%27%2F%2F3E%3Crect%20x%3D%270%27%20y%3D%270%27%20width%3D%2714%27%20height%3D%2780%27%20fill%3D%27url(%23L)%27%2F%2F3E%3Crect%20x%3D%27106%27%20y%3D%270%27%20width%3D%2714%27%20height%3D%2780%27%20fill%3D%27url(%23R)%27%2F%2F3E%3Crect%20x%3D%270%27%20y%3D%2710%27%20width%3D%27120%27%20height%3D%2770%27%20fill%3D%27url(%23T)%27%2F%2F3E%3Crect%20x%3D%270%27%20y%3D%2760%27%20width%3D%27120%27%20height%3D%2770%27%20fill%3D%27url(%23B)%27%2F%2F3E%3C%2Fsvg%27"
            x="0" y="0" width="100%" height="100%" preserveAspectRatio="none" result="lensmap"
          />
          <feDisplacementMap in="SourceGraphic" in2="lensmap" scale="22" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>
    </svg>
    <slot />
    <ChatBot />
  </body>
</html>
