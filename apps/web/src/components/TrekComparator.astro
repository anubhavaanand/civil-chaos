---
// TrekComparator.astro
// Side-by-Side Himalayan Trek Comparison Matrix
---

<div class="w-full rounded-2xl bg-slate-900/90 border border-slate-800 p-6 shadow-2xl backdrop-blur-xl">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-5 border-b border-slate-800">
    <div>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-[#00f2fe]/20 text-[#00f2fe] border border-[#00f2fe]/30 uppercase tracking-wide">
        Expedition Decision Matrix
      </span>
      <h3 class="text-xl font-display font-bold text-white mt-1 flex items-center gap-2">
        <svg class="w-5 h-5 text-[#00f2fe]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
        </svg>
        <span>Compare Himalayan Expeditions</span>
      </h3>
    </div>
    <div class="text-xs text-silver font-mono">
      Side-by-Side Altitude, Difficulty &amp; Pricing
    </div>
  </div>

  <!-- Comparison Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-6">
    <!-- Trek 1: Kedarkantha -->
    <div class="p-5 rounded-xl bg-slate-950/70 border border-[#00f2fe]/30 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#00f2fe]/20 text-[#00f2fe] border border-[#00f2fe]/30 font-mono">Garhwal</span>
          <span class="text-xs font-mono font-bold text-emerald-400">₹8,500</span>
        </div>
        <h4 class="text-lg font-display font-bold text-white">Kedarkantha Winter</h4>
        <p class="text-xs text-silver mt-1">Pinnacle 360&deg; winter summit snow climb</p>

        <div class="mt-4 pt-4 border-t border-white/10 space-y-2 text-xs font-mono">
          <div class="flex justify-between"><span class="text-silver">Max Altitude:</span><span class="font-bold text-[#00f2fe]">12,500 ft (3,810 m)</span></div>
          <div class="flex justify-between"><span class="text-silver">Duration:</span><span class="font-bold text-white">5 Days / 4 Nights</span></div>
          <div class="flex justify-between"><span class="text-silver">Difficulty:</span><span class="font-bold text-emerald-400">Easy-Moderate</span></div>
          <div class="flex justify-between"><span class="text-silver">Trek Distance:</span><span class="font-bold text-white">20 KM Total</span></div>
          <div class="flex justify-between"><span class="text-silver">Best Season:</span><span class="font-bold text-amber-300">Dec - April (Snow)</span></div>
          <div class="flex justify-between"><span class="text-silver">Oxygen %:</span><span class="font-bold text-emerald-400">~ 76% (Low AMS Risk)</span></div>
        </div>
      </div>

      <div class="mt-6">
        <a href="/treks/kedarkantha" class="btn-tactile block w-full py-2.5 rounded-xl bg-[#00f2fe] hover:bg-white text-[#050505] font-bold text-xs text-center shadow transition uppercase font-mono">
          View Expedition Details
        </a>
      </div>
    </div>

    <!-- Trek 2: Kuari Pass -->
    <div class="p-5 rounded-xl bg-slate-950/70 border border-white/15 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#00f2fe]/20 text-[#00f2fe] border border-[#00f2fe]/30 font-mono">Garhwal</span>
          <span class="text-xs font-mono font-bold text-emerald-400">₹9,500</span>
        </div>
        <h4 class="text-lg font-display font-bold text-white">Kuari Pass Ridge</h4>
        <p class="text-xs text-silver mt-1">Lord Curzon trail facing Nanda Devi</p>

        <div class="mt-4 pt-4 border-t border-white/10 space-y-2 text-xs font-mono">
          <div class="flex justify-between"><span class="text-silver">Max Altitude:</span><span class="font-bold text-[#00f2fe]">12,716 ft (3,876 m)</span></div>
          <div class="flex justify-between"><span class="text-silver">Duration:</span><span class="font-bold text-white">6 Days / 5 Nights</span></div>
          <div class="flex justify-between"><span class="text-silver">Difficulty:</span><span class="font-bold text-amber-400">Moderate</span></div>
          <div class="flex justify-between"><span class="text-silver">Trek Distance:</span><span class="font-bold text-white">33 KM Total</span></div>
          <div class="flex justify-between"><span class="text-silver">Best Season:</span><span class="font-bold text-amber-300">Nov - April (Winter)</span></div>
          <div class="flex justify-between"><span class="text-silver">Oxygen %:</span><span class="font-bold text-emerald-400">~ 75% (Moderate Pacing)</span></div>
        </div>
      </div>

      <div class="mt-6">
        <a href="/treks/kuari-pass" class="btn-tactile block w-full py-2.5 rounded-xl bg-white/10 hover:bg-[#00f2fe] hover:text-[#050505] text-[#00f2fe] font-bold text-xs text-center border border-white/15 shadow transition uppercase font-mono">
          View Expedition Details
        </a>
      </div>
    </div>

    <!-- Trek 3: Bali Pass Alpine -->
    <div class="p-5 rounded-xl bg-slate-950/70 border border-white/15 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30 font-mono">Garhwal</span>
          <span class="text-xs font-mono font-bold text-emerald-400">₹19,500</span>
        </div>
        <h4 class="text-lg font-display font-bold text-white">Bali Pass Traverse</h4>
        <p class="text-xs text-silver mt-1">High-altitude knife-ridge technical pass</p>

        <div class="mt-4 pt-4 border-t border-white/10 space-y-2 text-xs font-mono">
          <div class="flex justify-between"><span class="text-silver">Max Altitude:</span><span class="font-bold text-[#00f2fe]">16,207 ft (4,940 m)</span></div>
          <div class="flex justify-between"><span class="text-silver">Duration:</span><span class="font-bold text-white">8 Days / 7 Nights</span></div>
          <div class="flex justify-between"><span class="text-silver">Difficulty:</span><span class="font-bold text-rose-400">Difficult</span></div>
          <div class="flex justify-between"><span class="text-silver">Trek Distance:</span><span class="font-bold text-white">66 KM Total</span></div>
          <div class="flex justify-between"><span class="text-silver">Best Season:</span><span class="font-bold text-amber-300">May - June, Sept - Oct</span></div>
          <div class="flex justify-between"><span class="text-silver">Oxygen %:</span><span class="font-bold text-rose-400">~ 55% (High AMS Protocol)</span></div>
        </div>
      </div>

      <div class="mt-6">
        <a href="/treks/bali-pass" class="btn-tactile block w-full py-2.5 rounded-xl bg-white/10 hover:bg-[#00f2fe] hover:text-[#050505] text-[#00f2fe] font-bold text-xs text-center border border-white/15 shadow transition uppercase font-mono">
          View Expedition Details
        </a>
      </div>
    </div>
  </div>
</div>
