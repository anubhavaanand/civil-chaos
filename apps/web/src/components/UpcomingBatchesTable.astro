---
import type { Batch } from '../lib/strapi';

interface Props {
  batches: Batch[];
  trekName: string;
  trekSlug: string;
}

const { batches } = Astro.props;

const formatDate = (dateStr: string) => {
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
};

const isLowSeatsCheck = (seats: number) => seats > 0 && seats <= 5;
---

<div class="overflow-x-auto rounded-2xl border border-white/15 bg-[#0B111E]/90 backdrop-blur-md shadow-xl">
  <table class="w-full text-left text-sm text-ink border-collapse">
    <thead class="bg-[#050505]/90 text-xs font-mono uppercase tracking-wider text-[#00F2FE] border-b border-white/15">
      <tr>
        <th class="py-3.5 px-4 font-semibold">Departure Dates</th>
        <th class="py-3.5 px-4 font-semibold">Batch Status</th>
        <th class="py-3.5 px-4 font-semibold">Base Price / Climber</th>
        <th class="py-3.5 px-4 font-semibold text-right">Action</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-white/10 font-mono text-xs sm:text-sm">
      {batches.length === 0 ? (
        <tr>
          <td colspan="4" class="py-6 px-4 text-center text-ink-dim">
            No open fixed departures currently. Contact our Mautar desk for custom private group dates.
          </td>
        </tr>
      ) : (
        batches.map((batch) => {
          const seatsLeft = batch.seatsTotal - batch.seatsBooked;
          const isFull = batch.status === 'full' || seatsLeft === 0;
          const isLowSeats = isLowSeatsCheck(seatsLeft);
          return (
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-4 px-4 font-semibold text-[#F8FAFC]">
                <div>{formatDate(batch.startDate)} &ndash; {formatDate(batch.endDate)}</div>
              </td>
              <td class="py-4 px-4">
                {isFull ? (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-[#FB7185]/15 px-3 py-1 text-xs font-bold text-[#FB7185] border border-[#FB7185]/30">
                    Full
                  </span>
                ) : isLowSeats ? (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-[#FBBF24]/15 px-3 py-1 text-xs font-bold text-[#FBBF24] border border-[#FBBF24]/30">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#FBBF24] animate-pulse"></span>
                    Only {seatsLeft} seats left
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-[#34D399]/15 px-3 py-1 text-xs font-bold text-[#34D399] border border-[#34D399]/30">
                    Available ({seatsLeft} seats)
                  </span>
                )}
              </td>
              <td class="py-4 px-4 font-bold text-[#00F2FE]">
                ₹{batch.pricePerPersonINR.toLocaleString('en-IN')}
              </td>
              <td class="py-4 px-4 text-right">
                {isFull ? (
                  <button disabled class="rounded-lg bg-slate-800 px-3.5 py-2 text-xs font-semibold text-[#94A3B8] cursor-not-allowed">
                    Sold Out
                  </button>
                ) : (
                  <button
                    type="button"
                    data-open-modal="booking-modal"
                    data-batch-id={batch.id}
                    data-dates={`${formatDate(batch.startDate)} - ${formatDate(batch.endDate)}`}
                    class="open-booking-trigger btn-tactile cursor-pointer rounded-xl bg-[#00F2FE] hover:bg-[#00b4d8] px-4 py-2 text-xs font-bold uppercase tracking-wider text-[#050505] shadow-md transition-all"
                  >
                    Select Batch
                  </button>
                )}
              </td>
            </tr>
          );
        })
      )}
    </tbody>
  </table>
</div>
