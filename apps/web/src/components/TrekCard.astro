---
import DifficultyBadge from './DifficultyBadge.astro';
import type { Trek } from '../lib/strapi';

interface Props {
  trek: Trek;
}

const { trek } = Astro.props;
const { name, slug, region, difficulty, durationDays, maxAltitudeM, trekDistanceKm, startPoint, fromPrice, heroImage, summary, packages = [] } = trek;
const maxAltFt = Math.round(maxAltitudeM * 3.28084).toLocaleString('en-IN');
---
<article class="group relative flex flex-col h-full overflow-hidden rounded-2xl border border-white/15 bg-[#0B111E]/95 shadow-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#00F2FE]/50">
  <a href={`/treks/${slug}`} class="relative block w-full aspect-[16/10] overflow-hidden bg-[#050505]">
    <img
      src={heroImage}
      alt={name}
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0B111E] via-transparent to-black/40"></div>

    <div class="absolute top-3 left-3 flex items-center gap-2 z-10">
      <span class="px-2.5 py-1 rounded-md text-[10px] font-mono font-bold uppercase tracking-wider bg-[#050505]/85 text-[#00F2FE] border border-[#00F2FE]/30 backdrop-blur-md">
        {region}
      </span>
    </div>

    <div class="absolute top-3 right-3 z-10">
      <DifficultyBadge difficulty={difficulty} />
    </div>

    <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-xs font-mono text-white z-10">
      <span class="px-2.5 py-1 rounded-md bg-[#050505]/85 border border-white/15 backdrop-blur-sm">
        Max Alt: <strong class="text-[#00F2FE]">{maxAltitudeM.toLocaleString('en-IN')}m</strong> ({maxAltFt} ft)
      </span>
      <span class="px-2.5 py-1 rounded-md bg-[#050505]/85 border border-white/15 backdrop-blur-sm">
        {durationDays}D / {durationDays - 1}N
      </span>
    </div>
  </a>

  <div class="p-5 flex flex-col flex-grow justify-between gap-4">
    <div>
      <h3 class="text-xl font-bold font-display text-white group-hover:text-[#00F2FE] transition-colors">
        <a href={`/treks/${slug}`}>{name}</a>
      </h3>
      <p class="text-xs text-[#94A3B8] mt-1.5 line-clamp-2 leading-relaxed">{summary}</p>

      <div class="grid grid-cols-2 gap-2 mt-4 pt-3 border-t border-white/10 text-xs font-mono text-[#cbd5e1]">
        <div>Trail: <strong>{trekDistanceKm} km</strong></div>
        <div class="truncate" title={startPoint}>Base: <strong>{startPoint.split(',')[0]}</strong></div>
      </div>

      {packages.length > 0 && (
        <div class="mt-3 pt-3 border-t border-white/10 space-y-1.5">
          <span class="block text-[10px] font-mono uppercase tracking-wider text-[#94A3B8]">
            Strapi Package Options:
          </span>
          {packages.slice(0, 2).map((pkg) => (
            <div class="flex items-center justify-between text-xs font-mono bg-white/5 px-2.5 py-1.5 rounded-lg border border-white/5">
              <span class="text-[#e8eef2] truncate pr-2">{pkg.name}</span>
              <span class="text-[#00F2FE] font-bold shrink-0">₹{pkg.priceINR.toLocaleString('en-IN')}</span>
            </div>
          ))}
        </div>
      )}
    </div>

    <div class="pt-4 border-t border-white/10 flex items-center justify-between gap-3">
      <div>
        <span class="block text-[10px] font-mono uppercase tracking-wider text-[#94A3B8]">All-Inclusive From</span>
        <span class="font-display text-xl font-extrabold text-white">
          ₹{fromPrice.toLocaleString('en-IN')}
        </span>
      </div>

      <a
        href={`/treks/${slug}`}
        class="btn-tactile inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-[#00F2FE] hover:bg-[#00b4d8] text-[#050505] font-mono text-xs font-bold uppercase tracking-wider transition-all"
      >
        <span>View Itinerary</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</article>
