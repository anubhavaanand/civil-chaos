---
import type { Trek } from '../lib/strapi';

interface Props {
  treks: Trek[];
}

---

<section id="interactive-map" class="py-24 relative border-t border-white/10 bg-[#050505]">
  <div class="max-w-7xl mx-auto px-6 mb-8">
    <div class="flex items-center gap-3 mb-4">
      <div class="h-[1px] w-8 bg-[#00F2FE]"></div>
      <span class="text-[#00F2FE] font-mono text-xs uppercase tracking-[0.2em]">Expedition Cartography</span>
    </div>
    <h2 class="text-3xl md:text-5xl font-bold text-[#F8FAFC] mb-6 tracking-tight">Himalayan <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#F8FAFC] to-[#F8FAFC]/60">Topography</span></h2>
  </div>

  <div class="max-w-7xl mx-auto px-6">
    <div id="maplibre-container" class="w-full h-[600px] rounded-2xl overflow-hidden border border-white/10 relative shadow-xl" data-treks-url="/treks-geojson.json">
      
      <!-- Loading state: a skeletal placeholder shaped like the map panel, not a spinner -->
      <div id="map-loader" class="absolute inset-0 bg-[#050505] z-10 transition-opacity duration-700 overflow-hidden">
        <div class="absolute inset-0 opacity-60">
          <!-- Contour lines standing in for the terrain tiles still loading -->
          <div class="absolute inset-x-0 top-[18%] h-px bg-white/5"></div>
          <div class="absolute inset-x-0 top-[38%] h-px bg-white/5"></div>
          <div class="absolute inset-x-0 top-[58%] h-px bg-white/5"></div>
          <div class="absolute inset-x-0 top-[78%] h-px bg-white/5"></div>
          <div class="absolute inset-y-0 left-[22%] w-px bg-white/5"></div>
          <div class="absolute inset-y-0 left-[48%] w-px bg-white/5"></div>
          <div class="absolute inset-y-0 left-[74%] w-px bg-white/5"></div>
        </div>
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-4">
          <span class="ping-ring w-3 h-3 rounded-full bg-[#00F2FE]"></span>
          <span class="text-[#00F2FE] font-mono text-xs tracking-widest uppercase">Linking satellite imagery</span>
        </div>
      </div>

      <div id="map" class="w-full h-full"></div>
    </div>
  </div>
</section>

<script is:inline>
  // MapLibre GL initialization — runs when client:visible hydrates this component.
  // Lazy-loaded to protect Page LCP (Largest Contentful Paint).
  const container = document.getElementById('maplibre-container');

  if (container) {
    async function loadMapLibre() {
      try {
        // Dynamically import MapLibre JS & CSS
        const maplibreModule = await import('maplibre-gl');
        const maplibregl = maplibreModule.default || maplibreModule;
        await import('maplibre-gl/dist/maplibre-gl.css');

        const treksUrl = container?.dataset.treksUrl;
        if (!treksUrl) return;
        
        let treks = [];
        try {
          const res = await fetch(treksUrl);
          const geojson = await res.json();
          treks = geojson.features.map((f: any) => ({
            coordinates: f.geometry.coordinates,
            name: f.properties.name,
            slug: f.properties.slug,
            difficulty: f.properties.difficulty,
            maxAltitudeM: f.properties.maxAltitudeM,
          }));
        } catch (err) {
          console.error("Failed to load treks GeoJSON:", err);
        }
        
        // A MapTiler key unlocks satellite terrain (set PUBLIC_MAPTILER_KEY). Without
        // one we fall back to CARTO's keyless dark style, which renders the pins and
        // the region geometry correctly and needs no account.
        const mapKey = import.meta.env.PUBLIC_MAPTILER_KEY;
        const hasMaptiler = Boolean(mapKey && mapKey.length > 0);

        const map = new maplibregl.Map({
          container: 'map',
          style: hasMaptiler
            ? `https://api.maptiler.com/maps/outdoor-v2/style.json?key=${mapKey}`
            : {
                version: 8,
                glyphs: 'https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf',
                sources: {
                  carto: {
                    type: 'raster',
                    tiles: [
                      'https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',
                      'https://b.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',
                      'https://c.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png'
                    ],
                    tileSize: 256,
                    attribution: '&copy; OpenStreetMap contributors &copy; CARTO'
                  }
                },
                layers: [
                  {
                    id: 'carto-dark',
                    type: 'raster',
                    source: 'carto',
                    minzoom: 0,
                    maxzoom: 20
                  }
                ]
              },
          center: [79.0, 30.7], // Center on Uttarakhand
          zoom: 7.5,
          maxPitch: 0,           // Spec: NO pitch, NO 3D terrain
          attributionControl: true, // Spec: visible OSM + MapTiler attribution
          cooperativeGestures: true, // Spec: page scroll isn't trapped
          touchPitch: false,     // Spec: mobile touch pitch disabled
        });

        map.addControl(new maplibregl.NavigationControl(), 'top-right');

        map.on('error', (e: any) => {
          console.error("MapLibre tile/style error:", e);
          const loader = document.getElementById('map-loader');
          if (loader) {
            loader.innerHTML =
              '<div class="absolute inset-0 flex flex-col items-center justify-center gap-3 px-6 text-center">'
              + '<span class="text-[#00F2FE] font-mono text-xs tracking-widest uppercase">Basemap Unavailable</span>'
              + '<span class="text-silver/60 font-mono text-[11px] max-w-sm">Route coordinates are still listed in the expedition catalog below.</span>'
              + '</div>';
          }
        });

        map.on('load', () => {
          // Fade out loader
          const loader = document.getElementById('map-loader');
          if (loader) {
            loader.style.opacity = '0';
            setTimeout(() => loader.style.display = 'none', 700);
          }

          // Add Trek Pins
          treks.forEach((trek: any) => {
            if (!trek.coordinates || trek.coordinates.length < 2) return;

            const el = document.createElement('div');
            el.className = 'w-4 h-4 bg-[#00F2FE] rounded-full shadow-md border-2 border-white cursor-pointer hover:scale-150 hover:bg-[#0a0f18] transition-all duration-300';
            
            const popupHtml = `
              <div class="bg-[#0a0f18]/95 border border-white/10 p-4 rounded-lg backdrop-blur-md min-w-[200px]">
                <div class="flex items-center gap-2 mb-2">
                  <span class="w-2 h-2 rounded-full ${trek.difficulty === 'easy' ? 'bg-[#34D399]' : trek.difficulty === 'moderate' ? 'bg-[#FBBF24]' : 'bg-[#FB7185]'}"></span>
                  <span class="text-xs font-mono text-[#94A3B8] uppercase">${trek.difficulty}</span>
                </div>
                <h3 class="text-[#F8FAFC] font-bold text-base leading-tight mb-1">${trek.name}</h3>
                <p class="text-[#00F2FE] font-mono text-xs mb-3">ALT: ${trek.maxAltitudeM}m</p>
                <a href="/treks/${trek.slug}" class="inline-block w-full text-center py-2 bg-[#050505]/5 text-[#F8FAFC] hover:bg-[#0a0f18]/10 text-[#F8FAFC] text-xs font-mono uppercase tracking-wider rounded transition-colors">
                  View Telemetry
                </a>
              </div>
            `;

            const popup = new maplibregl.Popup({ offset: 25, className: 'dark-alpine-popup' })
              .setHTML(popupHtml);

            new maplibregl.Marker({ element: el })
              .setLngLat(trek.coordinates)
              .setPopup(popup)
              .addTo(map);
          });
        });

      } catch (err) {
        console.error("MapLibre load failed:", err);
      }
    }

    loadMapLibre();
  }
</script>

<style is:global>
/* Override MapLibre default light popups to match Alpine Glass */
.dark-alpine-popup .maplibregl-popup-content {
  background: transparent !important;
  padding: 0 !important;
  border-radius: 8px !important;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8) !important;
}
.dark-alpine-popup .maplibregl-popup-tip {
  border-top-color: rgba(5, 5, 5, 0.95) !important;
  border-bottom-color: rgba(5, 5, 5, 0.95) !important;
}
.maplibregl-ctrl-group {
  background: rgba(10, 15, 24, 0.9) !important;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.1);
}
.maplibregl-ctrl-group button {
  
}
</style>
