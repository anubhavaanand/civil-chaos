---
import type { Trek } from '../lib/strapi';
import regionBoundaries from '../data/region-boundaries.json';

interface Props {
  treks: Trek[];
}

const REGION_CHIPS = [
  { slug: 'all', name: 'All Regions', bounds: null as [number, number, number, number] | null },
  { slug: 'garhwal', name: 'Garhwal', bounds: [78.0, 30.0, 79.9, 31.3] },
  { slug: 'kumaon', name: 'Kumaon', bounds: [79.2, 29.3, 80.5, 30.6] },
  { slug: 'himachal', name: 'Himachal', bounds: [76.5, 31.0, 78.5, 32.8] },
] as const;

---

<section id="interactive-map" class="py-24 relative border-t border-white/10 bg-[#050505]">
  <div class="max-w-7xl mx-auto px-6 mb-8">
    <div class="flex items-center gap-3 mb-4">
      <div class="h-[1px] w-8 bg-[#00F2FE]"></div>
      <span class="text-[#00F2FE] font-mono text-xs uppercase tracking-[0.2em]">Expedition Cartography</span>
    </div>
    <h2 class="text-3xl md:text-5xl font-bold text-[#F8FAFC] mb-6 tracking-tight">Himalayan <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#F8FAFC] to-[#F8FAFC]/60">Topography</span></h2>
  </div>

  <!-- Region filter chips (no-JS fallback: link to region pages) -->
  <div class="max-w-7xl mx-auto px-6 mb-6 flex flex-wrap gap-2">
    {REGION_CHIPS.map((chip) => (
      <button
        data-region={chip.slug}
        class={`region-chip px-4 py-2 rounded-sm text-xs font-mono font-bold uppercase tracking-wider transition-all cursor-pointer border ${
          chip.slug === 'all'
            ? 'bg-[#00F2FE] text-[#F9FAFB] border-[#00F2FE]'
            : 'bg-[#0a0f18] border-white/10 text-[#94A3B8] hover:border-[#00F2FE]/50 hover:text-[#F8FAFC]'
        }`}
      >
        {chip.name}
      </button>
    ))}
  </div>

  <div class="max-w-7xl mx-auto px-6">
    <div id="maplibre-container" class="w-full h-[600px] rounded-2xl overflow-hidden border border-white/10 relative shadow-xl" data-treks-url="/treks-geojson.json">
      
      <!-- Loading state: a skeletal placeholder shaped like the map panel -->
      <div id="map-loader" class="absolute inset-0 bg-[#050505] z-10 transition-opacity duration-700 overflow-hidden">
        <div class="absolute inset-0 opacity-60">
          <div class="absolute inset-x-0 top-[18%] h-px bg-white/5"></div>
          <div class="absolute inset-x-0 top-[38%] h-px bg-white/5"></div>
          <div class="absolute inset-x-0 top-[58%] h-px bg-white/5"></div>
          <div class="absolute inset-x-0 top-[78%] h-px bg-white/5"></div>
          <div class="absolute inset-y-0 left-[22%] w-px bg-white/5"></div>
          <div class="absolute inset-y-0 left-[48%] w-px bg-white/5"></div>
          <div class="absolute inset-y-0 left-[74%] w-px bg-white/5"></div>
        </div>
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-4">
          <span class="ping-ring w-3 h-3 rounded-full bg-[#00F2FE]"></span>
          <span class="text-[#00F2FE] font-mono text-xs tracking-widest uppercase">Linking satellite imagery</span>
        </div>
      </div>

      <div id="map" class="w-full h-full" role="region" aria-label="Himalayan trek map" aria-describedby="map-description"></div>
      <p id="map-description" class="sr-only">Interactive map of Himalayan trekking expeditions. Use region chips to filter by Garhwal, Kumaon, or Himachal Pradesh. Click markers for trek details.</p>

      <!-- No-JS fallback: always-visible trek list below the map -->
      <noscript>
        <div class="mt-8 rounded-2xl border border-white/10 bg-[#0a0f18]/80 backdrop-blur-md p-6">
          <h3 class="font-display text-xl font-bold text-white mb-4">Browse All Treks</h3>
          <p class="text-silver text-sm mb-4">JavaScript is required for the interactive map. Browse the full expedition catalog below instead.</p>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {treks.map((trek) => (
              <article class="p-4 rounded-lg border border-white/10 bg-[#0a0f18]/50">
                <div class="flex items-center gap-2 mb-2">
                  <span class="w-2 h-2 rounded-full ${trek.difficulty === 'easy' ? 'bg-[#34D399]' : trek.difficulty === 'moderate' ? 'bg-[#FBBF24]' : 'bg-[#FB7185]'}"></span>
                  <span class="text-xs font-mono text-[#94A3B8] uppercase">${trek.difficulty}</span>
                </div>
                <h4 class="font-bold text-white text-base mb-1"><a href="/treks/${trek.slug}" class="hover:text-[#00F2FE]">${trek.name}</a></h4>
                <p class="text-[#00F2FE] font-mono text-xs mb-3">ALT: ${trek.maxAltitudeM}m</p>
                <a href="/treks/${trek.slug}" class="inline-block px-3 py-1.5 rounded-sm bg-[#050505]/5 text-[#F8FAFC] text-xs font-mono uppercase tracking-wider hover:bg-[#00F2FE]/10 transition-colors">View Telemetry</a>
              </article>
            ))}
          </div>
        </div>
      </noscript>
    </div>
  </div>
</section>

<script is:inline>
  // MapLibre GL initialization — runs when client:visible hydrates this component.
  const container = document.getElementById('maplibre-container');

  if (container) {
    async function loadMapLibre() {
      try {
        const maplibreModule = await import('maplibre-gl');
        const maplibregl = maplibreModule.default || maplibreModule;
        await import('maplibre-gl/dist/maplibre-gl.css');

        const treksUrl = container?.dataset.treksUrl;
        if (!treksUrl) return;

        let treks = [];
        try {
          const res = await fetch(treksUrl);
          const geojson = await res.json();
          treks = geojson.features;
        } catch (err) {
          console.error("Failed to load treks GeoJSON:", err);
        }

        // Region bounds (same as frontmatter REGION_CHIPS, available client-side)
        const REGION_BOUNDS = {
          all: [76.5, 29.3, 80.5, 32.8],       // Combined: Garhwal + Kumaon + Himachal
          garhwal: [78.0, 30.0, 79.9, 31.3],
          kumaon: [79.2, 29.3, 80.5, 30.6],
          himachal: [76.5, 31.0, 78.5, 32.8],
        };

        const mapKey = import.meta.env.PUBLIC_MAPTILER_KEY;
        const hasMaptiler = Boolean(mapKey && mapKey.length > 0);

        const map = new maplibregl.Map({
          container: 'map',
          style: hasMaptiler
            ? `https://api.maptiler.com/maps/outdoor-v2/style.json?key=${mapKey}`
            : {
                version: 8,
                glyphs: 'https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf',
                sources: {
                  carto: {
                    type: 'raster',
                    tiles: [
                      'https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',
                      'https://b.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',
                      'https://c.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png'
                    ],
                    tileSize: 256,
                    attribution: '&copy; OpenStreetMap contributors &copy; CARTO'
                  }
                },
                layers: [
                  {
                    id: 'carto-dark',
                    type: 'raster',
                    source: 'carto',
                    minzoom: 0,
                    maxzoom: 20
                  }
                ]
              },
          center: [79.0, 30.7],
          zoom: 7.5,
          maxZoom: 10,
          maxPitch: 0,
          attributionControl: true,
          cooperativeGestures: true,
          touchPitch: false,
        });

        map.addControl(new maplibregl.NavigationControl(), 'top-right');

        // Add treks as a GeoJSON source with clustering
        map.on('load', () => {
          // Fade out loader
          const loader = document.getElementById('map-loader');
          if (loader) {
            loader.style.opacity = '0';
            setTimeout(() => loader.style.display = 'none', 700);
          }

          // Add GeoJSON source with clustering per MAP_COMPONENT_SPEC
          map.addSource('treks', {
            type: 'geojson',
            data: {
              type: 'FeatureCollection',
              features: treks
            },
            cluster: true,
            clusterMaxZoom: 7,
            clusterRadius: 42,
          });

          // Cluster layer: circles sized by point count
          map.addLayer({
            id: 'clusters',
            type: 'circle',
            source: 'treks',
            filter: ['has', 'point_count'],
            paint: {
              'circle-color': [
                'step',
                ['get', 'point_count'],
                '#00f2fe',       // 1-9: glacier cyan
                10, '#00b4d8',   // 10-49: glacier deep
                50, '#0f766e',   // 50+: brand deep
              ],
              'circle-radius': [
                'step',
                ['get', 'point_count'],
                20,              // <10: 20px
                10, 30,          // 10-49: 30px
                50, 40,          // 50+: 40px
              ],
              'circle-opacity': 0.85,
              'circle-stroke-width': 2,
              'circle-stroke-color': '#050505',
            },
          });

          // Cluster count text
          map.addLayer({
            id: 'cluster-count',
            type: 'symbol',
            source: 'treks',
            filter: ['has', 'point_count'],
            layout: {
              'text-field': '{point_count_abbreviated}',
              'text-font': ['DIN Offc Pro Medium', 'Arial Unicode MS Regular'],
              'text-size': 12,
            },
            paint: {
              'text-color': '#ffffff',
            },
          });

          // Unclustered points: individual trek markers
          map.addLayer({
            id: 'unclustered-point',
            type: 'circle',
            source: 'treks',
            filter: ['!', ['has', 'point_count']],
            paint: {
              'circle-color': '#00f2fe',
              'circle-radius': 6,
              'circle-stroke-width': 2,
              'circle-stroke-color': '#ffffff',
            },
          });

          // Click handler for clusters → zoom in
          map.on('click', 'clusters', (e) => {
            const features = map.queryRenderedFeatures(e.point, { layers: ['clusters'] });
            const clusterId = features[0].properties.cluster_id;
            map.getSource('treks').getClusterExpansionZoom(clusterId, (err, zoom) => {
              if (err) return;
              map.easeTo({
                center: features[0].geometry.coordinates,
                zoom: zoom,
              });
            });
          });

          // Click handler for individual points → popup
          map.on('click', 'unclustered-point', (e) => {
            const coordinates = e.features[0].geometry.coordinates.slice();
            const properties = e.features[0].properties;

            // Fix for coords wrapping
            while (Math.abs(e.lngLat.lng - coordinates[0]) > 180) {
              coordinates[0] += e.lngLat.lng > coordinates[0] ? 360 : -360;
            }

            const difficultyColor = properties.difficulty === 'easy' ? '#34D399'
              : properties.difficulty === 'moderate' ? '#FBBF24' : '#FB7185';

            new maplibregl.Popup({ offset: 25, className: 'dark-alpine-popup' })
              .setLngLat(coordinates)
              .setHTML(`
                <div class="bg-[#0a0f18]/95 border border-white/10 p-4 rounded-lg backdrop-blur-md min-w-[200px]">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="w-2 h-2 rounded-full ${difficultyColor}"></span>
                    <span class="text-xs font-mono text-[#94A3B8] uppercase">${properties.difficulty}</span>
                  </div>
                  <h3 class="text-[#F8FAFC] font-bold text-base leading-tight mb-1">${properties.name}</h3>
                  <p class="text-[#00f2fe] font-mono text-xs mb-3">ALT: ${properties.maxAltitudeM}m</p>
                  <a href="/treks/${properties.slug}" class="inline-block w-full text-center py-2 bg-[#050505]/5 text-[#F8FAFC] hover:bg-[#0a0f18]/10 text-[#F8FAFC] text-xs font-mono uppercase tracking-wider rounded transition-colors">
                    View Telemetry
                  </a>
                </div>
              `)
              .addTo(map);
          });

          // Change cursor on hover
          map.on('mouseenter', 'clusters', () => {
            map.getCanvas().style.cursor = 'pointer';
          });
          map.on('mouseleave', 'clusters', () => {
            map.getCanvas().style.cursor = '';
          });
          map.on('mouseenter', 'unclustered-point', () => {
            map.getCanvas().style.cursor = 'pointer';
          });
          map.on('mouseleave', 'unclustered-point', () => {
            map.getCanvas().style.cursor = '';
          });

          // Region chip filter + fitBounds
          const chips = document.querySelectorAll('.region-chip');
          chips.forEach((chip) => {
            chip.addEventListener('click', () => {
              const regionSlug = chip.getAttribute('data-region');

              // Update chip UI
              chips.forEach((c) => {
                c.classList.remove('bg-[#00F2FE]', 'text-[#F9FAFB]', 'border-[#00F2FE]');
                c.classList.add('bg-[#0a0f18]', 'border-white/10', 'text-[#94A3B8]');
              });
              chip.classList.remove('bg-[#0a0f18]', 'border-white/10', 'text-[#94A3B8]');
              chip.classList.add('bg-[#00F2FE]', 'text-[#F9FAFB]', 'border-[#00F2FE]');

              if (regionSlug === 'all') {
                map.setFilter('clusters', ['has', 'point_count']);
                map.setFilter('unclustered-point', ['!', ['has', 'point_count']]);
                // Fit bounds to all regions
                map.fitBounds(REGION_BOUNDS.all, { padding: 40, maxZoom: 10 });
              } else {
                map.setFilter('clusters', ['==', ['get', 'regionSlug'], regionSlug]);
                map.setFilter('unclustered-point', ['==', ['get', 'regionSlug'], regionSlug]);
                const bounds = REGION_BOUNDS[regionSlug];
                if (bounds) {
                  map.fitBounds(bounds, { padding: 40, maxZoom: 10 });
                }
              }
            });
          });
        });

        map.on('error', (e) => {
          console.error("MapLibre tile/style error:", e);
          const loader = document.getElementById('map-loader');
          if (loader) {
            loader.innerHTML =
              '<div class="absolute inset-0 flex flex-col items-center justify-center gap-3 px-6 text-center">'
              + '<span class="text-[#00F2FE] font-mono text-xs tracking-widest uppercase">Basemap Unavailable</span>'
              + '<span class="text-silver/60 font-mono text-[11px] max-w-sm">Route coordinates are still listed in the expedition catalog below.</span>'
              + '</div>';
          }
        });

      } catch (err) {
        console.error("MapLibre load failed:", err);
      }
    }

    loadMapLibre();
  }
</script>

<style is:global>
.dark-alpine-popup .maplibregl-popup-content {
  background: transparent !important;
  padding: 0 !important;
  border-radius: 8px !important;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8) !important;
}
.dark-alpine-popup .maplibregl-popup-tip {
  border-top-color: rgba(5, 5, 5, 0.95) !important;
  border-bottom-color: rgba(5, 5, 5, 0.95) !important;
}
.maplibregl-ctrl-group {
  background: rgba(10, 15, 24, 0.9) !important;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.1);
}
.maplibregl-ctrl-group button {
  
}
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: 0;
}
</style>
