---
// InteractiveTopoMap.astro
// High-performance 0-dependency native client-side interactive topography engine
// Built with Dark Alpine Glass aesthetics, WGS84 Cartesian projections, and real-time telemetry HUD
import { mockTreks } from '../data/mock-treks';

// Basecamp coordinates: Village Mautar, Uttarkashi
const BASECAMP = {
  name: "Village Mautar",
  title: "HQ and Expedition Basecamp",
  coordinates: [78.4354, 30.7268] as [number, number],
  altitudeM: 1950,
  projX: 481.0,
  projY: 434.8
};

// Coordinate projection boundaries: Western Himalayas
const LNG_MIN = 76.8;
const LNG_MAX = 80.2;
const LAT_MIN = 29.8;
const LAT_MAX = 32.6;

const projectCoords = (lng: number, lat: number) => {
  const x = ((lng - LNG_MIN) / (LNG_MAX - LNG_MIN)) * 1000;
  const y = ((LAT_MAX - lat) / (LAT_MAX - LAT_MIN)) * 650;
  return { x: Number(x.toFixed(1)), y: Number(y.toFixed(1)) };
};

// Map all 10 treks with calculated coordinates and telemetry
const projectedTreks = mockTreks.map((trek) => {
  const { x, y } = projectCoords(trek.coordinates[0], trek.coordinates[1]);
  return {
    ...trek,
    projX: x,
    projY: y
  };
});
---

<section id="interactive-map" class="py-24 relative border-t border-white/5 bg-[#050505] select-none">
  <div class="max-w-7xl mx-auto px-6 mb-8">
    <div class="flex items-center gap-3 mb-4">
      <span class="h-[2px] w-8 bg-[#00f2fe]"></span>
      <span class="text-[#00f2fe] font-mono text-xs tracking-widest uppercase font-bold">Vector Topography Engine</span>
    </div>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <h2 class="text-3xl md:text-5xl font-display font-bold tracking-tight text-white">
          THEATER OF EXPEDITIONS
        </h2>
        <p class="text-silver max-w-2xl text-base sm:text-lg mt-3">
          Interactive topographic radar covering the Indian Himalayas. Pan, zoom, filter sectors, and inspect active staging routes originating from Basecamp Mautar.
        </p>
      </div>
      
      <!-- Coordinate Compass HUD Readout -->
      <div class="hidden lg:flex items-center gap-6 px-5 py-3 rounded-lg border border-white/10 bg-[#0a0f18]/80 backdrop-blur-md">
        <div>
          <div class="text-[10px] font-mono text-silver uppercase tracking-widest">Basecamp Sector</div>
          <div class="text-sm font-mono font-bold text-[#00f2fe]">30°43'36" N, 78°26'07" E</div>
        </div>
        <div class="h-8 w-[1px] bg-white/10"></div>
        <div>
          <div class="text-[10px] font-mono text-silver uppercase tracking-widest">Elevation Datum</div>
          <div class="text-sm font-mono font-bold text-white">1,950m MSL</div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6">
    <div 
      id="topo-engine-container" 
      class="relative h-[620px] lg:h-[720px] rounded-xl border border-white/10 bg-[#03060a] overflow-hidden shadow-[0_0_50px_rgba(0,0,0,0.8)] touch-none"
      role="region"
      aria-label="Interactive Himalayan Topography Map"
    >
      <!-- Hardware-Accelerated Viewport Wrapper -->
      <div 
        id="topo-viewport" 
        class="absolute inset-0 origin-top-left will-change-transform cursor-grab active:cursor-grabbing"
      >
        <!-- Native Procedural Topographic SVG -->
        <svg 
          id="topo-svg"
          viewBox="0 0 1000 650" 
          class="w-full h-full pointer-events-none"
          preserveAspectRatio="xMidYMid slice"
        >
          <defs>
            <!-- Coordinate Grid Pattern -->
            <pattern id="grid-pattern" width="100" height="100" patternUnits="userSpaceOnUse">
              <path d="M 100 0 L 0 0 0 100" fill="none" stroke="rgba(255, 255, 255, 0.04)" stroke-width="1" />
              <circle cx="100" cy="100" r="1.5" fill="rgba(0, 242, 254, 0.25)" />
            </pattern>

            <!-- Radial Vignette Mask -->
            <radialGradient id="topo-vignette" cx="50%" cy="50%" r="70%">
              <stop offset="0%" stop-color="#00f2fe" stop-opacity="0.08" />
              <stop offset="60%" stop-color="#03060a" stop-opacity="0.6" />
              <stop offset="100%" stop-color="#03060a" stop-opacity="0.95" />
            </radialGradient>

            <!-- Glowing Path Filters -->
            <filter id="glow-cyan" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="3" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>

          <!-- Ambient Backdrop Layer -->
          <rect width="1000" height="650" fill="#03060a" />
          <rect width="1000" height="650" fill="url(#grid-pattern)" />
          <rect width="1000" height="650" fill="url(#topo-vignette)" />

          <!-- Coordinate Lat/Long Grid Lines -->
          <g stroke="rgba(0, 242, 254, 0.08)" stroke-width="1" stroke-dasharray="3 3">
            <!-- Latitude lines: 32°N, 31°N, 30°N -->
            <line x1="0" y1="139.3" x2="1000" y2="139.3" />
            <line x1="0" y1="371.4" x2="1000" y2="371.4" />
            <line x1="0" y1="603.6" x2="1000" y2="603.6" />

            <!-- Longitude lines: 77°E, 78°E, 79°E, 80°E -->
            <line x1="58.8" y1="0" x2="58.8" y2="650" />
            <line x1="352.9" y1="0" x2="352.9" y2="650" />
            <line x1="647.1" y1="0" x2="647.1" y2="650" />
            <line x1="941.2" y1="0" x2="941.2" y2="650" />
          </g>

          <!-- Tactical Grid Labels -->
          <g font-family="monospace" font-size="9" fill="rgba(255, 255, 255, 0.3)" letter-spacing="1">
            <text x="15" y="135">32°00' N (PIR PANJAL / SPITI)</text>
            <text x="15" y="367">31°00' N (UPPER GARHWAL)</text>
            <text x="15" y="599">30°00' N (LOWER FOOTHILLS)</text>
            <text x="65" y="640">77°00' E</text>
            <text x="360" y="640">78°00' E</text>
            <text x="655" y="640">79°00' E</text>
            <text x="945" y="640">80°00' E</text>
          </g>

          <!-- Topographic Elevation Contour Isolines -->
          <!-- 2,000m Subalpine Contour Tier -->
          <path 
            d="M 20 220 Q 180 200 320 260 T 520 380 T 740 440 T 980 520" 
            fill="none" 
            stroke="rgba(0, 242, 254, 0.12)" 
            stroke-width="1.2" 
          />
          <!-- 3,500m Alpine Timberline Tier -->
          <path 
            d="M 40 160 Q 210 130 360 210 T 580 320 T 790 390 T 960 460" 
            fill="none" 
            stroke="rgba(0, 242, 254, 0.18)" 
            stroke-width="1.4" 
          />
          <!-- 4,500m High Glacial Tier -->
          <path 
            d="M 70 110 Q 240 80 410 160 T 630 260 T 830 330 T 970 390" 
            fill="none" 
            stroke="rgba(0, 242, 254, 0.25)" 
            stroke-width="1.6" 
          />
          <!-- 5,500m Ridge Crests and Horn Peaks -->
          <path 
            d="M 110 70 Q 260 40 460 110 T 690 190 T 870 270 T 980 320" 
            fill="none" 
            stroke="rgba(0, 242, 254, 0.35)" 
            stroke-width="1.8" 
            stroke-dasharray="8 4"
          />

          <!-- Regional Massif Formations -->
          <!-- Garhwal Massif (Nanda Devi / Kamet Sanctuary) -->
          <path 
            d="M 640 490 C 690 420 730 400 780 430 C 830 460 880 440 900 500 C 880 550 820 580 760 560 Z" 
            fill="rgba(0, 242, 254, 0.03)" 
            stroke="rgba(0, 242, 254, 0.2)" 
            stroke-width="1" 
            id="sector-poly-garhwal"
            class="sector-highlight transition-all duration-500"
          />

          <!-- Himachal Sector (Kullu / Spiti Divide) -->
          <path 
            d="M 80 50 C 140 40 210 60 250 120 C 230 180 180 220 120 190 C 70 160 60 100 80 50 Z" 
            fill="rgba(0, 242, 254, 0.03)" 
            stroke="rgba(0, 242, 254, 0.2)" 
            stroke-width="1" 
            id="sector-poly-himachal"
            class="sector-highlight transition-all duration-500"
          />

          <!-- Route Vectors emanating from Mautar Basecamp to Summits -->
          <g id="route-vectors" class="pointer-events-none">
            {projectedTreks.map((trek) => (
              <path 
                id={`vector-${trek.slug}`}
                d={`M ${BASECAMP.projX} ${BASECAMP.projY} Q ${(BASECAMP.projX + trek.projX) / 2} ${Math.min(BASECAMP.projY, trek.projY) - 30} ${trek.projX} ${trek.projY}`}
                fill="none"
                stroke="rgba(0, 242, 254, 0.25)"
                stroke-width="1.5"
                stroke-dasharray="6 6"
                data-region={trek.region.toLowerCase()}
                class="route-vector transition-all duration-500"
              />
            ))}
          </g>

          <!-- Operations Basecamp Node: Village Mautar -->
          <g id="basecamp-node" transform={`translate(${BASECAMP.projX}, ${BASECAMP.projY})`}>
            <circle r="18" fill="none" stroke="#00f2fe" stroke-opacity="0.3" stroke-width="1" class="animate-ping" />
            <circle r="8" fill="#00f2fe" fill-opacity="0.2" stroke="#00f2fe" stroke-width="2" />
            <polygon points="0,-5 4,0 0,5 -4,0" fill="#00f2fe" />
            <text x="14" y="4" font-family="monospace" font-size="10" font-weight="bold" fill="#00f2fe" letter-spacing="1">
              BASECAMP MAUTAR (HQ)
            </text>
          </g>
        </svg>

        <!-- Interactive Summit Pins (HTML Overlay Layer with Accessible Hit Targets) -->
        <div id="pins-layer" class="absolute inset-0 pointer-events-none">
          {projectedTreks.map((trek) => {
            const leftPercent = (trek.projX / 1000) * 100;
            const topPercent = (trek.projY / 650) * 100;
            return (
              <button
                type="button"
                id={`pin-${trek.slug}`}
                data-slug={trek.slug}
                data-name={trek.name}
                data-region={trek.region.toLowerCase()}
                data-altitude={trek.maxAltitudeM}
                data-difficulty={trek.difficulty}
                data-lat={trek.coordinates[1]}
                data-lng={trek.coordinates[0]}
                data-proj-x={trek.projX}
                data-proj-y={trek.projY}
                data-summary={trek.summary}
                data-hero={trek.heroImage}
                style={`left: ${leftPercent}%; top: ${topPercent}%;`}
                class="summit-pin absolute -translate-x-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center pointer-events-auto cursor-pointer group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#00f2fe] rounded-full transition-transform duration-300"
