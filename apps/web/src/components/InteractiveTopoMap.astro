                <span class="pin-core relative w-3.5 h-3.5 bg-[#00f2fe] rounded-sm rotate-45 shadow-[0_0_12px_#00f2fe] group-hover:scale-125 transition-transform"></span>
                
                <!-- Quick Hover Tooltip -->
