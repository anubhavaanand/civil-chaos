---
import type { AltitudePoint } from '../data/mock-treks';

interface Props {
  points: AltitudePoint[];
  maxAltitudeM: number;
}

const { points, maxAltitudeM } = Astro.props;

// SVG chart dimensions
const svgWidth = 800;
const svgHeight = 260;
const padding = { top: 35, right: 40, bottom: 45, left: 55 };

const minAlt = Math.min(...points.map((p) => p.altitudeM)) - 200;
const maxAlt = Math.max(...points.map((p) => p.altitudeM), maxAltitudeM) + 150;
const maxDist = Math.max(...points.map((p) => p.distanceKm));

// Map coordinate helpers
const getX = (dist: number) => {
  if (maxDist === 0) return padding.left;
  return padding.left + (dist / maxDist) * (svgWidth - padding.left - padding.right);
};

const getY = (alt: number) => {
  const range = maxAlt - minAlt;
  if (range === 0) return svgHeight - padding.bottom;
  return svgHeight - padding.bottom - ((alt - minAlt) / range) * (svgHeight - padding.top - padding.bottom);
};

// Generate SVG polyline / path coordinates
const svgPathPoints = points.map((p) => `${getX(p.distanceKm)},${getY(p.altitudeM)}`).join(' L ');
const areaPath = `M ${getX(points[0].distanceKm)},${svgHeight - padding.bottom} L ${svgPathPoints} L ${getX(points[points.length - 1].distanceKm)},${svgHeight - padding.bottom} Z`;
---

<div class="relative w-full overflow-hidden rounded-2xl border border-white/10 bg-slate-900/80 p-6 backdrop-blur-md">
  <div class="mb-4 flex items-center justify-between">
    <div>
      <h3 class="font-display text-lg font-bold text-white">Interactive Altitude Profile</h3>
      <p class="text-xs text-ink-dim">Distance vs Elevation profile with key campsite waypoints</p>
    </div>
    <div class="rounded-full border border-brand/40 bg-brand/10 px-3 py-1 text-xs font-bold text-brand">
      Max: {maxAltitudeM.toLocaleString()} m
    </div>
  </div>

  <div class="w-full overflow-x-auto">
    <svg viewBox={`0 0 ${svgWidth} ${svgHeight}`} class="w-full min-w-[600px] h-auto select-none overflow-visible">
      <defs>
        <!-- Gradient fill for mountain elevation -->
        <linearGradient id="elevationGradient" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#14b8a6" stop-opacity="0.45"></stop>
          <stop offset="100%" stop-color="#14b8a6" stop-opacity="0.05"></stop>
        </linearGradient>
      </defs>

      <!-- Horizontal grid lines -->
      <line x1={padding.left} y1={getY(minAlt + 500)} x2={svgWidth - padding.right} y2={getY(minAlt + 500)} stroke="#ffffff" stroke-opacity="0.08" stroke-dasharray="4 4" />
      <line x1={padding.left} y1={getY((minAlt + maxAlt) / 2)} x2={svgWidth - padding.right} y2={getY((minAlt + maxAlt) / 2)} stroke="#ffffff" stroke-opacity="0.08" stroke-dasharray="4 4" />

      <!-- Area fill -->
      <path d={areaPath} fill="url(#elevationGradient)" />

      <!-- Elevation stroke line -->
      <path d={`M ${svgPathPoints}`} fill="none" stroke="#14b8a6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />

      <!-- Points and labels -->
      {points.map((p) => {
        const cx = getX(p.distanceKm);
        const cy = getY(p.altitudeM);
        return (
          <g class="group cursor-pointer">
            <!-- Pulsing outer circle on hover -->
            <circle cx={cx} cy={cy} r="7" fill="#14b8a6" fill-opacity="0.3" class="transition-transform group-hover:scale-150" />
            <circle cx={cx} cy={cy} r="4" fill="#ffffff" stroke="#0f766e" stroke-width="2" />
            
            <!-- Altitude Text Above -->
            <text x={cx} y={cy - 12} text-anchor="middle" fill="#14b8a6" font-size="11" font-weight="700" class="font-sans">
              {p.altitudeM}m
            </text>

            <!-- Waypoint Label Below -->
            {p.label && (
              <text x={cx} y={svgHeight - padding.bottom + 18} text-anchor="middle" fill="#94a3b8" font-size="10" font-weight="500" class="font-sans">
                {p.label} ({p.distanceKm}km)
              </text>
            )}
          </g>
        );
      })}

      <!-- X-Axis Line -->
      <line x1={padding.left} y1={svgHeight - padding.bottom} x2={svgWidth - padding.right} y2={svgHeight - padding.bottom} stroke="#ffffff" stroke-opacity="0.2" stroke-width="1.5" />
    </svg>
  </div>
</div>
