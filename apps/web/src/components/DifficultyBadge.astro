---
interface Props {
  difficulty: 'easy' | 'moderate' | 'difficult';
  class?: string;
}

const { difficulty, class: className = '' } = Astro.props;

const config = {
  easy: { color: 'text-green-400 border-green-400/30 bg-green-500/10', label: 'Easy' },
  moderate: { color: 'text-amber-400 border-amber-400/30 bg-amber-500/10', label: 'Moderate' },
  difficult: { color: 'text-red-400 border-red-400/30 bg-red-500/10', label: 'Difficult' },
};

const { color, label } = config[difficulty] || config.moderate;
---
<span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium font-['Inter'] border backdrop-blur-sm shadow-sm ${color} ${className}`}>
  <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M14 6l-4.22 5.63 1.22 1.63L14 9.25l4.5 6H20L14 6zm-6 2l-6 8h8.5l2.25-3-4.75-5z" />
  </svg>
  {label}
</span>
