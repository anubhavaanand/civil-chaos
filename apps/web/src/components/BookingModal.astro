---
import { actions } from 'astro:actions';
import type { Trek } from '../data/mock-treks';

interface Props {
  trek: Trek;
}

const { trek } = Astro.props;
---

<dialog
  id="booking-dialog"
  class="fixed inset-0 z-50 m-auto w-full max-w-lg rounded-3xl border-0 bg-transparent p-4 text-[#0F172A] shadow-2xl backdrop:bg-[#F9FAFB]/85 backdrop:backdrop-blur-md transition-all duration-300 starting:opacity-0 starting:scale-95 open:opacity-100 open:scale-100 closed:opacity-0 closed:scale-95"
>
  <div class="double-bezel-outer shadow-2xl border border-[#0F172A]/10">
    <div class="double-bezel-inner relative p-6 md:p-8 bg-[#FFFFFF]/95 backdrop-blur-2xl">
      <!-- Close Button -->
      <button
        id="close-dialog-btn"
        class="btn-tactile absolute top-5 right-5 flex h-9 w-9 items-center justify-center rounded-lg border border-[#0F172A]/10 bg-[#0F172A]/5 text-[#94A3B8] hover:border-glacier/30 hover:bg-glacier/10 hover:text-[#0F172A] transition-colors"
        aria-label="Close booking modal"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="mb-6">
        <span class="inline-flex items-center gap-2 rounded-full bg-glacier/10 border border-glacier/30 px-3 py-1 text-[10px] font-bold text-glacier uppercase font-mono tracking-widest mb-2">
          <span class="w-1.5 h-1.5 rounded-full bg-glacier animate-pulse"></span>
          Instant Booking Request
        </span>
        <h3 class="font-display text-2xl font-bold text-[#0F172A]">Reserve {trek.name}</h3>
        <p class="text-xs text-[#94A3B8] mt-1 font-mono">Tier: ₹{trek.fromPrice.toLocaleString('en-IN')} per climber / All permits included</p>
      </div>

      <!-- Form -->
      <form id="booking-form" method="POST" action={actions.booking} class="space-y-4">
        <input type="hidden" name="trekName" value={trek.name} />
        <input type="hidden" name="trekSlug" value={trek.slug} />
        <input type="hidden" id="modal-batch-dates" name="batchDates" value="" />

        <!-- Honeypot Field for Bots -->
        <div class="hidden" aria-hidden="true">
          <input type="text" name="company" tabindex="-1" autocomplete="off" />
        </div>

        <!-- Batch Date Display -->
        <div id="selected-batch-banner" class="hidden rounded-xl border border-glacier/30 bg-glacier/10 p-3 text-xs font-semibold text-glacier flex justify-between items-center">
          <span>Staging Window: <strong id="selected-dates-text"></strong></span>
          <button type="button" id="clear-batch-btn" class="text-xs underline text-[#0F172A]/80 hover:text-[#0F172A] cursor-pointer">Change</button>
        </div>

        <!-- Customer Name -->
        <div>
          <label for="customerName" class="block text-[11px] font-semibold uppercase tracking-wider text-[#94A3B8] mb-1 font-mono">Your Full Name *</label>
          <input
            type="text"
            id="customerName"
            name="customerName"
            required
            placeholder="e.g. Rahul Sharma"
            class="w-full rounded-xl border border-white/15 bg-[#0F172A]/5 px-4 py-2.5 text-sm text-[#0F172A] placeholder-slate-500 focus:border-glacier focus:bg-[#F9FAFB] focus:outline-none focus:ring-1 focus:ring-glacier"
          />
        </div>

        <!-- Phone Number -->
        <div>
          <label for="phone" class="block text-[11px] font-semibold uppercase tracking-wider text-[#94A3B8] mb-1 font-mono">Indian Mobile Number *</label>
          <div class="relative">
            <span class="absolute left-3.5 top-2.5 text-sm font-mono text-[#94A3B8]">+91</span>
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              pattern="^[6-9]\\d{9}$"
              placeholder="9876543210"
              class="w-full rounded-xl border border-white/15 bg-[#0F172A]/5 pl-14 pr-4 py-2.5 text-sm font-mono text-[#0F172A] placeholder-slate-500 focus:border-glacier focus:bg-[#F9FAFB] focus:outline-none focus:ring-1 focus:ring-glacier"
            />
          </div>
        </div>

        <!-- Group Size & Flexible Dates -->
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="groupSize" class="block text-[11px] font-semibold uppercase tracking-wider text-[#94A3B8] mb-1 font-mono">Climbers *</label>
            <input
              type="number"
              id="groupSize"
              name="groupSize"
              min="1"
              max="15"
              value="1"
              required
              class="w-full rounded-xl border border-white/15 bg-[#0F172A]/5 px-4 py-2.5 text-sm font-mono text-[#0F172A] focus:border-glacier focus:bg-[#F9FAFB] focus:outline-none focus:ring-1 focus:ring-glacier"
            />
          </div>
          <div>
            <label for="preferredDates" class="block text-[11px] font-semibold uppercase tracking-wider text-[#94A3B8] mb-1 font-mono">Target Window</label>
            <input
              type="text"
              id="preferredDates"
              name="preferredDates"
              placeholder="e.g. October 2026"
              class="w-full rounded-xl border border-white/15 bg-[#0F172A]/5 px-4 py-2.5 text-sm text-[#0F172A] placeholder-slate-500 focus:border-glacier focus:bg-[#F9FAFB] focus:outline-none focus:ring-1 focus:ring-glacier"
            />
          </div>
        </div>

        <!-- Optional Message -->
        <div>
          <label for="message" class="block text-[11px] font-semibold uppercase tracking-wider text-[#94A3B8] mb-1 font-mono">Special Directives or Acclimatization Notes</label>
          <textarea
            id="message"
            name="message"
            rows="2"
            placeholder="Offloading requirements, medical background, dietary preferences..."
            class="w-full rounded-xl border border-white/15 bg-[#0F172A]/5 px-4 py-2.5 text-sm text-[#0F172A] placeholder-slate-500 focus:border-glacier focus:bg-[#F9FAFB] focus:outline-none focus:ring-1 focus:ring-glacier"
          ></textarea>
        </div>

        <!-- Action Response Feedback -->
        <div id="booking-feedback" class="hidden text-xs font-medium text-rose-400 p-2.5 rounded-lg bg-rose-500/10 border border-rose-500/20"></div>

        <!-- Submit Button -->
        <button
          type="submit"
          id="submit-booking-btn"
          class="btn-tactile w-full flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#EA580C] to-[#EA580C] py-3.5 text-sm font-bold text-[#F9FAFB] shadow-md hover:shadow-lg transition-all cursor-pointer uppercase tracking-wider font-mono"
        >
          <span>Dispatch Booking Request</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </form>
    </div>
  </div>
</dialog>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const dialog = document.getElementById('booking-dialog');
    const closeBtn = document.getElementById('close-dialog-btn');
    const triggers = document.querySelectorAll('.open-booking-trigger');
    const batchInput = document.getElementById('modal-batch-dates');
    const batchBanner = document.getElementById('selected-batch-banner');
    const batchText = document.getElementById('selected-dates-text');
    const clearBatchBtn = document.getElementById('clear-batch-btn');

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const dates = trigger.getAttribute('data-dates');
        if (dates) {
          batchInput.value = dates;
          batchText.textContent = dates;
          batchBanner.classList.remove('hidden');
        }
        if (dialog) dialog.showModal();
      });
    });

    closeBtn?.addEventListener('click', () => dialog?.close());

    // Light dismiss on backdrop click
    dialog?.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      );
      if (!isInDialog) dialog.close();
    });

    clearBatchBtn?.addEventListener('click', () => {
      batchInput.value = '';
      batchBanner.classList.add('hidden');
    });

    // Handle form submit redirect to WhatsApp URL
    const form = document.getElementById('booking-form');
    const feedback = document.getElementById('booking-feedback');

    form?.addEventListener('submit', async (e) => {
      const phoneInput = document.getElementById('phone');
      const phoneVal = phoneInput?.value || '';
      if (!/^[6-9]\d{9}$/.test(phoneVal)) {
        e.preventDefault();
        if (feedback) {
          feedback.textContent = 'Please enter a valid 10-digit Indian mobile number.';
          feedback.classList.remove('hidden');
        }
      }
    });
  });
</script>