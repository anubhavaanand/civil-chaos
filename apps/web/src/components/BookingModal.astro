---
import { actions } from 'astro:actions';
import type { Trek } from '../data/mock-treks';

interface Props {
  trek: Trek;
}

const { trek } = Astro.props;
---

<dialog
  id="booking-dialog"
  class="fixed inset-0 z-50 m-auto w-full max-w-lg rounded-3xl border border-white/20 bg-slate-900/95 p-0 text-white shadow-2xl backdrop-blur-xl backdrop-saturate-150 backdrop:bg-slate-950/80 transition-all duration-300 starting:opacity-0 starting:scale-95 open:opacity-100 open:scale-100 closed:opacity-0 closed:scale-95"
>
  <div class="relative p-6 md:p-8">
    <!-- Close Button -->
    <button
      id="close-dialog-btn"
      class="absolute top-5 right-5 flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-ink-dim hover:bg-white/20 hover:text-white transition-colors"
      aria-label="Close modal"
    >
      ✕
    </button>

    <div class="mb-6">
      <span class="inline-block rounded-full bg-brand/10 border border-brand/30 px-3 py-1 text-xs font-bold text-brand uppercase tracking-wider mb-2">
        Instant Booking Request
      </span>
      <h3 class="font-display text-2xl font-bold text-white">Book {trek.name}</h3>
      <p class="text-xs text-ink-dim mt-1">Starting from ₹{trek.fromPrice.toLocaleString('en-IN')} per person</p>
    </div>

    <!-- Form -->
    <form id="booking-form" method="POST" action={actions.booking} class="space-y-4">
      <input type="hidden" name="trekName" value={trek.name} />
      <input type="hidden" name="trekSlug" value={trek.slug} />
      <input type="hidden" id="modal-batch-dates" name="batchDates" value="" />

      <!-- Honeypot Field for Bots -->
      <div class="hidden" aria-hidden="true">
        <input type="text" name="company" tabindex="-1" autocomplete="off" />
      </div>

      <!-- Batch Date Display -->
      <div id="selected-batch-banner" class="hidden rounded-xl border border-brand/30 bg-brand/10 p-3 text-xs font-semibold text-brand flex justify-between items-center">
        <span>Selected Dates: <strong id="selected-dates-text"></strong></span>
        <button type="button" id="clear-batch-btn" class="text-xs underline text-white/80 hover:text-white">Change</button>
      </div>

      <!-- Customer Name -->
      <div>
        <label for="customerName" class="block text-xs font-semibold uppercase tracking-wider text-ink-dim mb-1">Your Full Name *</label>
        <input
          type="text"
          id="customerName"
          name="customerName"
          required
          placeholder="e.g. Rahul Sharma"
          class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:border-brand focus:bg-slate-950 focus:outline-none focus:ring-1 focus:ring-brand"
        />
      </div>

      <!-- Phone Number -->
      <div>
        <label for="phone" class="block text-xs font-semibold uppercase tracking-wider text-ink-dim mb-1">Indian Mobile Number *</label>
        <div class="relative">
          <span class="absolute left-3.5 top-2.5 text-sm text-ink-dim">+91</span>
          <input
            type="tel"
            id="phone"
            name="phone"
            required
            pattern="^[6-9]\d{9}$"
            placeholder="9876543210"
            class="w-full rounded-xl border border-white/15 bg-white/5 pl-14 pr-4 py-2.5 text-sm text-white placeholder-slate-500 focus:border-brand focus:bg-slate-950 focus:outline-none focus:ring-1 focus:ring-brand"
          />
        </div>
      </div>

      <!-- Group Size & Flexible Dates -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="groupSize" class="block text-xs font-semibold uppercase tracking-wider text-ink-dim mb-1">Group Size *</label>
          <input
            type="number"
            id="groupSize"
            name="groupSize"
            min="1"
            max="30"
            value="1"
            required
            class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white focus:border-brand focus:bg-slate-950 focus:outline-none focus:ring-1 focus:ring-brand"
          />
        </div>
        <div>
          <label for="preferredDates" class="block text-xs font-semibold uppercase tracking-wider text-ink-dim mb-1">Preferred Month/Dates</label>
          <input
            type="text"
            id="preferredDates"
            name="preferredDates"
            placeholder="e.g. Early October"
            class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:border-brand focus:bg-slate-950 focus:outline-none focus:ring-1 focus:ring-brand"
          />
        </div>
      </div>

      <!-- Optional Message -->
      <div>
        <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-ink-dim mb-1">Special Requirements / Notes</label>
        <textarea
          id="message"
          name="message"
          rows="2"
          placeholder="Any gear offloading requirements, dietary preferences..."
          class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:border-brand focus:bg-slate-950 focus:outline-none focus:ring-1 focus:ring-brand"
        ></textarea>
      </div>

      <!-- Action Response Feedback -->
      <div id="booking-feedback" class="hidden text-xs font-medium text-rose-400 p-2.5 rounded-lg bg-rose-500/10 border border-rose-500/20"></div>

      <!-- Submit Button -->
      <button
        type="submit"
        id="submit-booking-btn"
        class="w-full flex items-center justify-center gap-2 rounded-xl bg-brand hover:bg-brand-deep py-3 text-sm font-bold text-slate-950 transition-all hover:scale-[1.02] shadow-lg shadow-brand/20 cursor-pointer"
      >
        <span>Request Booking via WhatsApp</span>
        <span>→</span>
      </button>
    </form>
  </div>
</dialog>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const dialog = document.getElementById('booking-dialog');
    const closeBtn = document.getElementById('close-dialog-btn');
    const triggers = document.querySelectorAll('.open-booking-trigger');
    const batchInput = document.getElementById('modal-batch-dates');
    const batchBanner = document.getElementById('selected-batch-banner');
    const batchText = document.getElementById('selected-dates-text');
    const clearBatchBtn = document.getElementById('clear-batch-btn');

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        const dates = trigger.getAttribute('data-dates');
        if (dates) {
          batchInput.value = dates;
          batchText.textContent = dates;
          batchBanner.classList.remove('hidden');
        }
        if (dialog) dialog.showModal();
      });
    });

    closeBtn?.addEventListener('click', () => dialog?.close());

    // Light dismiss on backdrop click
    dialog?.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      );
      if (!isInDialog) dialog.close();
    });

    clearBatchBtn?.addEventListener('click', () => {
      batchInput.value = '';
      batchBanner.classList.add('hidden');
    });

    // Handle form submit redirect to WhatsApp URL
    const form = document.getElementById('booking-form');
    const feedback = document.getElementById('booking-feedback');

    form?.addEventListener('submit', async (e) => {
      // Allow Astro Action form submission or open WhatsApp link directly
      const phoneInput = document.getElementById('phone');
      const phoneVal = phoneInput?.value || '';
      if (!/^[6-9]\d{9}$/.test(phoneVal)) {
        e.preventDefault();
        if (feedback) {
          feedback.textContent = 'Please enter a valid 10-digit Indian mobile number.';
          feedback.classList.remove('hidden');
        }
      }
    });
  });
</script>
