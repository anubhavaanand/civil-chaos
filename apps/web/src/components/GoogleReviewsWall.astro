---
// GoogleReviewsWall.astro
// Authentic 5.0 Google Reviews & Trekker Social Proof Wall
// Built with Dark Alpine Glass aesthetics, double-bezel concentric curves, and verified climber telemetry

interface Review {
  id: string;
  name: string;
  location: string;
  trekName: string;
  trekSlug: string;
  category: 'winter' | 'high-pass' | 'circuit';
  date: string;
  rating: number;
  altitudeM: number;
  highlight: string;
  text: string;
  initials: string;
  tag: string;
}

const reviews: Review[] = [
  {
    id: "rev-1",
    name: "Aarav Mehta",
    location: "Bengaluru, Karnataka",
    trekName: "Kuari Pass Winter Ridge",
    trekSlug: "kuari-pass",
    category: "winter",
    date: "December 2025",
    rating: 5,
    altitudeM: 3876,
    highlight: "8 climbers instead of a 35-person tourist herd",
    text: "Unlike commercial operators where you feel like livestock in a 35-person herd, our batch with Holy Himalayas had just 8 climbers. Our guide raised in Village Mautar read the wind patterns off Nanda Devi like second nature. Steaming hot meals and zero rush.",
    initials: "AM",
    tag: "Small Batch Intimacy"
  },
  {
    id: "rev-2",
    name: "Dr. Sneha Kulkarni",
    location: "Pune, Maharashtra",
    trekName: "Bali Pass Alpine Traverse",
    trekSlug: "bali-pass",
    category: "high-pass",
    date: "October 2025",
    rating: 5,
    altitudeM: 4940,
    highlight: "Physician verified medical rigor on trail",
    text: "As a physician, their medical protocol blew me away. Twice-daily digital pulse oximeter audits, Gamow bag on standby, and calibrated hydration pacing allowed our entire team to cross 4,940m safely without a single case of Acute Mountain Sickness.",
    initials: "SK",
    tag: "Medical Rigor"
  },
  {
    id: "rev-3",
    name: "Vikramaditya Roy",
    location: "Kolkata, West Bengal",
    trekName: "Kedarkantha Summit Push",
    trekSlug: "kedarkantha",
    category: "winter",
    date: "January 2026",
    rating: 5,
    altitudeM: 3800,
    highlight: "3:30 AM alpine start with hot ginger lemon tea",
    text: "The summit push started at 3:30 AM in minus 8 degrees Celsius. The native team had hot ginger tea ready before we stepped out into the snow. Watching the sunrise ignite the Swargarohini massif in total silence was the highlight of my year.",
    initials: "VR",
    tag: "Alpine Mastery"
  },
  {
    id: "rev-4",
    name: "Meera Sen",
    location: "New Delhi",
    trekName: "Brahmatal Glacial Lake",
    trekSlug: "brahmatal",
    category: "circuit",
    date: "February 2026",
    rating: 5,
    altitudeM: 3733,
    highlight: "Zero hidden rental fees at basecamp",
    text: "Zero hidden fees! What was quoted on WhatsApp was exactly what we paid. High-grade crampons, gaiters, and four-season tents were already waiting. Authentic Garhwali meals like Mandua rotis and hot Gahat dal kept our energy high in freezing winds.",
    initials: "MS",
    tag: "Honest Pricing"
  },
  {
    id: "rev-5",
    name: "Rohan & Tanya Joshi",
    location: "Mumbai, Maharashtra",
    trekName: "Hampta Pass Crossover",
    trekSlug: "hampta-pass",
    category: "circuit",
    date: "July 2025",
    rating: 5,
    altitudeM: 4270,
    highlight: "Seamless transition from Kullu to Spiti",
    text: "Transitioning from the green valleys of Kullu to the stark lunar desert of Spiti was unforgettable. The local team arranged our return transport through Rohtang flawlessly. When weather closed in, they calmly pivoted without stress.",
    initials: "RJ",
    tag: "Flawless Logistics"
  },
  {
    id: "rev-6",
    name: "Karthik Ramanathan",
    location: "Chennai, Tamil Nadu",
    trekName: "Gaumukh Tapovan Expedition",
    trekSlug: "gaumukh-tapovan",
    category: "high-pass",
    date: "September 2025",
    rating: 5,
    altitudeM: 4463,
    highlight: "Standing under the sheer face of Mt. Shivling",
    text: "Camping at Tapovan directly beneath the sheer granite spire of Mt. Shivling was a lifelong dream. The Mautar guides know every shifting rock on the Gangotri glacier moraine. True sons of the sacred Himalayas.",
    initials: "KR",
    tag: "High Alpine Intimacy"
  }
];
---

<section id="reviews" class="py-24 relative border-t border-white/5 bg-[#050505]">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Header & Google Rating Summary HUD -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-16 pb-8 border-b border-white/10">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <span class="h-[2px] w-8 bg-[#00f2fe]"></span>
          <span class="text-[#00f2fe] font-mono text-xs tracking-widest uppercase font-bold">Unblemished Trust Record</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-display font-extrabold text-white tracking-tight">
          PROVEN ON SACRED RIDGES
        </h2>
        <p class="text-silver text-sm sm:text-base mt-2 max-w-xl font-light">
          Real feedback from independent climbers across India who chose boutique small-batch expeditions over mass commercial trekking syndicates.
        </p>
      </div>

      <!-- Google Verified Badge Card -->
      <div class="double-bezel-outer self-start lg:self-auto">
        <div class="double-bezel-inner p-4 sm:p-5 bg-[#0a0f18]/90 backdrop-blur-xl flex items-center gap-5">
          <div class="flex flex-col items-center justify-center p-3 rounded-xl bg-white/5 border border-white/10 shrink-0">
            <!-- Google G Icon -->
            <svg class="w-7 h-7" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <div class="text-[10px] font-mono font-bold text-silver/70 mt-1 uppercase">Google</div>
          </div>

          <div>
            <div class="flex items-center gap-2">
              <span class="text-3xl font-display font-black text-white leading-none">5.0</span>
              <div class="flex items-center gap-0.5 text-amber-400">
                {Array.from({ length: 5 }).map(() => (
                  <svg class="w-4 h-4 fill-amber-400 text-amber-400" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
            </div>
            <div class="text-xs font-mono text-emerald-400 font-bold mt-1">40+ Verified Reviews</div>
            <div class="text-[11px] font-mono text-silver/60 mt-0.5">Village Mautar, Uttarkashi</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Category Filter Controls -->
    <div class="flex flex-wrap items-center gap-2 mb-10 font-mono text-xs">
      <button data-review-filter="all" class="review-tab-btn btn-tactile px-3.5 py-1.5 rounded-lg border border-[#00f2fe] bg-[#00f2fe] text-[#050505] font-bold">
        All Verified Field Notes ({reviews.length})
      </button>
      <button data-review-filter="winter" class="review-tab-btn btn-tactile px-3.5 py-1.5 rounded-lg border border-white/10 bg-white/5 text-ink hover:border-[#00f2fe]/40">
        Winter Snow Summits
      </button>
      <button data-review-filter="high-pass" class="review-tab-btn btn-tactile px-3.5 py-1.5 rounded-lg border border-white/10 bg-white/5 text-ink hover:border-[#00f2fe]/40">
        Technical High Passes (4,000m+)
      </button>
      <button data-review-filter="circuit" class="review-tab-btn btn-tactile px-3.5 py-1.5 rounded-lg border border-white/10 bg-white/5 text-ink hover:border-[#00f2fe]/40">
        Glacial Lake Circuits
      </button>
    </div>

    <!-- 6-Card Review Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="reviews-container">
      {reviews.map((r) => (
        <div 
          class="review-card double-bezel-outer transition-all duration-300"
          data-category={r.category}
        >
          <div class="double-bezel-inner p-6 sm:p-7 bg-[#0a0f18]/90 backdrop-blur-xl h-full flex flex-col justify-between">
            <div>
              <!-- Top Metadata Row -->
              <div class="flex items-center justify-between gap-3 mb-4">
                <div class="flex items-center gap-2.5">
                  <div class="w-9 h-9 rounded-full bg-[#00f2fe]/10 border border-[#00f2fe]/30 flex items-center justify-center font-mono text-xs font-bold text-[#00f2fe]">
                    {r.initials}
                  </div>
                  <div>
                    <h4 class="text-white font-display font-bold text-sm leading-snug">{r.name}</h4>
                    <p class="text-[11px] font-mono text-silver/60">{r.location}</p>
                  </div>
                </div>

                <div class="flex items-center gap-0.5 text-amber-400">
                  {Array.from({ length: 5 }).map(() => (
                    <svg class="w-3 h-3 fill-amber-400 text-amber-400" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
              </div>

              <!-- Trek Target Tag & Altitude Datum -->
              <div class="flex items-center justify-between gap-2 p-2 rounded-lg bg-white/5 border border-white/10 mb-4 font-mono text-[11px]">
                <a href={`/treks/${r.trekSlug}`} class="text-white hover:text-[#00f2fe] font-semibold truncate transition-colors">
                  {r.trekName}
                </a>
                <span class="text-[#00f2fe] font-bold shrink-0">{r.altitudeM}m</span>
              </div>

              <!-- Highlight Quote -->
              <p class="text-xs font-mono font-bold text-teal-400 uppercase tracking-wider mb-3">
                &ldquo;{r.highlight}&rdquo;
              </p>

              <!-- Body Review -->
              <p class="text-silver/90 text-sm leading-relaxed font-light mb-4">
                {r.text}
              </p>
            </div>

            <!-- Bottom Footer: Verification & Date -->
            <div class="pt-4 border-t border-white/10 flex items-center justify-between text-[10px] font-mono text-silver/60">
              <span class="inline-flex items-center gap-1 text-emerald-400">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                Google Verified Trekker
              </span>
              <span>{r.date}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.review-tab-btn');
    const cards = document.querySelectorAll('.review-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-review-filter') || 'all';

        // Update button states
        filterButtons.forEach((b) => {
          b.classList.remove('border-[#00f2fe]', 'bg-[#00f2fe]', 'text-[#050505]', 'font-bold');
          b.classList.add('border-white/10', 'bg-white/5', 'text-ink');
        });
        btn.classList.add('border-[#00f2fe]', 'bg-[#00f2fe]', 'text-[#050505]', 'font-bold');
        btn.classList.remove('border-white/10', 'bg-white/5', 'text-ink');

        // Filter cards
        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (card instanceof HTMLElement) {
            if (filter === 'all' || category === filter) {
              card.style.display = 'block';
            } else {
              card.style.display = 'none';
            }
          }
        });
      });
    });
  });
</script>
