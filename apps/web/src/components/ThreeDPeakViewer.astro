---
// ThreeDPeakViewer.astro
// Interactive 3D Himalayan Peak & Terrain Viewport powered by Three.js
---

<div class="relative w-full rounded-2xl overflow-hidden bg-slate-950 border border-slate-800 shadow-2xl transition-all duration-300">
  <!-- Top Glass Bar Controls -->
  <div class="absolute top-4 left-4 right-4 z-20 flex flex-wrap items-center justify-between gap-3 p-3 rounded-xl bg-slate-900/80 backdrop-blur-md border border-[#0F172A]/10 text-[#0F172A] shadow-lg">
    <div class="flex items-center space-x-3">
      <div class="w-3 h-3 rounded-full bg-cyan-400 animate-ping"></div>
      <h3 class="font-heading font-bold text-sm tracking-wide text-cyan-200 uppercase flex items-center gap-2">
        <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2 1m0 0L10 4m2 1v2.5M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1m2 1l2-1m-2 1v-2.5M18 18l-2-1m2 1l2-1m-2 1v-2.5" />
        </svg>
        3D Himalayan Peak Explorer
      </h3>
      <span class="hidden xl:inline-block text-[10px] font-mono text-slate-400 border-l border-[#0F172A]/10 pl-2">
        Weisse Wand Peak 2,517m by Shahriar Shahrabi (CC BY 4.0)
      </span>
    </div>

    <!-- Controls: Lighting & Particles -->
    <div class="flex items-center gap-2 text-xs">
      <div class="flex items-center bg-slate-800/80 rounded-lg p-1 border border-slate-700">
        <button id="btn-theme-dawn" class="px-2.5 py-1 rounded-md text-amber-300 hover:bg-slate-700 transition font-medium flex items-center gap-1.5" title="Golden Hour">
          <svg class="w-3.5 h-3.5 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364-6.364l-1.414 1.414M7.05 16.95l-1.414 1.414M16.95 16.95l1.414 1.414M6.343 6.343l1.414 1.414M12 8a4 4 0 100 8 4 4 0 000-8z" />
          </svg>
          <span>Dawn</span>
        </button>
        <button id="btn-theme-day" class="px-2.5 py-1 rounded-md bg-cyan-500 text-slate-950 font-bold shadow transition flex items-center gap-1.5" title="Alpine Day">
          <svg class="w-3.5 h-3.5 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="4"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41m14.14-14.14l-1.41 1.41"/>
          </svg>
          <span>Day</span>
        </button>
        <button id="btn-theme-night" class="px-2.5 py-1 rounded-md text-cyan-300 hover:bg-slate-700 transition font-medium flex items-center gap-1.5" title="Starlight Night">
          <svg class="w-3.5 h-3.5 text-cyan-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <span>Night</span>
        </button>
      </div>

      <button id="btn-toggle-snow" class="px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-700 border border-slate-700 text-cyan-300 transition flex items-center gap-1.5 font-medium">
        <svg class="w-3.5 h-3.5 text-cyan-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v20m10-10H2m17.07-7.07L4.93 19.07m14.14 0L4.93 4.93" />
        </svg>
        <span id="snow-status-text">Snow On</span>
      </button>
    </div>
  </div>

  <!-- 3D WebGL Canvas Container -->
  <div id="three-canvas-container" class="w-full h-[450px] md:h-[550px] relative cursor-grab active:cursor-grabbing select-none touch-none">
    <!-- Interactive Overlay HUD -->
    <div id="peak-hud" class="absolute bottom-6 left-6 z-20 max-w-sm p-4 rounded-xl bg-slate-900/90 backdrop-blur-xl border border-cyan-500/30 text-[#0F172A] shadow-2xl transition-all duration-300 transform translate-y-0 opacity-100">
      <div class="flex items-center justify-between gap-2 mb-1">
        <span id="hud-region" class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">Garhwal Himalayas</span>
        <span id="hud-altitude" class="text-xs font-mono font-bold text-amber-400">12,500 FT / 3,810 M</span>
      </div>
      <h4 id="hud-title" class="text-lg font-heading font-bold text-slate-100">Kedarkantha Summit</h4>
      <p id="hud-desc" class="text-xs text-slate-300 mt-1 leading-relaxed">Pinnacle 360° winter snow peak offering breathtaking views of Swargarohini & Black Peak ranges.</p>
      
      <div class="mt-3 pt-3 border-t border-slate-800 flex items-center justify-between">
        <div class="text-xs">
          <span class="text-slate-400">Difficulty:</span>
          <span id="hud-diff" class="font-semibold text-emerald-400 ml-1">Easy-Moderate</span>
        </div>
        <button id="hud-book-btn" data-slug="kedarkantha" class="px-3 py-1.5 rounded-lg bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold text-xs shadow-lg transition transform hover:scale-105 flex items-center gap-1">
          Explore Trek
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Quick Peak Selector Chips -->
    <div class="absolute bottom-6 right-6 z-20 hidden md:flex flex-col gap-2">
      <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 text-right pr-1">Select Summit</span>
      <button data-peak="kedarkantha" class="peak-chip px-3 py-1.5 rounded-lg bg-slate-900/80 hover:bg-cyan-500/20 border border-cyan-500/40 text-cyan-300 text-xs font-medium backdrop-blur transition text-right shadow active-chip flex items-center justify-end gap-1.5">
        <svg class="w-3 h-3 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span>Kedarkantha (12,500 ft)</span>
      </button>
      <button data-peak="harkidun" class="peak-chip px-3 py-1.5 rounded-lg bg-slate-900/80 hover:bg-cyan-500/20 border border-slate-700 text-slate-300 text-xs font-medium backdrop-blur transition text-right shadow flex items-center justify-end gap-1.5">
        <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span>Har Ki Dun (11,768 ft)</span>
      </button>
      <button data-peak="roopkund" class="peak-chip px-3 py-1.5 rounded-lg bg-slate-900/80 hover:bg-cyan-500/20 border border-slate-700 text-slate-300 text-xs font-medium backdrop-blur transition text-right shadow flex items-center justify-end gap-1.5">
        <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span>Roopkund (15,750 ft)</span>
      </button>
      <button data-peak="brahmatal" class="peak-chip px-3 py-1.5 rounded-lg bg-slate-900/80 hover:bg-cyan-500/20 border border-slate-700 text-slate-300 text-xs font-medium backdrop-blur transition text-right shadow flex items-center justify-end gap-1.5">
        <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span>Brahmatal (12,250 ft)</span>
      </button>
    </div>
  </div>
</div>

<script>
  import type * as THREE_TYPE from 'three';
  let THREE: typeof THREE_TYPE;
  let GLTFLoader: any;
  let DRACOLoader: any;

  // Reduced motion preference
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Peak Data Repository
  const PEAK_DATA: Record<string, any> = {
    kedarkantha: {
      title: 'Kedarkantha Summit',
      altitude: '12,500 FT / 3,810 M',
      region: 'Garhwal Himalayas',
      diff: 'Easy-Moderate',
      desc: 'Pinnacle 360° winter snow peak offering breathtaking views of Swargarohini & Black Peak ranges.',
      slug: 'kedarkantha',
      modelPath: '/models/kedarkantha.glb',
      camPos: { x: 12, y: 14, z: 18 },
      targetPos: { x: 4, y: 3.5, z: 2 }
    },
    harkidun: {
      title: 'Har Ki Dun Valley',
      altitude: '11,768 FT / 3,587 M',
      region: 'Uttarkashi, Garhwal',
      diff: 'Moderate',
      desc: 'Cradle of ancient Himalayan folklore surrounded by alpine pine glades and glaciers.',
      slug: 'har-ki-dun',
      modelPath: '/models/har-ki-dun.glb',
      camPos: { x: -14, y: 10, z: 16 },
      targetPos: { x: -5, y: 2, z: -2 }
    },
    roopkund: {
      title: 'Roopkund Mystery Ridge',
      altitude: '15,750 FT / 4,800 M',
      region: 'Chamoli, Kumaon-Garhwal',
      diff: 'Difficult',
      desc: 'High-altitude glacial ridge beneath Trishul and Nanda Ghunti peaks.',
      slug: 'roopkund',
      camPos: { x: 0, y: 18, z: 20 },
      targetPos: { x: 0, y: 5.5, z: -4 }
    },
    brahmatal: {
      title: 'Brahmatal Summit Pass',
      altitude: '12,250 FT / 3,734 M',
      region: 'Chamoli, Uttarakhand',
      diff: 'Moderate',
      desc: 'Classic winter trek looking out over majestic Mount Trishul & Mount Nanda Ghunti.',
      slug: 'brahmatal',
      camPos: { x: 16, y: 12, z: -10 },
      targetPos: { x: 6, y: 3, z: -4 }
    }
  };

  let scene: any, camera: any, renderer: any;
  let terrainMesh: any, snowParticles: any;
  let isSnowing = true;
  let isDragging = false;
  let previousMousePosition = { x: 0, y: 0 };
  let targetCamPos = { x: 12, y: 14, z: 18 };
  let targetLookAt = { x: 4, y: 3.5, z: 2 };
  let currentLookAt = { x: 4, y: 3.5, z: 2 };
  let dirLight: any, ambientLight: any;
  let isInitialized = false;

  async function initThree() {
    const container = document.getElementById('three-canvas-container');
    if (!container || isInitialized) return;
    isInitialized = true;

    // Dynamically load Three.js and loaders only when scrolled into view
    const [threeMod, gltfMod, dracoMod] = await Promise.all([
      import('three'),
      import('three/examples/jsm/loaders/GLTFLoader.js'),
      import('three/examples/jsm/loaders/DRACOLoader.js')
    ]);
    THREE = threeMod;
    GLTFLoader = gltfMod.GLTFLoader;
    DRACOLoader = dracoMod.DRACOLoader;

    const width = container.clientWidth;
    const height = container.clientHeight;

    // Scene
    scene = new THREE.Scene();
    scene.background = new THREE.Color(0x090d16); // Deep atmospheric dark slate
    scene.fog = new THREE.FogExp2(0x090d16, 0.025);

    // Camera
    camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    camera.position.set(12, 14, 18);
    camera.lookAt(currentLookAt.x, currentLookAt.y, currentLookAt.z);

    // Renderer
    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false, powerPreference: 'high-performance' });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;

    container.appendChild(renderer.domElement);

    // Lights
    ambientLight = new THREE.AmbientLight(0xdbeafe, 0.6);
    scene.add(ambientLight);

    dirLight = new THREE.DirectionalLight(0xfef08a, 1.2);
    dirLight.position.set(20, 40, 20);
    dirLight.castShadow = true;
    dirLight.shadow.mapSize.width = 2048;
    dirLight.shadow.mapSize.height = 2048;
    scene.add(dirLight);

    // Create 3D Himalayan Terrain Mesh
    createHimalayanTerrain();
    loadPhotogrammetryMountain();

    // Create Snowfall Particles
    createSnowParticles();

    // Create 3D Summit Markers
    createSummitMarkers();

    // Unified Pointer Interaction (Touch + Mouse Orbit via Pointer Events API)
    container.addEventListener('pointerdown', (e) => {
      isDragging = true;
      previousMousePosition = { x: e.clientX, y: e.clientY };
      try { container.setPointerCapture(e.pointerId); } catch (_) {}
    });

    container.addEventListener('pointerup', (e) => {
      isDragging = false;
      try { container.releasePointerCapture(e.pointerId); } catch (_) {}
    });

    container.addEventListener('pointercancel', (e) => {
      isDragging = false;
      try { container.releasePointerCapture(e.pointerId); } catch (_) {}
    });

    container.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      const deltaX = e.clientX - previousMousePosition.x;
      const deltaY = e.clientY - previousMousePosition.y;

      // Orbit camera manually around current target
      const radius = camera.position.distanceTo(new THREE.Vector3(currentLookAt.x, currentLookAt.y, currentLookAt.z));
      let theta = Math.atan2(camera.position.x - currentLookAt.x, camera.position.z - currentLookAt.z);
      let phi = Math.acos((camera.position.y - currentLookAt.y) / radius);

      theta -= deltaX * 0.005;
      phi = Math.max(0.1, Math.min(Math.PI / 2.1, phi - deltaY * 0.005));

      camera.position.x = currentLookAt.x + radius * Math.sin(phi) * Math.sin(theta);
      camera.position.y = currentLookAt.y + radius * Math.cos(phi);
      camera.position.z = currentLookAt.z + radius * Math.sin(phi) * Math.cos(theta);

      previousMousePosition = { x: e.clientX, y: e.clientY };
    });

    // Resize Handler
    window.addEventListener('resize', () => {
      if (!container) return;
      const newW = container.clientWidth;
      const newH = container.clientHeight;
      camera.aspect = newW / newH;
      camera.updateProjectionMatrix();
      renderer.setSize(newW, newH);
    });

    // Setup Theme & UI Listeners
    setupUIControls();

    // Animation Loop
    animate();
  }

  function createHimalayanTerrain() {
    const gridWidth = 45;
    const gridDepth = 45;
    const gridSegments = 120;

    const geometry = new THREE.PlaneGeometry(gridWidth, gridDepth, gridSegments, gridSegments);
    geometry.rotateX(-Math.PI / 2);

    const posAttr = geometry.attributes.position;
    const colors = [];

    // Procedural Himalayan Peak Displacements
    for (let i = 0; i < posAttr.count; i++) {
      const x = posAttr.getX(i);
      const z = posAttr.getZ(i);

      // Combination of sinusoidal peaks to form Kedarkantha & Trishul ridges
      const distKedarkantha = Math.hypot(x - 4, z - 2);
      const peakKedarkantha = Math.max(0, 5.5 - distKedarkantha * 0.7);

      const distHarKiDun = Math.hypot(x + 5, z + 2);
      const peakHarKiDun = Math.max(0, 3.8 - distHarKiDun * 0.6);

      const distRoopkund = Math.hypot(x - 0, z + 4);
      const peakRoopkund = Math.max(0, 7.2 - distRoopkund * 0.8);

      const distBrahmatal = Math.hypot(x - 6, z + 4);
      const peakBrahmatal = Math.max(0, 4.8 - distBrahmatal * 0.65);

      // Base mountain ridges noise
      const ridge1 = Math.sin(x * 0.25) * Math.cos(z * 0.25) * 1.8;
      const ridge2 = Math.sin(x * 0.5 + 1.2) * Math.sin(z * 0.5) * 0.9;
      const detailNoise = (Math.sin(x * 1.2) * Math.cos(z * 1.2)) * 0.3;

      let height = peakKedarkantha + peakHarKiDun + peakRoopkund + peakBrahmatal + ridge1 + ridge2 + detailNoise;
      height = Math.max(-0.5, height);

      posAttr.setY(i, height);

      // Color based on elevation (Alpine pine forest -> slate rock -> snow cap)
      const color = new THREE.Color();
      if (height > 3.8) {
        // High snow peak
        color.setHSL(0.55, 0.2, 0.95);
      } else if (height > 2.0) {
        // Slate mountain rock
        color.setHSL(0.6, 0.15, 0.45);
      } else if (height > 0.5) {
        // Alpine forest green
        color.setHSL(0.38, 0.45, 0.25);
      } else {
        // Deep valley river bed
        color.setHSL(0.58, 0.5, 0.15);
      }

      colors.push(color.r, color.g, color.b);
    }

    geometry.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
    geometry.computeVertexNormals();

    const material = new THREE.MeshStandardMaterial({
      vertexColors: true,
      roughness: 0.8,
      metalness: 0.1,
      flatShading: true
    });

    terrainMesh = new THREE.Mesh(geometry, material);
    terrainMesh.receiveShadow = true;
    terrainMesh.castShadow = true;
    scene.add(terrainMesh);
  }

  function loadPhotogrammetryMountain() {
    try {
      const dracoLoader = new DRACOLoader();
      dracoLoader.setDecoderPath('/draco/');

      const loader = new GLTFLoader();
      loader.setDRACOLoader(dracoLoader);

      loader.load(
        '/models/weisse_wand_mountain_peek_draco.glb',
        (gltf: any) => {
          const model = gltf.scene;

          // Filter out the external flat skybox dome so custom dynamic atmosphere & snow shine
          model.traverse((child: any) => {
            if (child.isMesh) {
              if (child.name && child.name.includes('Material.001')) {
                child.visible = false;
              } else {
                child.castShadow = true;
                child.receiveShadow = true;
                if (child.material) {
                  const mat = child.material as THREE_TYPE.MeshStandardMaterial;
                  mat.roughness = 0.85;
                  mat.metalness = 0.05;
                }
              }
            }
          });

          // Auto-calculate bounding box and normalize scale & position
          const box = new THREE.Box3().setFromObject(model);
          const center = box.getCenter(new THREE.Vector3());
          const size = box.getSize(new THREE.Vector3());
          const maxDim = Math.max(size.x, size.y, size.z);
          const targetDim = 24; // Ideal viewing size in camera frustum
          const scale = targetDim / maxDim;

          model.scale.set(scale, scale, scale);
          model.position.x = -center.x * scale;
          model.position.y = -center.y * scale - 1.2;
          model.position.z = -center.z * scale;

          scene.add(model);
          if (terrainMesh) {
            terrainMesh.visible = false;
          }
        },
        undefined,
        (err: any) => {
          console.warn('Real 3D scan fallback to procedural terrain:', err);
        }
      );
    } catch (e) {
      console.warn('GLTFLoader initialization error:', e);
    }
  }

  function createSnowParticles() {
    const count = 600;
    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(count * 3);

    for (let i = 0; i < count * 3; i += 3) {
      positions[i] = (Math.random() - 0.5) * 50;
      positions[i + 1] = Math.random() * 25;
      positions[i + 2] = (Math.random() - 0.5) * 50;
    }

    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

    const material = new THREE.PointsMaterial({
      color: 0xffffff,
      size: 0.2,
      transparent: true,
      opacity: 0.85
    });

    snowParticles = new THREE.Points(geometry, material);
    scene.add(snowParticles);
  }

  function createSummitMarkers() {
    const peaks = [
      { x: 4, y: 5.5, z: 2, color: 0x38bdf8 },
      { x: -5, y: 3.8, z: -2, color: 0x34d399 },
      { x: 0, y: 7.2, z: -4, color: 0xf43f5e },
      { x: 6, y: 4.8, z: -4, color: 0xf59e0b }
    ];

    peaks.forEach((p) => {
      // Beacon cylinder
      const geom = new THREE.CylinderGeometry(0.1, 0.1, 2.5, 8);
      const mat = new THREE.MeshBasicMaterial({ color: p.color, transparent: true, opacity: 0.6 });
      const beacon = new THREE.Mesh(geom, mat);
      beacon.position.set(p.x, p.y + 1.25, p.z);
      scene.add(beacon);

      // Glowing sphere at top
      const sphereGeom = new THREE.SphereGeometry(0.3, 16, 16);
      const sphereMat = new THREE.MeshBasicMaterial({ color: p.color });
      const sphere = new THREE.Mesh(sphereGeom, sphereMat);
      sphere.position.set(p.x, p.y + 2.5, p.z);
      scene.add(sphere);
    });
  }

  function setupUIControls() {
    // Theme buttons
    const btnDawn = document.getElementById('btn-theme-dawn');
    const btnDay = document.getElementById('btn-theme-day');
    const btnNight = document.getElementById('btn-theme-night');
    const btnSnow = document.getElementById('btn-toggle-snow');
    const snowText = document.getElementById('snow-status-text');

    btnDawn?.addEventListener('click', () => {
      scene.background = new THREE.Color(0x31131b); // Amber dawn sky
      scene.fog = new THREE.FogExp2(0x31131b, 0.02);
      dirLight.color.setHex(0xfb923c);
      dirLight.intensity = 1.5;
      ambientLight.color.setHex(0xfecdd3);
      updateThemeButtons(btnDawn, [btnDay, btnNight]);
    });

    btnDay?.addEventListener('click', () => {
      scene.background = new THREE.Color(0x090d16); // Alpine blue day
      scene.fog = new THREE.FogExp2(0x090d16, 0.025);
      dirLight.color.setHex(0xfef08a);
      dirLight.intensity = 1.2;
      ambientLight.color.setHex(0xdbeafe);
      updateThemeButtons(btnDay, [btnDawn, btnNight]);
    });

    btnNight?.addEventListener('click', () => {
      scene.background = new THREE.Color(0x020617); // Night sky
      scene.fog = new THREE.FogExp2(0x020617, 0.03);
      dirLight.color.setHex(0x38bdf8);
      dirLight.intensity = 0.4;
      ambientLight.color.setHex(0x1e293b);
      updateThemeButtons(btnNight, [btnDawn, btnDay]);
    });

    btnSnow?.addEventListener('click', () => {
      isSnowing = !isSnowing;
      snowParticles.visible = isSnowing;
      if (snowText) snowText.innerText = isSnowing ? 'Snow On' : 'Snow Off';
    });

    // Peak chip clicks
    document.querySelectorAll('.peak-chip').forEach((chip) => {
      chip.addEventListener('click', (e) => {
        const peakKey = (e.currentTarget as HTMLElement).dataset.peak;
        if (peakKey && PEAK_DATA[peakKey]) {
          selectPeak(peakKey);
          document.querySelectorAll('.peak-chip').forEach(c => c.classList.remove('active-chip', 'bg-cyan-500/20', 'border-cyan-500/40'));
          chip.classList.add('active-chip', 'bg-cyan-500/20', 'border-cyan-500/40');
        }
      });
    });

    // Book CTA trigger modal
    document.getElementById('hud-book-btn')?.addEventListener('click', (e) => {
      const slug = (e.currentTarget as HTMLElement).dataset.slug;
      if (window.location.pathname.includes('/treks/')) {
        const modal = document.getElementById('booking-modal') as HTMLDialogElement;
        modal?.showModal();
      } else {
        window.location.href = `/treks/${slug || 'kedarkantha'}`;
      }
    });
  }

  function updateThemeButtons(activeBtn: HTMLElement | null, inactiveBtns: (HTMLElement | null)[]) {
    if (activeBtn) {
      activeBtn.className = "px-2.5 py-1 rounded-md bg-cyan-500 text-slate-950 font-bold shadow transition flex items-center gap-1";
    }
    inactiveBtns.forEach(btn => {
      if (btn) {
        btn.className = "px-2.5 py-1 rounded-md text-slate-300 hover:bg-slate-700 transition font-medium flex items-center gap-1";
      }
    });
  }

  function selectPeak(key: string) {
    const data = PEAK_DATA[key];
    if (!data) return;

    targetCamPos = data.camPos;
    targetLookAt = data.targetPos;
    if ((window as any).loadPeakModel) {
       (window as any).loadPeakModel(data.modelPath || '/models/weisse_wand_mountain_peek_draco.glb');
    }

    // Update HUD
    const hudTitle = document.getElementById('hud-title');
    const hudAlt = document.getElementById('hud-altitude');
    const hudRegion = document.getElementById('hud-region');
    const hudDiff = document.getElementById('hud-diff');
    const hudDesc = document.getElementById('hud-desc');
    const bookBtn = document.getElementById('hud-book-btn');

    if (hudTitle) hudTitle.innerText = data.title;
    if (hudAlt) hudAlt.innerText = data.altitude;
    if (hudRegion) hudRegion.innerText = data.region;
    if (hudDiff) hudDiff.innerText = data.diff;
    if (hudDesc) hudDesc.innerText = data.desc;
    if (bookBtn) bookBtn.dataset.slug = data.slug;
  }

  let animationFrameId: number | null = null;

  function animate() {
    animationFrameId = requestAnimationFrame(animate);

    // Skip animation frames if reduced motion is preferred
    if (prefersReducedMotion) {
      renderer.render(scene, camera);
      return;
    }

    // Rotate snow particles
    if (isSnowing && snowParticles) {
      const posAttr = snowParticles.geometry.attributes.position;
      for (let i = 1; i < posAttr.count * 3; i += 3) {
        let y = posAttr.getY(Math.floor(i / 3));
        y -= 0.08;
        if (y < 0) y = 25;
        posAttr.setY(Math.floor(i / 3), y);
      }
      snowParticles.geometry.attributes.position.needsUpdate = true;
    }

    // Smoothly interpolate camera movement to focus target
    camera.position.x += (targetCamPos.x - camera.position.x) * 0.03;
    camera.position.y += (targetCamPos.y - camera.position.y) * 0.03;
    camera.position.z += (targetCamPos.z - camera.position.z) * 0.03;

    currentLookAt.x += (targetLookAt.x - currentLookAt.x) * 0.03;
    currentLookAt.y += (targetLookAt.y - currentLookAt.y) * 0.03;
    currentLookAt.z += (targetLookAt.z - currentLookAt.z) * 0.03;

    camera.lookAt(currentLookAt.x, currentLookAt.y, currentLookAt.z);

    renderer.render(scene, camera);
  }

  // Cleanup function to dispose Three.js resources
  function cleanup() {
    if (animationFrameId !== null) {
      cancelAnimationFrame(animationFrameId);
      animationFrameId = null;
    }

    if (renderer) {
      renderer.dispose();
      renderer.domElement.remove();
    }

    if (scene) {
      scene.traverse((object: any) => {
        if (object && object.isMesh) {
          object.geometry?.dispose();
          if (Array.isArray(object.material)) {
            object.material.forEach((mat: any) => mat.dispose());
          } else {
            object.material?.dispose();
          }
        }
      });
    }
  }

  // Lazy-load Three.js when the 3D Peak Explorer container approaches the viewport
  function setupLazyLoad() {
    const container = document.getElementById('three-canvas-container');
    if (!container) return;

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          observer.disconnect();
          initThree();
        }
      }, { rootMargin: '300px' });
      observer.observe(container);
    } else {
      initThree();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupLazyLoad);
  } else {
    setupLazyLoad();
  }

  // Cleanup on page unload
  window.addEventListener('beforeunload', cleanup);
</script>