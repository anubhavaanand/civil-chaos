---
// GlassNav.astro
---
<header class="fixed top-0 left-0 right-0 z-50 p-4 md:px-8 pointer-events-none">
  <div class="nav-glass glass pointer-events-auto max-w-7xl mx-auto flex items-center justify-between px-5 md:px-7 py-3.5 rounded-2xl bg-black/60 backdrop-blur-xl border border-white/10 shadow-2xl">
    <a href="#" class="logo flex items-center gap-2.5 font-display font-bold text-base md:text-lg text-white hover:text-cyan-300 transition-colors" data-od-id="logo">
      <span class="logo-icon text-xl">⛰️</span>
      <span class="tracking-tight">Dream of The Holy Himalayas</span>
    </a>
    
    <ul class="nav-links hidden md:flex items-center gap-8 list-none">
      <li><a href="#treks" class="text-sm font-medium text-slate-300 hover:text-cyan-400 transition-colors">Treks</a></li>
      <li><a href="#peak-viewer" class="text-sm font-medium text-slate-300 hover:text-cyan-400 transition-colors">Experience</a></li>
      <li><a href="#booking" class="text-sm font-medium text-slate-300 hover:text-cyan-400 transition-colors">Book Now</a></li>
      <li><a href="#contact" class="text-sm font-medium text-slate-300 hover:text-cyan-400 transition-colors">Contact</a></li>
    </ul>

    <div class="flex items-center gap-4">
      <div class="rating flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/25 text-xs font-semibold text-cyan-300 shadow-[0_0_15px_rgba(0,242,254,0.15)]" data-od-id="rating-badge">
        <span>⭐ 5.0</span>
        <span class="text-slate-400 font-normal hidden sm:inline">(1,200+ reviews)</span>
      </div>

      <!-- Mobile Nav Toggle -->
      <div class="md:hidden flex items-center">
        <label for="mobile-menu-toggle" class="cursor-pointer text-slate-200 hover:text-cyan-400 p-1.5" aria-label="Toggle mobile menu">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </label>
        <input type="checkbox" id="mobile-menu-toggle" class="peer hidden" />
        
        <div class="absolute top-20 left-4 right-4 backdrop-blur-xl bg-slate-950/95 border border-white/20 rounded-2xl hidden peer-checked:block transition-all shadow-2xl p-5 z-40">
          <ul class="flex flex-col gap-3 list-none">
            <li><a href="#treks" class="block py-2 text-slate-200 hover:text-cyan-400 font-medium">Treks</a></li>
            <li><a href="#peak-viewer" class="block py-2 text-slate-200 hover:text-cyan-400 font-medium">Experience</a></li>
            <li><a href="#booking" class="block py-2 text-slate-200 hover:text-cyan-400 font-medium">Book Now</a></li>
            <li><a href="#contact" class="block py-2 text-slate-200 hover:text-cyan-400 font-medium">Contact</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>
