---
import { SITE_CONFIG } from '../config/site';
---
<header class="fixed top-0 left-0 right-0 z-50 px-4 pt-3 md:px-8 pointer-events-none" transition:name="main-navigation" transition:persist>
  <div class="pointer-events-auto max-w-7xl mx-auto flex items-center justify-between px-5 md:px-7 py-3.5 rounded-2xl bg-[#070B12]/90 backdrop-blur-xl border border-white/15 shadow-2xl">
    <a href="/" class="flex items-center gap-3 group" data-od-id="logo">
      <div class="w-9 h-9 rounded-xl bg-[#00F2FE]/15 border border-[#00F2FE]/40 flex items-center justify-center text-[#00F2FE] group-hover:bg-[#00F2FE] group-hover:text-[#050505] transition-colors">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m8 3 4 8 5-5 5 15H2L8 3z" />
        </svg>
      </div>
      <div>
        <span class="block font-display font-bold text-sm sm:text-base text-white tracking-tight group-hover:text-[#00F2FE] transition-colors">
          {SITE_CONFIG.name}
        </span>
        <span class="block font-mono text-[10px] uppercase tracking-widest text-[#94A3B8]">
          Mautar Basecamp &middot; Uttarakhand
        </span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-[#cbd5e1]" aria-label="Primary">
      <a href="/treks" class="hover:text-[#00F2FE] transition-colors">Expeditions (10)</a>
      <a href="/#route-visualizer" class="hover:text-[#00F2FE] transition-colors">Trail Elevations</a>
      <a href="/#departures" class="hover:text-[#00F2FE] transition-colors">2027 Departures</a>
      <a href="/about" class="hover:text-[#00F2FE] transition-colors">Mautar Heritage</a>
      <a href="/contact" class="hover:text-[#00F2FE] transition-colors">Basecamp Comms</a>
    </nav>

    <!-- Mobile hamburger menu toggle -->
    <button
      id="mobile-menu-toggle"
      class="md:hidden p-2 rounded-lg border border-white/15 bg-white/5 hover:border-[#00F2FE] hover:bg-[#00F2FE]/20 text-white transition-colors cursor-pointer"
      aria-label="Open main navigation"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Mobile navigation drawer -->
    <nav id="mobile-nav" class="md:hidden fixed inset-0 z-50 flex flex-col items-start justify-start bg-[#050505] border-r border-white/15 shadow-2xl transform -translate-x-full transition-transform duration-300 ease-in-out p-6 sm:p-8">
      <div class="w-full flex justify-between items-center mb-8">
        <span class="font-display font-bold text-lg text-white">Mautar Basecamp</span>
        <button
          id="mobile-menu-close"
          class="p-2 rounded-lg hover:bg-white/5 text-[#cbd5e1] transition-colors cursor-pointer"
          aria-label="Close main navigation"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <ul class="space-y-4 text-sm font-medium text-[#cbd5e1]">
        <li><a href="/treks" class="block hover:text-[#00F2FE] transition-colors py-2">Expeditions (10)</a></li>
        <li><a href="/#route-visualizer" class="block hover:text-[#00F2FE] transition-colors py-2">Trail Elevations</a></li>
        <li><a href="/#departures" class="block hover:text-[#00F2FE] transition-colors py-2">2027 Departures</a></li>
        <li><a href="/about" class="block hover:text-[#00F2FE] transition-colors py-2">Mautar Heritage</a></li>
        <li><a href="/contact" class="block hover:text-[#00F2FE] transition-colors py-2">Basecamp Comms</a></li>
      </ul>
      <div class="mt-8 space-y-3">
        <a
          href={`https://wa.me/${SITE_CONFIG.phoneRaw}?text=${encodeURIComponent('Namaste Dream of The Holy Himalayas! Please help me choose an upcoming trek batch.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-white/15 bg-white/5 hover:border-[#34D399]/50 text-xs font-mono font-semibold text-[#e8eef2] transition-colors"
        >
          <span class="w-2 h-2 rounded-full bg-[#34D399] animate-pulse"></span>
          <span>WhatsApp Guide</span>
        </a>
        <a
          href="/#booking"
          class="btn-tactile inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#00F2FE] hover:bg-[#00b4d8] text-xs font-mono font-bold uppercase tracking-wider text-[#050505] shadow-md transition-all"
        >
          <span>Reserve Seat</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </nav>

  <script>
    const toggle = document.getElementById('mobile-menu-toggle');
    const closeBtn = document.getElementById('mobile-menu-close');
    const mobileNav = document.getElementById('mobile-nav');

    if (toggle && mobileNav) {
      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!expanded));
        mobileNav.classList.toggle('-translate-x-full');
      });
    }

    if (closeBtn && mobileNav && toggle) {
      closeBtn.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        mobileNav.classList.add('-translate-x-full');
      });
    }
  </script>

    <div class="flex items-center gap-3">
      <a
        href={`https://wa.me/${SITE_CONFIG.phoneRaw}?text=${encodeURIComponent('Namaste Dream of The Holy Himalayas! Please help me choose an upcoming trek batch.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden lg:inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-white/15 bg-white/5 hover:border-[#34D399]/50 text-xs font-mono font-semibold text-[#e8eef2] transition-colors"
      >
        <span class="w-2 h-2 rounded-full bg-[#34D399] animate-pulse"></span>
        <span>WhatsApp Guide</span>
      </a>

      <a
        href="/#booking"
        class="btn-tactile inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#00F2FE] hover:bg-[#00b4d8] text-xs font-mono font-bold uppercase tracking-wider text-[#050505] shadow-md transition-all"
      >
        <span>Reserve Seat</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</header>
