---
import { SITE_CONFIG } from '../config/site';
---
<footer class="relative mt-20 border-t border-white/20 backdrop-blur-md backdrop-saturate-150 bg-slate-900/80 text-slate-200 font-['Inter']">
  <div class="absolute inset-0 bg-black/50 pointer-events-none -z-10"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h2 class="text-2xl font-bold font-['Space_Grotesk'] mb-4 text-white">{SITE_CONFIG.name}</h2>
        <p class="text-sm text-slate-400 leading-relaxed max-w-xs">
          Your trusted partner for safe, authentic, and unforgettable Himalayan trekking adventures.
        </p>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-white mb-4 font-['Space_Grotesk']">Contact</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-2 text-slate-300">
            <svg class="w-5 h-5 text-teal-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{SITE_CONFIG.basecamp}</span>
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-5 h-5 text-teal-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href={`tel:${SITE_CONFIG.phoneTel}`} class="hover:text-teal-400 transition-colors">{SITE_CONFIG.phoneDisplay}</a>
          </li>
          <li class="flex items-center gap-2 text-slate-300">
            <svg class="w-5 h-5 text-teal-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${SITE_CONFIG.email}`} class="hover:text-teal-400 transition-colors">{SITE_CONFIG.email}</a>
          </li>
        </ul>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-white mb-4 font-['Space_Grotesk']">Quick Links</h3>
        <ul class="space-y-3 text-sm text-slate-300">
          <li><a href="/treks" class="hover:text-teal-400 transition-colors">All Treks</a></li>
          <li><a href="/about" class="hover:text-teal-400 transition-colors">About Us</a></li>
          <li><a href="/contact" class="hover:text-teal-400 transition-colors">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-400">
      <p>&copy; 2026 Dream of The Holy Himalayas. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="#" class="hover:text-teal-400 transition-colors">Instagram</a>
        <a href="#" class="hover:text-teal-400 transition-colors">Facebook</a>
      </div>
    </div>
  </div>
</footer>
