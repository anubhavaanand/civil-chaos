---
import type { ItineraryDay } from '../data/mock-treks';

interface Props {
  days: ItineraryDay[];
}

const { days } = Astro.props;
---

<div class="space-y-4">
  {days.map((item) => (
    <details class="group rounded-2xl border border-[#0F172A]/10 bg-white/80 transition-all duration-300 hover:border-brand/40 [&[open]]:bg-white/90 [&[open]]:border-brand/60">
      <summary class="flex cursor-pointer items-center justify-between p-5 text-left select-none">
        <div class="flex items-center gap-4">
          <!-- Day badge -->
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand/10 border border-brand/30 text-brand font-display text-sm font-bold">
            Day {item.day}
          </div>
          <div>
            <h4 class="font-display text-base font-bold text-[#0F172A] group-hover:text-brand transition-colors">
              {item.title}
            </h4>
            <div class="mt-1 flex items-center gap-3 text-xs text-ink-dim">
              <span class="inline-flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-[#EA580C]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8 3 4 8 5-5 5 15H2L8 3z"/>
                </svg>
                <span>{item.altitudeM.toLocaleString()} m</span>
              </span>
              {item.distanceKm > 0 && (
                <span class="inline-flex items-center gap-1">
                  <span class="text-[#94A3B8]/40">&middot;</span>
                  <svg class="w-3.5 h-3.5 text-[#94A3B8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                  </svg>
                  <span>{item.distanceKm} km trek</span>
                </span>
              )}
            </div>
          </div>
        </div>

        <!-- Chevron Icon -->
        <svg class="h-5 w-5 text-ink-dim transition-transform duration-300 group-open:rotate-180 group-open:text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>

      <div class="px-5 pb-5 pt-2 text-sm text-ink leading-relaxed border-t border-[#0F172A]/10">
        <p>{item.description}</p>
      </div>
    </details>
  ))}
</div>