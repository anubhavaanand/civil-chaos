---
import Layout from '../layouts/Layout.astro';
import GlassNav from '../components/GlassNav.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Footer from '../components/Footer.astro';

// Core values and telemetry for Swiss Editorial spread
const values = [
  {
    code: "01 / ORIGIN",
    title: "Native Mautar Lineage",
    desc: "Our basecamp and operational headquarters reside in Village Mautar, perched in the high valleys of Uttarkashi. We do not operate via remote agency desks. We live where the trails begin.",
    metric: "1,950m",
    metricLabel: "Basecamp Datum"
  },
  {
    code: "02 / RIGOR",
    title: "Nehru Institute Certified",
    desc: "Every lead expedition leader holds certification from the Nehru Institute of Mountaineering (NIM) alongside international Wilderness First Responder credentials.",
    metric: "100%",
    metricLabel: "NIM / WFR Certified"
  },
  {
    code: "03 / INTIMACY",
    title: "Strict Micro-Batches",
    desc: "Commercial syndicates herd 35 to 40 people on fragile alpine passes. We enforce a strict maximum ceiling of 8 to 12 climbers per departure with a 1:4 guide ratio.",
    metric: "1:4",
    metricLabel: "Guide to Climber Ratio"
  },
  {
    code: "04 / ECOLOGY",
    title: "Leave No Trace Accord",
    desc: "Every expedition carries down all waste plus ten percent additional trail debris. High-altitude meadows (bugyals) are preserved for the pastoralists who share them.",
    metric: "-10%",
    metricLabel: "Net Waste Footprint"
  }
];

const credentials = [
  { label: "Nehru Institute of Mountaineering", sub: "Advance Mountaineering & Method of Instruction (MOI)" },
  { label: "Wilderness Medical Associates", sub: "Wilderness First Responder (WFR) & CPR" },
  { label: "Uttarakhand Tourism Development Board", sub: "Authorized High-Altitude Expedition Operator" },
  { label: "Indian Mountaineering Foundation (IMF)", sub: "Registered Technical Alpine Guides" }
];
---

<Layout title="Our Alpine Heritage | Dream of The Holy Himalayas">
  <GlassNav />

  <main class="pt-28 pb-24 bg-[#050505] min-h-screen text-ink font-body">
    
    <!-- Hero Section: Swiss Editorial Style -->
    <section class="relative px-6 max-w-7xl mx-auto mb-20">
      <div class="flex items-center gap-3 mb-4">
        <span class="h-[2px] w-8 bg-[#00f2fe]"></span>
        <span class="text-[#00f2fe] font-mono text-xs tracking-widest uppercase font-bold">Provenance and Philosophy</span>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-end pb-12 border-b border-white/10">
        <div class="lg:col-span-8">
          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-display font-black text-white tracking-tight leading-[1.05]">
            ROOTED IN THE SACRED RIDGES OF UTTARKASHI
          </h1>
        </div>
        <div class="lg:col-span-4">
          <p class="text-silver text-base sm:text-lg leading-relaxed font-light">
            Founded by multi-generational mountain guides from Village Mautar. We believe true Himalayan intimacy is earned through small groups, generational respect, and uncompromising safety.
          </p>
        </div>
      </div>
    </section>

    <!-- Editorial Visual Spread: Dual Split Hero Imagery -->
    <section class="max-w-7xl mx-auto px-6 mb-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        
        <!-- Large Photo Card -->
        <div class="lg:col-span-8 relative rounded-2xl overflow-hidden border border-white/10 min-h-[420px] lg:min-h-[520px] shadow-2xl group">
          <img 
            src="https://images.unsplash.com/photo-1542228262-3d663b306a53?q=80&w=1600&auto=format&fit=crop" 
            alt="Mautar native guides leading ridge traverse in Garhwal Himalayas" 
            class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-[#050505]/40 to-transparent"></div>
          
          <div class="absolute bottom-6 left-6 right-6 p-6 rounded-xl bg-[#050505]/80 backdrop-blur-md border border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <div class="text-[10px] font-mono text-[#00f2fe] uppercase tracking-widest font-bold">Geographic Lineage</div>
              <div class="text-white font-display text-lg font-bold">Village Mautar, Upper Bhagirathi Basin</div>
            </div>
            <div class="text-right font-mono text-xs text-silver">
              Elev. 1,950m MSL &middot; 30&deg;44&apos; N, 78&deg;26&apos; E
            </div>
          </div>
        </div>

        <!-- Right Side Concentric Telemetry Card -->
        <div class="lg:col-span-4 flex flex-col justify-between double-bezel-outer">
          <div class="double-bezel-inner p-8 bg-[#0a0f18]/90 backdrop-blur-xl h-full flex flex-col justify-between">
            <div>
              <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#00f2fe]/10 border border-[#00f2fe]/30 text-[#00f2fe] text-xs font-mono font-bold tracking-widest uppercase mb-6">
                <span class="w-1.5 h-1.5 rounded-full bg-[#00f2fe] animate-pulse"></span>
                The Mautar Oath
              </span>
              <h3 class="text-2xl font-display font-bold text-white mb-4">
                The Mountain Is Not Conquered. It Permits Us.
              </h3>
              <p class="text-silver text-sm leading-relaxed font-light mb-6">
                In commercial tourism, summits are marketed as trophies to consume. In Mautar tradition, every ridge is sacred. We step onto high passes with humility, complete physiological preparation, and profound reverence for the high Himalaya.
              </p>
            </div>

            <div class="pt-6 border-t border-white/10 space-y-3 font-mono text-xs">
              <div class="flex items-center justify-between text-silver">
                <span>Years of Guiding</span>
                <span class="font-bold text-white">12+ Years</span>
              </div>
              <div class="flex items-center justify-between text-silver">
                <span>Total Safe Ascents</span>
                <span class="font-bold text-[#00f2fe]">1,400+ Summits</span>
              </div>
              <div class="flex items-center justify-between text-silver">
                <span>Google Verified Score</span>
                <span class="font-bold text-emerald-400">5.0 / 5.0 (40+ Reviews)</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- The 4 Pillars: Swiss Minimalist Grid -->
    <section class="max-w-7xl mx-auto px-6 mb-24">
      <div class="mb-12">
        <div class="flex items-center gap-3 mb-3">
          <span class="h-[2px] w-8 bg-[#00f2fe]"></span>
          <span class="text-[#00f2fe] font-mono text-xs tracking-widest uppercase font-bold">Standard Operating Rigor</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-white tracking-tight">
          THE PILLARS OF OUR CRAFT
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {values.map((v) => (
          <div class="double-bezel-outer group">
            <div class="double-bezel-inner p-6 bg-[#0a0f18]/80 hover:bg-[#0f172a]/90 transition-all duration-300 h-full flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="font-mono text-xs font-bold text-[#00f2fe]">{v.code}</span>
                  <div class="w-2 h-2 rounded-full bg-white/20 group-hover:bg-[#00f2fe] transition-colors"></div>
                </div>
                <h3 class="text-xl font-display font-bold text-white mb-3">{v.title}</h3>
                <p class="text-silver text-xs leading-relaxed font-light">{v.desc}</p>
              </div>

              <div class="mt-8 pt-4 border-t border-white/10 flex items-baseline justify-between font-mono">
                <span class="text-[10px] uppercase text-silver/60 tracking-wider">{v.metricLabel}</span>
                <span class="text-lg font-bold text-[#00f2fe]">{v.metric}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Expedition Safety Manifest & Equipment Rigor -->
    <section class="max-w-7xl mx-auto px-6 mb-24">
      <div class="rounded-2xl border border-white/10 bg-[#0a0f18]/60 p-8 sm:p-12 relative overflow-hidden shadow-2xl">
        <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          
          <div class="lg:col-span-7">
            <span class="text-xs font-mono text-[#00f2fe] tracking-widest uppercase font-bold block mb-3">
              High Altitude Medical Protocol
            </span>
            <h2 class="text-3xl sm:text-4xl font-display font-bold text-white mb-6 leading-tight">
              Comprehensive Safety Staging On Every Route
            </h2>
            <p class="text-silver text-sm sm:text-base leading-relaxed font-light mb-8">
              We do not treat emergency protocols as optional insurance. On all high passes exceeding 4,000 meters, our guides carry medical oxygen cylinders, twice-daily digital pulse oximeters, hyperbaric treatment kits, and satellite distress communication transceivers.
            </p>

            <!-- Certified Credential Badges -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {credentials.map((c) => (
                <div class="p-4 rounded-xl border border-white/10 bg-white/5 flex items-start gap-3">
                  <svg class="w-5 h-5 text-[#00f2fe] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  <div>
                    <h4 class="text-white text-xs font-bold font-display">{c.label}</h4>
                    <p class="text-[11px] text-silver/60 font-mono mt-0.5">{c.sub}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Technical Equipment Manifest Box -->
          <div class="lg:col-span-5 double-bezel-outer">
            <div class="double-bezel-inner p-6 bg-[#050505]/95">
              <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-5">
                <span class="text-xs font-mono uppercase text-[#00f2fe] font-bold tracking-wider">Standard Field Manifest</span>
                <span class="text-[10px] font-mono text-silver/60">REV 4.2</span>
              </div>
              
              <ul class="space-y-3 font-mono text-xs text-silver">
                <li class="flex items-center justify-between">
                  <span class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    Medical O2 Cylinders
                  </span>
                  <span class="text-white font-bold">2x per 8 Climbers</span>
                </li>
                <li class="flex items-center justify-between">
                  <span class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    Digital Pulse Oximeters
                  </span>
                  <span class="text-white font-bold">Twice Daily Audits</span>
                </li>
                <li class="flex items-center justify-between">
                  <span class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    4-Season Geodesic Tents
                  </span>
                  <span class="text-white font-bold">Rated to -25&deg;C</span>
                </li>
                <li class="flex items-center justify-between">
                  <span class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    VHF Radio Network
                  </span>
                  <span class="text-white font-bold">Direct Relay to HQ</span>
                </li>
                <li class="flex items-center justify-between">
                  <span class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    Bio-Degradable Camp Ethics
                  </span>
                  <span class="text-white font-bold">100% Zero Trace</span>
                </li>
              </ul>

              <div class="mt-6 pt-4 border-t border-white/10 text-center">
                <a 
                  href="/contact" 
                  class="btn-tactile inline-block w-full py-3 rounded-lg bg-[#00f2fe] text-[#050505] font-bold font-mono text-xs uppercase tracking-wider hover:bg-white transition-colors text-center"
                >
                  Inquire With Lead Guides
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Uttarkashi Emergency Rescue & Airborne Sortie Chain -->
    <section class="max-w-7xl mx-auto px-6 mb-24">
      <div class="mb-12">
        <div class="flex items-center gap-3 mb-3">
          <span class="h-[2px] w-8 bg-[#00f2fe]"></span>
          <span class="text-[#00f2fe] font-mono text-xs tracking-widest uppercase font-bold">Sub-Zero Evacuation Protocols</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-white tracking-tight">
          UTTARKASHI RESCUE & AIRBORNE RELAY
        </h2>
        <p class="text-silver mt-3 max-w-2xl text-base font-light leading-relaxed">
          How our Village Mautar headquarters coordinates with SDRF Uttarakhand, Indian Air Force search units, and Matli Helipad for zero-lag emergency response.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Step 1: On-Mountain Stabilization -->
        <div class="double-bezel-outer">
          <div class="double-bezel-inner p-6 bg-[#0a0f18]/90 backdrop-blur-xl h-full flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-white/10 mb-4 font-mono text-xs">
                <span class="text-[#00f2fe] font-bold">STAGE 01</span>
                <span class="text-silver/60">&gt;3,800m MSL</span>
              </div>
              <h3 class="text-lg font-display font-bold text-white mb-2">On-Mountain Staging</h3>
              <p class="text-silver text-xs leading-relaxed font-light mb-4">
                Immediate descent protocol assisted by two certified guides. Continuous medical oxygen delivery (4 to 6 L/min) and portable Gamow hyperbaric chamber deployment simulating a 1,500-meter drop.
              </p>
            </div>
            <div class="pt-4 border-t border-white/10 font-mono text-[11px] text-emerald-400">
              Protocol: Lake Louise AMS Audit
            </div>
          </div>
        </div>

        <!-- Step 2: Trailhead Ground Transit -->
        <div class="double-bezel-outer">
          <div class="double-bezel-inner p-6 bg-[#0a0f18]/90 backdrop-blur-xl h-full flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-white/10 mb-4 font-mono text-xs">
                <span class="text-[#00f2fe] font-bold">STAGE 02</span>
                <span class="text-silver/60">Trailhead Depot</span>
              </div>
              <h3 class="text-lg font-display font-bold text-white mb-2">4x4 Roadhead Transit</h3>
              <p class="text-silver text-xs leading-relaxed font-light mb-4">
                Dedicated four-wheel-drive emergency transport staged on permanent standby at Sankri, Gangotri, and Joshimath depots. Direct VHF and satellite telemetry relay to Mautar HQ.
              </p>
            </div>
            <div class="pt-4 border-t border-white/10 font-mono text-[11px] text-emerald-400">
              Standby: Sankri / Gangotri
            </div>
          </div>
        </div>

        <!-- Step 3: Airborne Chopper Sortie -->
        <div class="double-bezel-outer">
          <div class="double-bezel-inner p-6 bg-[#0a0f18]/90 backdrop-blur-xl h-full flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-white/10 mb-4 font-mono text-xs">
                <span class="text-[#00f2fe] font-bold">STAGE 03</span>
                <span class="text-silver/60">Matli Helipad</span>
              </div>
              <h3 class="text-lg font-display font-bold text-white mb-2">Airborne Sortie Relay</h3>
              <p class="text-silver text-xs leading-relaxed font-light mb-4">
                Direct coordination with District Emergency Operations Centre (DEOC Uttarkashi) and SDRF 3rd Bn. Staged from Matli Helipad (1,150m MSL) for IAF Chetak / Cheetah or civil air ambulances.
              </p>
            </div>
            <div class="pt-4 border-t border-white/10 font-mono text-[11px] text-[#00f2fe]">
              Coord: 30&deg;42&apos; N, 78&deg;26&apos; E
            </div>
          </div>
        </div>

        <!-- Step 4: Tertiary Critical Care -->
        <div class="double-bezel-outer">
          <div class="double-bezel-inner p-6 bg-[#0a0f18]/90 backdrop-blur-xl h-full flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-white/10 mb-4 font-mono text-xs">
                <span class="text-[#00f2fe] font-bold">STAGE 04</span>
                <span class="text-silver/60">Level-1 Trauma</span>
              </div>
              <h3 class="text-lg font-display font-bold text-white mb-2">AIIMS Rishikesh Transfer</h3>
              <p class="text-silver text-xs leading-relaxed font-light mb-4">
                Immediate stabilization at District Hospital Uttarkashi followed by express transit to AIIMS Rishikesh advanced pulmonary and hyperbaric critical care unit.
              </p>
            </div>
            <div class="pt-4 border-t border-white/10 font-mono text-[11px] text-emerald-400">
              Facility: 24/7 Hyperbaric Unit
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Garhwali Alpine Trail Nutrition & Sustainable Mountain Lore -->
    <section class="max-w-7xl mx-auto px-6 mb-24">
      <div class="mb-12">
        <div class="flex items-center gap-3 mb-3">
          <span class="h-[2px] w-8 bg-[#00f2fe]"></span>
          <span class="text-[#00f2fe] font-mono text-xs tracking-widest uppercase font-bold">Indigenous Mountain Science</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-white tracking-tight">
          NUTRITION & ETHICAL MOUNTAIN CHARTER
        </h2>
        <p class="text-silver mt-3 max-w-2xl text-base font-light leading-relaxed">
          How native high-altitude cuisine and equitable staff stewardship form the invisible foundation of safe, authentic expeditions.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Pillar 1: Indigenous Trail Nutrition -->
        <div class="double-bezel-outer">
          <div class="double-bezel-inner p-8 bg-[#0a0f18]/90 backdrop-blur-xl h-full flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-6">
                <span class="text-xs font-mono uppercase text-[#00f2fe] font-bold tracking-wider">Garhwali Trail Nutrition</span>
                <span class="text-[10px] font-mono text-silver/60">BIO-ENERGETICS</span>
              </div>
              <h3 class="text-2xl font-display font-bold text-white mb-4">Slow-Burning High-Altitude Fuel</h3>
              <p class="text-silver text-sm leading-relaxed font-light mb-6">
                Commercial agencies feed climbers instant noodles and processed sugars that spike blood glucose and cause energy crashes on steep moraines. Our camp kitchens prepare nutrient-dense Garhwali staples perfected over centuries:
              </p>

              <div class="space-y-4 font-mono text-xs">
                <div class="p-3.5 rounded-xl border border-white/10 bg-white/[0.02]">
                  <div class="flex items-center justify-between text-white font-bold mb-1">
                    <span>Mandua (Finger Millet) Rotis</span>
                    <span class="text-[#00f2fe]">High Calcium & Iron</span>
                  </div>
                  <p class="text-silver/70 font-sans text-xs font-light">Low glycemic index complex carbohydrates that provide continuous cellular energy in sub-zero ridge conditions.</p>
                </div>

                <div class="p-3.5 rounded-xl border border-white/10 bg-white/[0.02]">
                  <div class="flex items-center justify-between text-white font-bold mb-1">
                    <span>Gahat (Horse Gram) Broth</span>
                    <span class="text-[#00f2fe]">Thermoregulatory</span>
                  </div>
                  <p class="text-silver/70 font-sans text-xs font-light">Garhwali folk medicinal soup that supports kidney filtration, prevents dehydration crystals, and maintains body core heat.</p>
                </div>

                <div class="p-3.5 rounded-xl border border-white/10 bg-white/[0.02]">
                  <div class="flex items-center justify-between text-white font-bold mb-1">
                    <span>Wild Buransh (Rhododendron) Elixir</span>
                    <span class="text-[#00f2fe]">Natural Electrolyte</span>
                  </div>
                  <p class="text-silver/70 font-sans text-xs font-light">Rich in potassium, flavonoids, and natural antioxidants to counter oxidative altitude stress and relieve hypobaric headaches.</p>
                </div>
              </div>
            </div>

            <div class="mt-8 pt-4 border-t border-white/10 text-xs font-mono text-silver/70 flex items-center justify-between">
              <span>Camp Catering: 100% Freshly Cooked</span>
              <span class="text-emerald-400 font-bold">Zero Ultra-Processed Rations</span>
            </div>
          </div>
        </div>

        <!-- Pillar 2: Ethical Staff & Porter Charter -->
        <div class="double-bezel-outer">
          <div class="double-bezel-inner p-8 bg-[#0a0f18]/90 backdrop-blur-xl h-full flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-6">
                <span class="text-xs font-mono uppercase text-[#00f2fe] font-bold tracking-wider">Staff Stewardship Charter</span>
                <span class="text-[10px] font-mono text-silver/60">EQUITY & DIGNITY</span>
              </div>
              <h3 class="text-2xl font-display font-bold text-white mb-4">The Mountain Family We Protect</h3>
              <p class="text-silver text-sm leading-relaxed font-light mb-6">
                Too often in commercial tourism, mountain porters and support crews are overworked, underpaid, and left to sleep in drafty kitchen tents. We enforce an uncompromising ethical covenant:
              </p>

              <div class="space-y-4 font-mono text-xs">
                <div class="p-3.5 rounded-xl border border-white/10 bg-white/[0.02]">
                  <div class="flex items-center justify-between text-white font-bold mb-1">
                    <span>Strict 20kg Load Limit</span>
                    <span class="text-emerald-400">Enforced at Weigh-in</span>
                  </div>
                  <p class="text-silver/70 font-sans text-xs font-light">No porter or pack animal is ever overloaded. Weigh scales at basecamp verify all packs before trail departure.</p>
                </div>

                <div class="p-3.5 rounded-xl border border-white/10 bg-white/[0.02]">
                  <div class="flex items-center justify-between text-white font-bold mb-1">
                    <span>Equal Thermal Accommodations</span>
                    <span class="text-emerald-400">Identical Standard</span>
                  </div>
                  <p class="text-silver/70 font-sans text-xs font-light">Staff sleep in identical 4-season geodesic tents with high-loft thermal mats and sub-zero rated sleeping bags.</p>
                </div>

                <div class="p-3.5 rounded-xl border border-white/10 bg-white/[0.02]">
                  <div class="flex items-center justify-between text-white font-bold mb-1">
                    <span>Fair Living Wage & Insurance</span>
                    <span class="text-emerald-400">+20% Industry Index</span>
                  </div>
                  <p class="text-silver/70 font-sans text-xs font-light">Direct wage distribution exceeding government minimums, full emergency evacuation coverage, and community profit reinvestment.</p>
                </div>
              </div>
            </div>

            <div class="mt-8 pt-4 border-t border-white/10 text-xs font-mono text-silver/70 flex items-center justify-between">
              <span>Fair Trail Coalition Standards</span>
              <span class="text-[#00f2fe] font-bold">100% Native Pahadi Team</span>
            </div>
          </div>
        </div>

      </div>
    </section>

  </main>

