---
import Layout from '../layouts/Layout.astro';
import GlassNav from '../components/GlassNav.astro';
import TrekCard from '../components/TrekCard.astro';
import TrekMap from '../components/TrekMap.astro';
import ThreeDPeakViewer from '../components/ThreeDPeakViewer.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import FitnessQuiz from '../components/FitnessQuiz.astro';
import GearChecklist from '../components/GearChecklist.astro';
import TrekComparator from '../components/TrekComparator.astro';
import AudioSoundscape from '../components/AudioSoundscape.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Footer from '../components/Footer.astro';
import { mockTreks } from '../data/mock-treks';

const featuredTreks = mockTreks.filter((t) => t.isFeatured);
---

<Layout title="Dream of The Holy Himalayas | Premier 3D Interactive Himalayan Trekking Portal">
  <!-- Schema.org TouristInformationCenter + LocalBusiness Markup -->
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "TouristInformationCenter",
      "name": "Dream of The Holy Himalayas",
      "image": "https://images.unsplash.com/photo-1542228262-3d663b306a53?q=80&w=2071&auto=format&fit=crop",
      "@id": "https://www.dreamoftheholyhimalayas.com",
      "url": "https://www.dreamoftheholyhimalayas.com",
      "telephone": "+919876543210",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Village Mautar",
        "addressLocality": "Uttarkashi",
        "addressRegion": "Uttarakhand",
        "postalCode": "249128", 
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 30.7268,
        "longitude": 78.4354 
      },
      "description": "Premium, small-batch Himalayan trekking agency based in Mautar, Uttarakhand. Led by 100% NIM & WFR certified local guides.",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5.0",
        "reviewCount": "40"
      }
    }
  </script>

  <GlassNav />

  <main class="bg-slate-950 text-ink font-body">
    <!-- Alpine Glass Hero Section -->
    <section class="relative min-h-[90vh] w-full flex items-center justify-center overflow-hidden py-24">
      <!-- High-res Himalayan Photo -->
      <div class="absolute inset-0 bg-slate-900 bg-[url('https://images.unsplash.com/photo-1542228262-3d663b306a53?q=80&w=2071&auto=format&fit=crop')] bg-cover bg-center"></div>

      <!-- WCAG Contrast Scrim Layer -->
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950/75 via-black/55 to-slate-950"></div>

      <!-- Glass Hero Panel -->
      <div class="relative z-10 p-8 md:p-12 text-center max-w-4xl mx-auto backdrop-blur-md backdrop-saturate-150 bg-white/10 border border-white/20 rounded-3xl shadow-2xl @supports-not-(backdrop-filter:blur(1px)):bg-slate-900/90">
        <div class="inline-flex items-center gap-2 rounded-full border border-cyan-400/40 bg-cyan-500/10 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-cyan-300 mb-4">
          ★ 5.0 Rated Local Himalayan Expedition Agency • Mautar, Uttarakhand
        </div>
        <h1 class="text-4xl md:text-6xl font-display font-bold text-white mb-4 leading-tight">
          Trek with the Locals, <br class="hidden sm:inline" />Not the Crowds.
        </h1>
        <p class="text-lg md:text-xl text-slate-200 font-body mb-8 max-w-2xl mx-auto">
          Intimate, small-batch expeditions (max 12–15 trekkers) across Garhwal & Himachal, led exclusively by NIM & WFR certified local mountaineers.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href="/treks" class="bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold py-3.5 px-8 rounded-full transition-all hover:scale-105 shadow-lg shadow-cyan-400/20">
            Explore 10 Expeditions →
          </a>
          <a href="#three-d-peak" class="border border-white/30 bg-white/10 hover:bg-white/20 text-white font-semibold py-3.5 px-8 rounded-full backdrop-blur-md transition-all hover:scale-105 flex items-center gap-2">
            3D Peak Viewport 🏔️
          </a>
        </div>
      </div>
    </section>

    <!-- Trust Bar: Competitor Counter-Positioning -->
    <section class="bg-slate-950 border-y border-white/10 py-6">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          <div class="p-3 rounded-xl bg-slate-900/40 border border-slate-800">
            <span class="block text-xl mb-1">👥</span>
            <strong class="block text-xs font-bold text-slate-200">Max 12–15 Trekkers</strong>
            <span class="text-[11px] text-slate-400">Never 25+ crowded herds</span>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/40 border border-slate-800">
            <span class="block text-xl mb-1">🏔️</span>
            <strong class="block text-xs font-bold text-slate-200">100% NIM Certified</strong>
            <span class="text-[11px] text-slate-400">Local Mautar mountaineers</span>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/40 border border-slate-800">
            <span class="block text-xl mb-1">🌦️</span>
            <strong class="block text-xs font-bold text-slate-200">Zero-Penalty Reschedule</strong>
            <span class="text-[11px] text-slate-400">100% weather guarantee</span>
          </div>
          <div class="p-3 rounded-xl bg-slate-900/40 border border-slate-800">
            <span class="block text-xl mb-1">🎒</span>
            <strong class="block text-xs font-bold text-slate-200">All-Inclusive Transparent</strong>
            <span class="text-[11px] text-slate-400">No hidden gear rental fees</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 3D Himalayan Peak Viewport Section -->
    <section id="three-d-peak" class="py-16 bg-slate-950">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="text-center mb-8">
          <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider">Next-Gen WebGL Graphics</span>
          <h2 class="text-3xl md:text-4xl font-display font-bold text-white mt-1">3D Himalayan Terrain & Peak Explorer</h2>
          <p class="text-sm text-slate-400 mt-2 max-w-xl mx-auto">Rotate, zoom, and inspect Himalayan summits in real 3D. Switch lighting themes and test snowfall particles!</p>
        </div>

        <ThreeDPeakViewer />
      </div>
    </section>

    <!-- Interactive Weather Telemetry Section -->
    <section class="py-16 bg-slate-950/80 border-t border-slate-900">
      <div class="container mx-auto px-4 max-w-6xl">
        <WeatherWidget />
      </div>
    </section>

    <!-- Interactive Map Section -->
    <section id="interactive-map" class="py-16 bg-slate-950 border-t border-white/5">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="text-center mb-8">
          <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider">Vector Map Engine</span>
          <h2 class="text-3xl md:text-4xl font-display font-bold text-white mt-1">Interactive Himalayan Trek Radar</h2>
          <p class="text-sm text-slate-400 mt-2 max-w-xl mx-auto">MapLibre v5 vector tiles with region filters, clustering, and altitude popups.</p>
        </div>

        <TrekMap />
      </div>
    </section>

    <!-- Expedition Comparison Matrix Section -->
    <section class="py-16 bg-slate-950 border-t border-slate-900">
      <div class="container mx-auto px-4 max-w-6xl">
        <TrekComparator />
      </div>
    </section>

    <!-- Interactive Fitness Quiz & Gear Checklist Grid -->
    <section class="py-16 bg-slate-950 border-t border-slate-900">
      <div class="container mx-auto px-4 max-w-6xl space-y-12">
        <FitnessQuiz />
        <GearChecklist />
      </div>
    </section>

    <!-- Featured Treks Section -->
    <section class="py-20 bg-slate-950 border-t border-white/5">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="flex justify-between items-end mb-10">
          <div>
            <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider">Handpicked Expeditions</span>
            <h2 class="text-3xl md:text-4xl font-display font-bold text-white mt-1">Featured Treks</h2>
          </div>
          <a href="/treks" class="text-cyan-400 hover:text-cyan-300 font-semibold hidden md:block">View All Treks ({mockTreks.length}) →</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {featuredTreks.map((trek) => (
            <TrekCard trek={trek} />
          ))}
        </div>
        
        <div class="mt-10 text-center md:hidden">
          <a href="/treks" class="inline-block border border-cyan-400 text-cyan-400 hover:bg-cyan-400 hover:text-slate-950 font-bold py-3 px-6 rounded-full transition-all">
            View All Treks ({mockTreks.length}) →
          </a>
        </div>
      </div>
    </section>
  </main>

  <AudioSoundscape />
  <WhatsAppFab />
  <Footer />
</Layout>
