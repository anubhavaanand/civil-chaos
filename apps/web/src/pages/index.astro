---
import Layout from '../layouts/Layout.astro';
import GlassNav from '../components/GlassNav.astro';
import TrekCard from '../components/TrekCard.astro';
import FieldNotes from '../components/FieldNotes.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import StatsStrip from '../components/StatsStrip.astro';
import BookingSteps from '../components/BookingSteps.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import Footer from '../components/Footer.astro';
import FitnessQuiz from '../components/FitnessQuiz.astro';
import { getTreks } from '../lib/strapi';
import { actions } from 'astro:actions';
import { SITE_CONFIG } from '../config/site';

const treks = await getTreks();

// Gather upcoming fixed departures across all treks
const allBatches = treks
  .flatMap((trek) =>
    trek.batches.map((batch) => ({
      ...batch,
      trekName: trek.name,
      trekSlug: trek.slug,
      region: trek.region,
      durationDays: trek.durationDays,
      maxAltitudeM: trek.maxAltitudeM,
    }))
  )
  .sort((a, b) => new Date(a.startDate).getTime() - new Date(b.startDate).getTime())
  .slice(0, 10);

const formatDate = (dateStr: string) => {
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
};

const isLowSeatsCheck = (seats: number) => seats > 0 && seats < 5;

const sortedTreks = [...treks].sort((a, b) => a.name.localeCompare(b.name));
const trekRegions = [...new Set(sortedTreks.map((t) => t.region))].sort();

const homepageFaqs = [
  {
    question: 'What happens if weather closes the route?',
    answer: "If unpassable weather closes a route, you reschedule to any future departure with zero penalty. Weather is the mountain's decision, never a charge on yours.",
  },
  {
    question: 'What is the difference between Basecamp and With Transit packages?',
    answer: 'Every trek is seeded in Strapi with two transparent package tiers: our Basecamp Tier (report directly at the base village like Joshimath, Sankri, or Manali) and our With Transit Tier (includes round-trip SUV/Tempo pickup & drop from Rishikesh, Dehradun, or Kathgodam).',
  },
  {
    question: 'Who leads the expeditions?',
    answer: 'Every expedition leader is a native of Mautar trained at the Nehru Institute of Mountaineering (NIM) and holds international Wilderness First Responder (WFR) certification.',
  },
  {
    question: 'How large is each batch?',
    answer: 'Batches are strictly capped at 12–15 trekkers to preserve trail intimacy, safety ratios, and the environmental sanctity of the routes.',
  },
  {
    question: 'How is acclimatization and medical safety handled on the trail?',
    answer: 'We carry medical-grade oxygen canisters and pulse oximeters, with twice-daily acclimatization audits and evacuation protocols coordinated with regional mountain stations.',
  },
  {
    question: 'How do I reserve my seat?',
    answer: 'Select any trek package or departure batch below to log your request in our Strapi CRM and launch a pre-filled WhatsApp confirmation directly with our Mautar basecamp.',
  },
];
---

<Layout
  title="Dream of The Holy Himalayas | Small-Batch Uttarakhand & Himachal Trekking"
  description="Small-batch Himalayan trekking from Village Mautar, Uttarkashi. Ten alpine routes, 100% NIM and WFR certified native guides, transparent Strapi-managed packages, and zero weather penalties."
>
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': ['Organization', 'LocalBusiness', 'TouristInformationCenter'],
      name: SITE_CONFIG.name,
      image: '/images/hero-himalayas.jpg',
      '@id': SITE_CONFIG.canonicalUrl,
      url: SITE_CONFIG.canonicalUrl,
      telephone: SITE_CONFIG.phoneTel,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Village Mautar',
        addressLocality: 'Uttarkashi',
        addressRegion: 'Uttarakhand',
        postalCode: '249128',
        addressCountry: 'IN',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: SITE_CONFIG.coordinates.lat,
        longitude: SITE_CONFIG.coordinates.lng,
      },
      description:
        'Boutique, small-batch Himalayan trekking agency based in Mautar, Uttarakhand. Led by 100% NIM and WFR certified local guides.',
    })}
  />

  <link rel="preload" as="image" href="/images/hero-himalayas.jpg" fetchpriority="high" slot="head" />

  <GlassNav />

  <main class="bg-[#050505] text-[#cbd5e1] font-body antialiased overflow-x-hidden w-full selection:bg-[#00F2FE] selection:text-[#050505]">
    <!-- 1. Asymmetric Editorial Hero + Instant Expedition Discovery Console -->
    <section class="relative min-h-[100dvh] flex items-center pt-28 pb-20 overflow-hidden bg-[#050505] border-b border-white/10">
      <div class="absolute inset-0 z-0">
        <img
          src="/images/hero-himalayas.jpg"
          alt="Garhwal Himalayan snow peaks at golden sunrise with expedition camp"
          class="w-full h-full object-cover object-center"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#050505]/95 via-[#050505]/80 to-[#050505]/45"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-transparent to-[#050505]/60"></div>
        <div class="absolute inset-0 bg-grid opacity-50"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-6 w-full">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <!-- Left 7/12: Editorial Headline & Value Prop -->
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-3 px-4 py-1.5 rounded-full bg-[#050505]/85 border border-[#00F2FE]/40 text-[#00F2FE] text-xs font-mono font-bold tracking-widest uppercase backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-[#00F2FE] ping-ring"></span>
              Village Mautar Basecamp &middot; 1,950m MSL
            </div>

            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-display font-extrabold tracking-tight text-white leading-[1.06]">
              Sacred Peaks. Intimate Expeditions.
              <span class="block text-[#00F2FE] mt-2 text-2xl sm:text-4xl font-semibold">
                Led by Native NIM &amp; WFR Certified Guides.
              </span>
            </h1>

            <p class="text-base sm:text-lg text-[#e2e8f0] max-w-2xl leading-relaxed">
              Small-batch Himalayan journeys strictly capped at 12&ndash;15 climbers across Garhwal and Himachal Pradesh. Direct basecamp pricing, zero middlemen, and zero weather rescheduling penalties.
            </p>

            <div class="flex flex-wrap items-center gap-4 pt-2">
              <a
                href="#treks"
                class="btn-tactile inline-flex items-center gap-3 px-7 py-3.5 rounded-xl bg-[#00F2FE] hover:bg-[#00b4d8] text-[#050505] font-bold text-xs font-mono uppercase tracking-widest shadow-lg transition-all"
              >
                <span>Explore 10 Trek Packages</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <a
                href="#departures"
                class="btn-tactile inline-flex items-center gap-2 px-6 py-3.5 rounded-xl border border-white/25 bg-[#050505]/80 hover:border-[#00F2FE] text-white font-bold text-xs font-mono uppercase tracking-widest backdrop-blur-md transition-all"
              >
                <span>2027 Batch Calendar</span>
              </a>
            </div>

            <!-- Trust Trio -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 max-w-2xl">
              <div class="p-3.5 rounded-xl bg-[#0B111E]/90 backdrop-blur-md border border-white/15">
                <div class="text-[10px] font-mono text-[#00F2FE] uppercase tracking-wider">Leadership</div>
                <div class="text-sm font-bold text-white mt-0.5">100% NIM &amp; WFR Certified</div>
              </div>
              <div class="p-3.5 rounded-xl bg-[#0B111E]/90 backdrop-blur-md border border-white/15">
                <div class="text-[10px] font-mono text-[#34D399] uppercase tracking-wider">Small Batches</div>
                <div class="text-sm font-bold text-white mt-0.5">Max 12&ndash;15 Climbers</div>
              </div>
              <div class="p-3.5 rounded-xl bg-[#0B111E]/90 backdrop-blur-md border border-white/15">
                <div class="text-[10px] font-mono text-[#FBBF24] uppercase tracking-wider">Weather Guarantee</div>
                <div class="text-sm font-bold text-white mt-0.5">Zero Reschedule Fee</div>
              </div>
            </div>
          </div>

          <!-- Right 5/12: Quick Expedition Finder Card -->
          <div class="lg:col-span-5">
            <div class="double-bezel-outer">
              <div class="double-bezel-inner p-6 sm:p-7 bg-[#0B111E]/95 border border-white/15 space-y-5">
                <div class="flex items-center justify-between border-b border-white/10 pb-4">
                  <div>
                    <span class="text-[10px] font-mono uppercase tracking-widest text-[#00F2FE] font-bold">Instant Route Finder</span>
                    <h2 class="font-display text-xl font-bold text-white mt-0.5">Filter 2026&ndash;27 Expeditions</h2>
                  </div>
                  <span class="px-2.5 py-1 rounded-md bg-[#00F2FE]/15 border border-[#00F2FE]/30 font-mono text-xs font-bold text-[#00F2FE]">
                    {treks.length} Routes
                  </span>
                </div>

                <div class="space-y-3 text-xs font-mono">
                  <div>
                    <label for="hero-search" class="block text-[#94A3B8] uppercase mb-1">Search Trek or Basecamp</label>
                    <input
                      id="hero-search"
                      type="search"
                      placeholder="e.g. Kuari Pass, Kedarkantha, Sankri, Manali..."
                      class="w-full rounded-xl border border-white/20 bg-[#05080F] px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-[#00F2FE] focus:outline-none font-body"
                    />
                  </div>

                  <div class="grid grid-cols-2 gap-3">
                    <div>
                      <label for="hero-region" class="block text-[#94A3B8] uppercase mb-1">Region</label>
                      <select
                        id="hero-region"
                        class="w-full rounded-xl border border-white/20 bg-[#05080F] px-3 py-2.5 text-xs text-white focus:border-[#00F2FE] focus:outline-none cursor-pointer"
                      >
                        <option value="all">All Regions</option>
                        {trekRegions.map((r) => (
                          <option value={r}>{r}</option>
                        ))}
                      </select>
                    </div>
                    <div>
                      <label for="hero-difficulty" class="block text-[#94A3B8] uppercase mb-1">Difficulty Grade</label>
                      <select
                        id="hero-difficulty"
                        class="w-full rounded-xl border border-white/20 bg-[#05080F] px-3 py-2.5 text-xs text-white focus:border-[#00F2FE] focus:outline-none cursor-pointer"
                      >
                        <option value="all">All Grades</option>
                        <option value="easy">Easy (Beginner)</option>
                        <option value="moderate">Moderate</option>
                        <option value="difficult">Difficult (Pass)</option>
                      </select>
                    </div>
                  </div>
                </div>

                <div>
                  <span class="block text-[10px] font-mono uppercase tracking-wider text-[#94A3B8] mb-2">
                    Popular Direct Routes:
                  </span>
                  <div class="flex flex-wrap gap-1.5">
                    {treks.slice(0, 5).map((t) => (
                      <a
                        href={`/treks/${t.slug}`}
                        class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-[#00F2FE] hover:text-[#050505] border border-white/10 text-xs font-mono text-[#e2e8f0] transition-colors"
                      >
                        {t.name.replace(' Trek', '')} &middot; ₹{t.fromPrice.toLocaleString('en-IN')}
                      </a>
                    ))}
                  </div>
                </div>

                <a
                  href="#treks"
                  id="hero-filter-btn"
                  class="btn-tactile w-full flex items-center justify-center gap-2 py-3.5 rounded-xl bg-[#00F2FE] hover:bg-[#00b4d8] text-[#050505] font-mono text-xs font-bold uppercase tracking-widest transition-all"
                >
                  <span>View Matching Trek Packages</span>
                  <span aria-hidden="true">&darr;</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <StatsStrip />

    <!-- 2. All 10 Trek Packages Grid (Filterable by Region, Difficulty, and Search) -->
    <section id="treks" class="py-24 px-6 max-w-7xl mx-auto bg-[#050505]">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="h-[2px] w-8 bg-[#00F2FE]"></span>
            <span class="text-[#00F2FE] font-mono text-xs tracking-widest uppercase font-bold">Strapi-Managed Expedition Catalog</span>
          </div>
          <h2 class="text-3xl sm:text-5xl font-display font-bold text-white tracking-tight">
            Himalayan Trek Packages
          </h2>
          <p class="text-[#94A3B8] mt-2 max-w-2xl text-sm sm:text-base">
            Every trek includes two transparent package options: Basecamp-to-Basecamp or With Round-Trip Transit from Rishikesh, Dehradun, Manali, or Kathgodam.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2" id="trekFilterChips">
          <button
            type="button"
            data-region="all"
            class="filter-chip px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase tracking-wider bg-[#00F2FE] text-[#050505] transition-all cursor-pointer"
          >
            All ({treks.length})
          </button>
          {trekRegions.map((region) => (
            <button
              type="button"
              data-region={region}
              class="filter-chip px-4 py-2 rounded-xl text-xs font-mono font-semibold uppercase tracking-wider bg-[#0B111E] border border-white/15 text-[#cbd5e1] hover:border-[#00F2FE] hover:text-white transition-all cursor-pointer"
            >
              {region}
            </button>
          ))}
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7" id="trekGridContainer">
        {treks.map((trek) => (
          <div
            class="trek-card-wrapper"
            data-region={trek.region}
            data-difficulty={trek.difficulty}
            data-search={`${trek.name} ${trek.startPoint} ${trek.region} ${trek.summary}`.toLowerCase()}
          >
            <TrekCard trek={trek} />
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Interactive SVG Camp-to-Camp Route & Elevation Explorer (60fps, Zero Map Tile Lag) -->
    <section id="route-visualizer" class="py-24 px-6 max-w-7xl mx-auto border-t border-white/10 bg-[#050505]">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-10 gap-6">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="h-[2px] w-8 bg-[#00F2FE]"></span>
            <span class="text-[#00F2FE] font-mono text-xs tracking-widest uppercase font-bold">Camp-by-Camp Ascent Telemetry</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-display font-bold text-white tracking-tight">
            Interactive Trail &amp; Altitude Progression
          </h2>
          <p class="text-[#94A3B8] mt-2 max-w-2xl text-sm">
            Select any expedition below to inspect its camp-by-camp elevation profile, daily trekking distance, and package tiers.
          </p>
        </div>
      </div>

      <!-- Trek Selector Pills for Elevation Visualizer -->
      <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-6" id="elev-selector-pills">
        {treks.map((t, idx) => (
          <button
            type="button"
            data-elev-trek={t.slug}
            class={`elev-pill shrink-0 px-4 py-2 rounded-xl font-mono text-xs font-bold transition cursor-pointer ${
              idx === 0
                ? 'bg-[#00F2FE] text-[#050505]'
                : 'bg-[#0B111E] text-[#cbd5e1] border border-white/15 hover:border-[#00F2FE]'
            }`}
          >
            {t.name.replace(' Trek', '')} ({t.maxAltitudeM}m)
          </button>
        ))}
      </div>

      <!-- Panels per Trek -->
      {treks.map((t, idx) => (
        <div
          data-elev-panel={t.slug}
          class={`elev-panel rounded-2xl border border-white/15 bg-[#0B111E]/90 p-6 sm:p-8 shadow-2xl ${idx === 0 ? 'block' : 'hidden'}`}
        >
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-7 space-y-4">
              <div class="flex flex-wrap items-center justify-between gap-2 border-b border-white/10 pb-4">
                <div>
                  <span class="text-xs font-mono uppercase text-[#00F2FE] font-bold">{t.region} Himalayas &middot; {t.startPoint}</span>
                  <h3 class="text-2xl font-display font-bold text-white">{t.name}</h3>
                </div>
                <span class="px-3 py-1 rounded-lg bg-[#05080F] border border-white/15 font-mono text-xs text-[#00F2FE] font-bold">
                  Summit: {t.maxAltitudeM.toLocaleString('en-IN')} m / {Math.round(t.maxAltitudeM * 3.28084).toLocaleString('en-IN')} ft
                </span>
              </div>

              <!-- Camp Progression Stepper -->
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2">
                {(t.altitudeProfile.length > 0 ? t.altitudeProfile : t.itinerary.map((d) => ({ distanceKm: d.distanceKm, altitudeM: d.altitudeM, label: d.title }))).map((pt, i) => (
                  <div class="p-3 rounded-xl bg-[#05080F] border border-white/10">
                    <div class="flex items-center justify-between text-[10px] font-mono text-[#94A3B8]">
                      <span>STAGE 0{i + 1}</span>
                      <span>{pt.distanceKm} km</span>
                    </div>
                    <div class="font-display font-bold text-sm text-white truncate mt-1" title={pt.label}>{pt.label}</div>
                    <div class="font-mono text-xs font-bold text-[#00F2FE] mt-0.5">{pt.altitudeM.toLocaleString('en-IN')} m</div>
                  </div>
                ))}
              </div>
            </div>

            <div class="lg:col-span-5 space-y-4 rounded-xl bg-[#05080F] border border-white/15 p-5">
              <div class="text-xs font-mono uppercase tracking-wider text-[#94A3B8]">
                Strapi Package Tiers for {t.name}
              </div>
              <div class="space-y-2.5">
                {t.packages.map((pkg) => (
                  <div class="p-3.5 rounded-xl bg-[#0B111E] border border-white/10 flex items-center justify-between gap-3">
                    <div>
                      <div class="font-display font-bold text-sm text-white">{pkg.name}</div>
                      <div class="text-xs text-[#94A3B8] mt-0.5">{pkg.description}</div>
                    </div>
                    <div class="font-mono text-base font-bold text-[#00F2FE] shrink-0">
                      ₹{pkg.priceINR.toLocaleString('en-IN')}
                    </div>
                  </div>
                ))}
              </div>
              <div class="pt-2 flex items-center justify-between gap-3">
                <a
                  href={`/treks/${t.slug}`}
                  class="btn-tactile w-full text-center py-3 rounded-xl bg-[#00F2FE] hover:bg-[#00b4d8] text-[#050505] font-mono text-xs font-bold uppercase tracking-wider"
                >
                  Open Full Day-by-Day Itinerary &amp; Batches &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- 4. 2027 Fixed Departures Schedule -->
    <section id="departures" class="py-24 px-6 max-w-7xl mx-auto border-t border-white/10 bg-[#050505]">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-6">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="h-[2px] w-8 bg-[#00F2FE]"></span>
            <span class="text-[#00F2FE] font-mono text-xs tracking-widest uppercase font-bold">Confirmed Small-Batch Calendar</span>
          </div>
          <h2 class="text-3xl sm:text-5xl font-display font-bold text-white tracking-tight">
            Upcoming Fixed Departures
          </h2>
          <p class="text-[#94A3B8] mt-2 max-w-xl text-sm sm:text-base">
            Every batch is capped at 12&ndash;15 trekkers. Reserve directly via WhatsApp or inspect the trek page for package upgrades.
          </p>
        </div>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-white/15 bg-[#0B111E]/95 shadow-2xl">
        <table class="w-full text-left text-sm text-[#cbd5e1] border-collapse">
          <thead class="bg-[#050505] text-xs uppercase tracking-wider text-[#00F2FE] border-b border-white/15 font-mono">
            <tr>
              <th class="py-4 px-6 font-semibold">Trek Expedition</th>
              <th class="py-4 px-6 font-semibold">Departure Window</th>
              <th class="py-4 px-6 font-semibold">Region &amp; Altitude</th>
              <th class="py-4 px-6 font-semibold">Seat Status</th>
              <th class="py-4 px-6 font-semibold">Base Price</th>
              <th class="py-4 px-6 font-semibold text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10 font-mono text-xs sm:text-sm">
            {allBatches.map((batch) => {
              const seatsLeft = batch.seatsTotal - batch.seatsBooked;
              const isFull = batch.status === 'full' || seatsLeft === 0;
              const isLowSeats = isLowSeatsCheck(seatsLeft);
              return (
                <tr class="hover:bg-white/5 transition-colors">
                  <td class="py-4 px-6 font-bold text-white font-display text-base">
                    <a href={`/treks/${batch.trekSlug}`} class="hover:text-[#00F2FE] transition-colors">
                      {batch.trekName}
                    </a>
                  </td>
                  <td class="py-4 px-6 text-[#e2e8f0]">
                    {formatDate(batch.startDate)} &ndash; {formatDate(batch.endDate)}
                  </td>
                  <td class="py-4 px-6 text-[#94A3B8]">
                    <div class="text-white font-semibold">{batch.region}</div>
                    <div class="text-xs">{batch.durationDays} Days &middot; {batch.maxAltitudeM}m</div>
                  </td>
                  <td class="py-4 px-6">
                    {isFull ? (
                      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-[#FB7185]/15 text-[#FB7185] border border-[#FB7185]/30">
                        Full
                      </span>
                    ) : isLowSeats ? (
                      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-[#FBBF24]/15 text-[#FBBF24] border border-[#FBBF24]/30">
                        Only {seatsLeft} seats left
                      </span>
                    ) : (
                      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-[#34D399]/15 text-[#34D399] border border-[#34D399]/30">
                        Available ({seatsLeft} seats)
                      </span>
                    )}
                  </td>
                  <td class="py-4 px-6 font-bold text-[#00F2FE] text-base">
                    ₹{batch.pricePerPersonINR.toLocaleString('en-IN')}
                  </td>
                  <td class="py-4 px-6 text-right">
                    {isFull ? (
                      <span class="text-xs text-[#94A3B8]/50 font-semibold px-3 py-1.5">Sold Out</span>
                    ) : (
                      <a
                        href={`/treks/${batch.trekSlug}#batches`}
                        class="btn-tactile inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#00F2FE] hover:bg-[#00b4d8] text-[#050505] font-bold text-xs uppercase tracking-wider transition-all"
                      >
                        <span>Reserve</span>
                        <span aria-hidden="true">&rarr;</span>
                      </a>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <FieldNotes />

    <!-- 5. High-Altitude Readiness Self-Assessment -->
    <section id="readiness" class="py-24 px-6 max-w-5xl mx-auto border-t border-white/10 bg-[#050505]">
      <FitnessQuiz />
    </section>

    <!-- 6. Direct Basecamp Booking & Custom Group Inquiry -->
    <section id="booking" class="py-24 px-6 max-w-4xl mx-auto border-t border-white/10 bg-[#050505]">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-white tracking-tight">
          Reserve Your Himalayan Expedition
        </h2>
        <p class="text-[#94A3B8] mt-3 text-base leading-relaxed max-w-xl mx-auto">
          Select your trek and package tier below. Your request is logged in our Strapi CRM and opens a pre-filled WhatsApp confirmation with our Mautar team.
        </p>
      </div>

      <BookingSteps />

      <div class="p-8 sm:p-10 rounded-2xl bg-[#0B111E] border border-white/15 shadow-2xl">
        <form id="waBookingForm" method="POST" action={actions.booking} class="space-y-5">
          <div class="hidden" aria-hidden="true">
            <input type="text" name="company" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" id="formTrekSlug" name="trekSlug" value={treks[0]?.slug || 'kuari-pass'} />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="formName" class="block text-xs font-mono font-bold text-[#cbd5e1] uppercase tracking-wider mb-2">
                Your Full Name *
              </label>
              <input
                type="text"
                id="formName"
                name="customerName"
                required
                placeholder="Anubhav Anand"
                class="w-full px-4 py-3 rounded-xl bg-[#05080F] border border-white/20 text-white placeholder-slate-500 focus:outline-none focus:border-[#00F2FE] text-sm"
              />
            </div>
            <div>
              <label for="formMobile" class="block text-xs font-mono font-bold text-[#cbd5e1] uppercase tracking-wider mb-2">
                10-Digit Indian Mobile *
              </label>
              <input
                type="tel"
                id="formMobile"
                name="phone"
                required
                pattern="^[6-9]\d{9}$"
                placeholder="9876543210"
                class="w-full px-4 py-3 rounded-xl bg-[#05080F] border border-white/20 text-white placeholder-slate-500 focus:outline-none focus:border-[#00F2FE] text-sm font-mono"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="formTrek" class="block text-xs font-mono font-bold text-[#cbd5e1] uppercase tracking-wider mb-2">
                Select Trek Expedition
              </label>
              <select
                id="formTrek"
                name="trekName"
                class="w-full px-4 py-3 rounded-xl bg-[#05080F] border border-white/20 text-white focus:outline-none focus:border-[#00F2FE] text-sm cursor-pointer"
              >
                {treks.map((t) => (
                  <option value={t.name} data-slug={t.slug}>
                    {t.name} ({t.region} &middot; {t.durationDays}D &middot; From ₹{t.fromPrice.toLocaleString('en-IN')})
                  </option>
                ))}
              </select>
            </div>
            <div>
              <label for="formPackage" class="block text-xs font-mono font-bold text-[#cbd5e1] uppercase tracking-wider mb-2">
                Package Tier (Strapi)
              </label>
              <select
                id="formPackage"
                name="packageName"
                class="w-full px-4 py-3 rounded-xl bg-[#05080F] border border-white/20 text-white focus:outline-none focus:border-[#00F2FE] text-sm cursor-pointer"
              >
                <option value="Basecamp to Basecamp Package">Basecamp to Basecamp Package</option>
                <option value="With Round-Trip Transit (Rishikesh / Dehradun / Manali)">With Round-Trip Transit (Rishikesh / Dehradun / Manali)</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="formGroup" class="block text-xs font-mono font-bold text-[#cbd5e1] uppercase tracking-wider mb-2">
                Group Size (Climbers)
              </label>
              <input
                type="number"
                id="formGroup"
                name="groupSize"
                min="1"
                max="15"
                value="2"
                class="w-full px-4 py-3 rounded-xl bg-[#05080F] border border-white/20 text-white focus:outline-none focus:border-[#00F2FE] text-sm font-mono"
              />
            </div>
            <div>
              <label for="formDates" class="block text-xs font-mono font-bold text-[#cbd5e1] uppercase tracking-wider mb-2">
                Preferred Dates or Month
              </label>
              <input
                type="text"
                id="formDates"
                name="preferredDates"
                placeholder="e.g. Nov 2026 or Mid-Dec"
                class="w-full px-4 py-3 rounded-xl bg-[#05080F] border border-white/20 text-white placeholder-slate-500 focus:outline-none focus:border-[#00F2FE] text-sm"
              />
            </div>
          </div>

          <button
            type="submit"
            id="btnGenerateWa"
            data-phone={SITE_CONFIG.phoneRaw}
            class="btn-tactile w-full py-4 rounded-xl bg-[#00F2FE] hover:bg-[#00b4d8] text-[#050505] font-mono font-bold text-sm uppercase tracking-widest transition-all shadow-lg cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Reserve &amp; Open WhatsApp Dispatch</span>
            <span aria-hidden="true">&rarr;</span>
          </button>
        </form>

        <div id="waPreviewBox" class="hidden mt-6 p-5 rounded-xl bg-[#34D399]/15 border border-[#34D399]/40 text-center">
          <p class="text-xs text-[#e2e8f0] mb-3 font-mono">
            Your inquiry is ready! Click below if WhatsApp did not open automatically:
          </p>
          <a
            id="waGeneratedLink"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-[#25D366] hover:bg-[#128C7E] text-[#050505] font-bold text-xs font-mono uppercase tracking-wider transition-all"
          >
            <span>Message Basecamp ({SITE_CONFIG.phoneDisplay})</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 7. Field Briefing FAQ -->
    <section id="faq" aria-label="Frequently asked questions" class="py-24 px-6 max-w-4xl mx-auto border-t border-white/10 bg-[#050505]">
      <div class="text-center mb-12">
        <span class="text-[#00F2FE] font-mono text-xs tracking-widest uppercase font-bold">Field Briefing</span>
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-white tracking-tight mt-2">
          Questions Before The Trailhead
        </h2>
      </div>
      <FAQAccordion items={homepageFaqs} />
    </section>
  </main>

  <WhatsAppFab />
  <Footer />

  <script>
    // 1. Filter Expeditions by Region, Difficulty, and Search
    const filterButtons = document.querySelectorAll('.filter-chip');
    const cardWrappers = document.querySelectorAll('.trek-card-wrapper');
    const heroSearch = document.getElementById('hero-search') as HTMLInputElement | null;
    const heroRegion = document.getElementById('hero-region') as HTMLSelectElement | null;
    const heroDiff = document.getElementById('hero-difficulty') as HTMLSelectElement | null;

    let activeRegion = 'all';
    let activeDiff = 'all';
    let searchQuery = '';

    function applyFilters() {
      cardWrappers.forEach((el) => {
        if (!(el instanceof HTMLElement)) return;
        const r = el.getAttribute('data-region') || '';
        const d = el.getAttribute('data-difficulty') || '';
        const s = el.getAttribute('data-search') || '';
        const matchR = activeRegion === 'all' || r === activeRegion;
        const matchD = activeDiff === 'all' || d === activeDiff;
        const matchS = !searchQuery || s.includes(searchQuery.toLowerCase());
        el.style.display = matchR && matchD && matchS ? 'block' : 'none';
      });
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => {
          b.classList.remove('bg-[#00F2FE]', 'text-[#050505]');
          b.classList.add('bg-[#0B111E]', 'text-[#cbd5e1]', 'border', 'border-white/15');
        });
        btn.classList.add('bg-[#00F2FE]', 'text-[#050505]');
        btn.classList.remove('bg-[#0B111E]', 'text-[#cbd5e1]');
        activeRegion = btn.getAttribute('data-region') || 'all';
        if (heroRegion) heroRegion.value = activeRegion;
        applyFilters();
      });
    });

    heroSearch?.addEventListener('input', () => {
      searchQuery = heroSearch.value.trim();
      applyFilters();
    });
    heroRegion?.addEventListener('change', () => {
      activeRegion = heroRegion.value;
      applyFilters();
    });
    heroDiff?.addEventListener('change', () => {
      activeDiff = heroDiff.value;
      applyFilters();
    });

    // 2. Interactive Trail & Altitude Switcher
    const elevPills = document.querySelectorAll('.elev-pill');
    const elevPanels = document.querySelectorAll('.elev-panel');
    elevPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const slug = pill.getAttribute('data-elev-trek');
        elevPills.forEach((p) => {
          p.classList.remove('bg-[#00F2FE]', 'text-[#050505]');
          p.classList.add('bg-[#0B111E]', 'text-[#cbd5e1]', 'border', 'border-white/15');
        });
        pill.classList.add('bg-[#00F2FE]', 'text-[#050505]');
        pill.classList.remove('bg-[#0B111E]', 'text-[#cbd5e1]');

        elevPanels.forEach((panel) => {
          if (panel.getAttribute('data-elev-panel') === slug) {
            panel.classList.remove('hidden');
            panel.classList.add('block');
          } else {
            panel.classList.add('hidden');
            panel.classList.remove('block');
          }
        });
      });
    });

    // 3. Direct Booking Form Handler
    const waForm = document.getElementById('waBookingForm') as HTMLFormElement | null;
    const formTrek = document.getElementById('formTrek') as HTMLSelectElement | null;
    const formTrekSlug = document.getElementById('formTrekSlug') as HTMLInputElement | null;
    const waPreviewBox = document.getElementById('waPreviewBox');
    const waGeneratedLink = document.getElementById('waGeneratedLink') as HTMLAnchorElement | null;
    const btnGenerateWa = document.getElementById('btnGenerateWa');

    formTrek?.addEventListener('change', () => {
      const selectedOption = formTrek.options[formTrek.selectedIndex];
      const slug = selectedOption?.getAttribute('data-slug') || 'kuari-pass';
      if (formTrekSlug) formTrekSlug.value = slug;
    });

    waForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(waForm);
      const name = (fd.get('customerName') as string) || 'Trekker';
      const phone = (fd.get('phone') as string) || '';
      const trek = (fd.get('trekName') as string) || 'Kuari Pass Trek';
      const pkg = (fd.get('packageName') as string) || 'Basecamp Package';
      const group = (fd.get('groupSize') as string) || '1';
      const dates = (fd.get('preferredDates') as string) || 'Flexible dates';
      const targetPhone = btnGenerateWa?.getAttribute('data-phone') || '919876543210';

      const msg =
        `Namaste Dream of The Holy Himalayas!

` +
        `I would like to reserve a trek:
` +
        `• Trek: ${trek}
` +
        `• Package: ${pkg}
` +
        `• Dates: ${dates}
` +
        `• Group Size: ${group}
` +
        `• Name: ${name}
` +
        `• Mobile: +91 ${phone}`;
      let fullUrl = `https://wa.me/${targetPhone}?text=${encodeURIComponent(msg)}`;

      try {
        const res = await fetch(waForm.action, { method: 'POST', body: fd });
        if (res.ok) {
          const data = await res.json().catch(() => null);
          if (data?.whatsappUrl) fullUrl = data.whatsappUrl;
        }
      } catch {
        // Offline/static fallback
      }

      if (waGeneratedLink && waPreviewBox) {
        waGeneratedLink.href = fullUrl;
        waPreviewBox.classList.remove('hidden');
      }
      window.open(fullUrl, '_blank');
    });
  </script>
</Layout>
