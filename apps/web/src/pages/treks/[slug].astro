---
import Layout from '../../layouts/Layout.astro';
import GlassNav from '../../components/GlassNav.astro';
import WhatsAppFab from '../../components/WhatsAppFab.astro';
import Footer from '../../components/Footer.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import ElevationProfile from '../../components/ElevationProfile.astro';
import ItineraryTimeline from '../../components/ItineraryTimeline.astro';
import UpcomingBatchesTable from '../../components/UpcomingBatchesTable.astro';
import WeatherWidget from '../../components/WeatherWidget.astro';
import GearChecklist from '../../components/GearChecklist.astro';
import BookingModal from '../../components/BookingModal.astro';
import { mockTreks, type Trek } from '../../data/mock-treks';

export function getStaticPaths() {
  return mockTreks.map((trek) => ({
    params: { slug: trek.slug },
    props: { trek },
  }));
}

const { trek } = Astro.props as { trek: Trek };

const difficultyColor = trek.difficulty === 'easy' ? 'bg-emerald-500 text-slate-950' : trek.difficulty === 'moderate' ? 'bg-amber-500 text-slate-950' : 'bg-rose-500 text-white';

// Schema.org TouristTrip + Product / Offer JSON-LD
const touristTripSchema = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": `${trek.name} 2027`,
  "description": trek.description,
  "touristType": ["Trekkers", "Adventurers", "Hikers"],
  "provider": {
    "@type": "TravelAgency",
    "name": "Dream of The Holy Himalayas",
    "url": "https://holyhimalayas.com"
  },
  "itinerary": {
    "@type": "ItemList",
    "itemListElement": trek.itinerary.map((item, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": `Day ${item.day}: ${item.title}`,
      "description": item.description
    }))
  },
  "offers": {
    "@type": "Offer",
    "price": trek.fromPrice,
    "priceCurrency": "INR",
    "availability": "https://schema.org/InStock",
    "validFrom": new Date().toISOString()
  }
};
---

<Layout title={`${trek.name} 2027 | Cost, Itinerary & Batches | Dream of The Holy Himalayas`}>
  <!-- TouristTrip JSON-LD Schema -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(touristTripSchema)} />

  <GlassNav />

  <main class="bg-slate-950 text-ink pb-20">
    <!-- Hero Section -->
    <section class="relative h-[65vh] min-h-[500px] w-full flex items-end pb-12">
      <div class="absolute inset-0 bg-slate-900">
        <img src={trek.heroImage} alt={`View from ${trek.name}`} class="w-full h-full object-cover" />
      </div>

      <!-- Scrim Layer -->
      <div class="absolute inset-0 bg-black/40"></div>

      <!-- Glass Hero Panel -->
      <div class="container mx-auto px-4 relative z-10 max-w-5xl">
        <div class="backdrop-blur-md backdrop-saturate-150 bg-white/10 border border-white/20 rounded-3xl p-6 md:p-10 max-w-3xl @supports-not-(backdrop-filter:blur(1px)):bg-slate-900/90 shadow-2xl">
          <div class="flex items-center gap-3 mb-4">
            <span class={`text-xs font-bold uppercase tracking-wider py-1 px-3 rounded-full ${difficultyColor}`}>
              {trek.difficulty}
            </span>
            <span class="text-ink text-sm font-medium">📍 {trek.region} Himalayas</span>
            <span class="text-ink-dim text-sm font-medium">· Base: {trek.startPoint}</span>
          </div>

          <h1 class="text-4xl md:text-5xl font-display font-bold text-white mb-6">
            {trek.name}
          </h1>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-white/15 text-white/90">
            <div>
              <p class="text-xs text-ink-dim uppercase tracking-wider mb-1">Duration</p>
              <p class="font-bold text-lg">{trek.durationDays} Days</p>
            </div>
            <div>
              <p class="text-xs text-ink-dim uppercase tracking-wider mb-1">Max Altitude</p>
              <p class="font-bold text-lg">{trek.maxAltitudeM.toLocaleString()} m</p>
            </div>
            <div>
              <p class="text-xs text-ink-dim uppercase tracking-wider mb-1">Trek Distance</p>
              <p class="font-bold text-lg">{trek.trekDistanceKm} km</p>
            </div>
            <div>
              <p class="text-xs text-ink-dim uppercase tracking-wider mb-1">Starting Price</p>
              <p class="font-bold text-lg text-brand" data-price-inr={trek.fromPrice}>₹{trek.fromPrice.toLocaleString('en-IN')}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content Container -->
    <div class="container mx-auto px-4 max-w-6xl mt-12 grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Left Column (Details, Profile, Itinerary, Inclusions) -->
      <div class="lg:col-span-2 space-y-14">
        <!-- Summary Section -->
        <section class="space-y-4">
          <h2 class="text-2xl font-display font-bold text-white">Overview</h2>
          <p class="text-base text-ink leading-relaxed">{trek.description}</p>
          
          <div class="flex flex-wrap gap-2 pt-2">
            <span class="text-xs font-semibold text-ink-dim">Best Seasons:</span>
            {trek.bestSeasons.map((season) => (
              <span class="rounded-md bg-white/10 px-2.5 py-1 text-xs text-white border border-white/10">{season}</span>
            ))}
          </div>
        </section>

        <!-- Elevation Profile Section -->
        <section>
          <ElevationProfile points={trek.altitudeProfile} maxAltitudeM={trek.maxAltitudeM} />
        </section>

        <!-- Altitude Weather Telemetry Widget -->
        <section>
          <WeatherWidget />
        </section>

        <!-- Fixed Departure Batches Table -->
        <section class="space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-2xl font-display font-bold text-white">Upcoming Departures & Batches</h2>
            <span class="text-xs text-brand font-semibold">Instant WhatsApp Confirmation</span>
          </div>
          <UpcomingBatchesTable batches={trek.batches} trekName={trek.name} trekSlug={trek.slug} />
        </section>

        <!-- Day-by-Day Itinerary -->
        <section class="space-y-4">
          <h2 class="text-2xl font-display font-bold text-white">Day-by-Day Detailed Itinerary</h2>
          <ItineraryTimeline days={trek.itinerary} />
        </section>

        <!-- Interactive Gear Packing & Weight Estimator -->
        <section>
          <GearChecklist />
        </section>

        <!-- Inclusions & Exclusions -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="rounded-2xl border border-emerald-500/20 bg-emerald-500/5 p-6 space-y-3">
            <h3 class="font-display text-lg font-bold text-emerald-400 flex items-center gap-2">
              <span>✓</span> What's Included
            </h3>
            <ul class="space-y-2 text-sm text-ink">
              {trek.inclusions.map((inc) => (
                <li class="flex items-start gap-2">
                  <span class="text-emerald-400 font-bold">•</span>
                  <span>{inc}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="rounded-2xl border border-rose-500/20 bg-rose-500/5 p-6 space-y-3">
            <h3 class="font-display text-lg font-bold text-rose-400 flex items-center gap-2">
              <span>✕</span> What's Excluded
            </h3>
            <ul class="space-y-2 text-sm text-ink">
              {trek.exclusions.map((exc) => (
                <li class="flex items-start gap-2">
                  <span class="text-rose-400 font-bold">•</span>
                  <span>{exc}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <!-- How to Reach -->
        <section class="space-y-4 rounded-2xl border border-white/10 bg-slate-900/60 p-6">
          <h2 class="text-2xl font-display font-bold text-white">How to Reach {trek.startPoint}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
            <div>
              <p class="font-semibold text-brand">✈️ Nearest Airport</p>
              <p class="text-ink-dim">{trek.howToReach.nearestAirport}</p>
            </div>
            <div>
              <p class="font-semibold text-brand">🚆 Nearest Railway Station</p>
              <p class="text-ink-dim">{trek.howToReach.nearestRailway}</p>
            </div>
          </div>
          <p class="text-sm text-ink pt-2">{trek.howToReach.commuteDetails}</p>
        </section>

        <!-- FAQs -->
        <section class="space-y-4">
          <h2 class="text-2xl font-display font-bold text-white">Frequently Asked Questions</h2>
          <FAQAccordion items={trek.faqs} />
        </section>
      </div>

      <!-- Right Sticky Booking Column -->
      <div class="lg:col-span-1">
        <div class="sticky top-24 rounded-3xl border border-white/20 bg-slate-900/90 p-6 shadow-2xl backdrop-blur-xl space-y-6">
          <div>
            <span class="text-xs font-bold text-brand uppercase tracking-wider">Book Expedition</span>
            <h3 class="text-2xl font-display font-bold text-white mt-1">{trek.name}</h3>
            <p class="text-xs text-ink-dim mt-1">{trek.durationDays} Days · {trek.startPoint}</p>
          </div>

          <div class="rounded-2xl border border-brand/30 bg-brand/10 p-4 text-center">
            <span class="text-xs text-ink-dim uppercase tracking-wider block">Price Starts From</span>
            <span class="text-3xl font-display font-bold text-brand" data-price-inr={trek.fromPrice}>₹{trek.fromPrice.toLocaleString('en-IN')}</span>
            <span class="text-xs text-ink-dim block mt-0.5">per person (inclusive of all meals & gear)</span>
          </div>

          <button
            data-open-modal="booking-modal"
            class="open-booking-trigger w-full cursor-pointer rounded-2xl bg-brand hover:bg-brand-deep py-3.5 text-center text-sm font-bold text-slate-950 transition-all hover:scale-105 shadow-xl shadow-brand/20"
          >
            Request Booking via WhatsApp →
          </button>

          <div class="space-y-3 pt-4 border-t border-white/10 text-xs text-ink-dim">
            <div class="flex items-center gap-2">
              <span class="text-emerald-400">✓</span>
              <span>No payment required for booking inquiry</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-400">✓</span>
              <span>Instant response on WhatsApp / Phone call</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-400">✓</span>
              <span>100% refund policy in case of weather blockage</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <BookingModal trek={trek} />
  <WhatsAppFab />
  <Footer />
</Layout>
