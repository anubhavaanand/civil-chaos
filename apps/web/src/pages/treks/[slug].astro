---
import Layout from '../../layouts/Layout.astro';
import GlassNav from '../../components/GlassNav.astro';
import WhatsAppFab from '../../components/WhatsAppFab.astro';
import Footer from '../../components/Footer.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import ElevationProfile from '../../components/ElevationProfile.astro';
import ItineraryTimeline from '../../components/ItineraryTimeline.astro';
import UpcomingBatchesTable from '../../components/UpcomingBatchesTable.astro';
import WeatherWidget from '../../components/WeatherWidget.astro';
import GearChecklist from '../../components/GearChecklist.astro';
import AltitudeAcclimatizationLab from '../../components/AltitudeAcclimatizationLab.astro';
import BookingModal from '../../components/BookingModal.astro';
import { getTreks } from '../../lib/strapi';
import type { Trek } from '../../lib/strapi';
import { SITE_CONFIG } from '../../config/site';

export async function getStaticPaths() {
  const treks = await getTreks();
  return treks.map((trek) => ({
    params: { slug: trek.slug },
    props: { trek },
  }));
}

const { trek } = Astro.props as { trek: Trek };
const maxAltFt = Math.round(trek.maxAltitudeM * 3.28084).toLocaleString('en-IN');

const difficultyColor =
  trek.difficulty === 'easy'
    ? 'text-[#34D399] border-[#34D399]/30 bg-[#34D399]/10'
    : trek.difficulty === 'moderate'
    ? 'text-[#FBBF24] border-[#FBBF24]/30 bg-[#FBBF24]/10'
    : 'text-[#FB7185] border-[#FB7185]/30 bg-[#FB7185]/10';

const touristTripSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: `${trek.name} 2027`,
  description: trek.description,
  touristType: ['Trekkers', 'Adventurers', 'Hikers'],
  provider: {
    '@type': 'TravelAgency',
    name: SITE_CONFIG.name,
    url: SITE_CONFIG.canonicalUrl,
  },
  itinerary: {
    '@type': 'ItemList',
    itemListElement: trek.itinerary.map((item, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      item: {
        '@type': 'TouristAttraction',
        name: item.title,
        description: item.description,
      },
    })),
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'INR',
    price: trek.fromPrice ?? 0,
    availability: 'https://schema.org/InStock',
    validFrom: '2026-01-01',
  },
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: trek.name,
  description: trek.description,
  image: trek.heroImage || '/images/hero-himalayas.jpg',
  offers: {
    '@type': 'Offer',
    priceCurrency: 'INR',
    price: trek.fromPrice ?? 0,
    availability: 'https://schema.org/InStock',
  },
};
---

<Layout
  title={`${trek.name} 2027 — Itinerary, Packages & Batches | ${SITE_CONFIG.name}`}
  description={trek.summary || `${trek.durationDays}-day ${trek.difficulty} Himalayan trek from ${trek.startPoint}, reaching ${trek.maxAltitudeM.toLocaleString()} m.`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify([touristTripSchema, productSchema])} is:inline />
  <GlassNav />

  <!-- 1. Expedition Summit Hero -->
  <header class="relative min-h-[75vh] w-full overflow-hidden flex items-end bg-[#050505] pt-28 pb-16">
    <img src={trek.heroImage} alt={trek.name} class="absolute inset-0 w-full h-full object-cover opacity-80" />
    <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-[#050505]/75 to-[#050505]/50"></div>

    <div class="container mx-auto px-6 max-w-7xl relative z-20">
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono mb-4">
        <a href="/treks" class="text-[#94A3B8] hover:text-[#00F2FE]">Expeditions</a>
        <span class="text-white/30">/</span>
        <span class="text-[#00F2FE] font-bold uppercase">{trek.region} Himalayas</span>
        <span class="text-white/30">/</span>
        <span class={`px-2.5 py-0.5 rounded-full font-bold uppercase border ${difficultyColor}`}>
          {trek.difficulty}
        </span>
      </div>

      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-display font-extrabold text-white tracking-tight leading-none mb-4">
        {trek.name}
      </h1>
      <p class="text-base sm:text-lg text-[#e2e8f0] max-w-3xl leading-relaxed mb-8">
        {trek.summary}
      </p>

      <!-- Key Telemetry Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 font-mono text-xs">
        <div class="p-3.5 rounded-xl bg-[#0B111E]/90 border border-white/15 backdrop-blur-md">
          <span class="block text-[10px] text-[#94A3B8] uppercase">Max Altitude</span>
          <strong class="text-sm sm:text-base text-[#00F2FE]">{trek.maxAltitudeM.toLocaleString('en-IN')}m ({maxAltFt} ft)</strong>
        </div>
        <div class="p-3.5 rounded-xl bg-[#0B111E]/90 border border-white/15 backdrop-blur-md">
          <span class="block text-[10px] text-[#94A3B8] uppercase">Duration</span>
          <strong class="text-sm sm:text-base text-white">{trek.durationDays}D / {trek.durationDays - 1}N</strong>
        </div>
        <div class="p-3.5 rounded-xl bg-[#0B111E]/90 border border-white/15 backdrop-blur-md">
          <span class="block text-[10px] text-[#94A3B8] uppercase">Total Trail</span>
          <strong class="text-sm sm:text-base text-white">{trek.trekDistanceKm} km</strong>
        </div>
        <div class="p-3.5 rounded-xl bg-[#0B111E]/90 border border-white/15 backdrop-blur-md">
          <span class="block text-[10px] text-[#94A3B8] uppercase">Basecamp</span>
          <strong class="text-sm sm:text-base text-white truncate block">{trek.startPoint.split(',')[0]}</strong>
        </div>
        <div class="p-3.5 rounded-xl bg-[#0B111E]/90 border border-white/15 backdrop-blur-md">
          <span class="block text-[10px] text-[#94A3B8] uppercase">Batch Ceiling</span>
          <strong class="text-sm sm:text-base text-[#34D399]">Max 12&ndash;15</strong>
        </div>
        <div class="p-3.5 rounded-xl bg-[#0B111E]/90 border border-white/15 backdrop-blur-md">
          <span class="block text-[10px] text-[#94A3B8] uppercase">Package From</span>
          <strong class="text-sm sm:text-base text-[#00F2FE]">₹{trek.fromPrice.toLocaleString('en-IN')}</strong>
        </div>
      </div>
    </div>
  </header>

  <!-- Sticky Quick-Jump Section Sub-Nav -->
  <nav aria-label="Trek sections" class="sticky top-20 z-30 border-y border-white/15 bg-[#070B12]/95 backdrop-blur-xl">
    <div class="container mx-auto px-6 max-w-7xl flex items-center gap-6 overflow-x-auto py-3 text-xs font-mono uppercase tracking-wider text-[#cbd5e1]">
      <a href="#packages" class="hover:text-[#00F2FE] shrink-0 font-bold text-[#00F2FE]">1. Packages</a>
      <a href="#batches" class="hover:text-[#00F2FE] shrink-0">2. Fixed Departures</a>
      <a href="#itinerary" class="hover:text-[#00F2FE] shrink-0">3. Day-by-Day Itinerary</a>
      <a href="#elevation" class="hover:text-[#00F2FE] shrink-0">4. Elevation Chart</a>
      <a href="#inclusions" class="hover:text-[#00F2FE] shrink-0">5. Inclusions</a>
      <a href="#logistics" class="hover:text-[#00F2FE] shrink-0">6. How to Reach</a>
      <a href="#gear" class="hover:text-[#00F2FE] shrink-0">7. Gear List</a>
    </div>
  </nav>

  <main class="bg-[#050505] pb-36 pt-12 w-full">
    <div class="container mx-auto px-6 max-w-7xl space-y-20">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main Left 2/3 Column -->
        <div class="lg:col-span-2 space-y-16">
          <!-- Overview -->
          <section id="overview" class="space-y-4">
            <h2 class="text-2xl sm:text-3xl font-display font-bold text-white">Expedition Overview</h2>
            <p class="text-base text-[#cbd5e1] leading-relaxed">{trek.description}</p>
            <div class="flex flex-wrap items-center gap-2 pt-2">
              <span class="text-xs font-mono uppercase text-[#94A3B8] mr-1">Best Seasons:</span>
              {trek.bestSeasons.map((season) => (
                <span class="rounded-lg bg-[#0B111E] px-3 py-1 text-xs font-mono text-[#00F2FE] border border-white/15">
                  {season}
                </span>
              ))}
            </div>
          </section>

          <!-- Strapi-Seeded Package Tiers -->
          {trek.packages && trek.packages.length > 0 && (
            <section id="packages" class="space-y-5">
              <div>
                <span class="text-xs font-mono uppercase tracking-widest text-[#00F2FE] font-bold">Strapi-Seeded Pricing Tiers</span>
                <h2 class="text-2xl sm:text-3xl font-display font-bold text-white mt-1">Choose Your Package Tier</h2>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                {trek.packages.map((pkg) => (
                  <div class={`rounded-2xl border p-6 flex flex-col justify-between gap-5 ${
                    pkg.isPopular
                      ? 'border-[#00F2FE] bg-[#0B111E]'
                      : 'border-white/15 bg-[#0B111E]/80'
                  }`}>
                    <div class="space-y-3">
                      <div class="flex items-center justify-between gap-2">
                        <h3 class="font-display text-lg font-bold text-white">{pkg.name}</h3>
                        {pkg.isPopular && (
                          <span class="px-2.5 py-0.5 rounded-full bg-[#00F2FE] text-[#050505] font-mono text-[10px] font-bold uppercase">
                            Most Popular
                          </span>
                        )}
                      </div>
                      <div class="font-display text-3xl font-extrabold text-[#00F2FE]">
                        ₹{pkg.priceINR.toLocaleString('en-IN')}
                        <span class="text-xs font-mono font-normal text-[#94A3B8]"> / climber</span>
                      </div>
                      <p class="text-xs text-[#cbd5e1] leading-relaxed">{pkg.description}</p>
                      {pkg.features && pkg.features.length > 0 && (
                        <ul class="space-y-1.5 pt-2 border-t border-white/10 text-xs text-[#e2e8f0]">
                          {pkg.features.map((f) => (
                            <li class="flex items-center gap-2">
                              <span class="text-[#34D399] font-bold">&check;</span>
                              <span>{f}</span>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                    <button
                      type="button"
                      data-open-modal="booking-modal"
                      data-package-name={pkg.name}
                      class="open-booking-trigger btn-tactile w-full py-3 rounded-xl bg-[#00F2FE] hover:bg-[#00b4d8] text-[#050505] font-mono text-xs font-bold uppercase tracking-wider cursor-pointer"
                    >
                      Select {pkg.name} &rarr;
                    </button>
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- Fixed Departures -->
          <section id="batches" class="space-y-4">
            <div class="flex items-center justify-between">
              <h2 class="text-2xl sm:text-3xl font-display font-bold text-white">Upcoming Fixed Departures</h2>
              <span class="text-xs font-mono text-[#34D399] uppercase">Live Strapi Inventory</span>
            </div>
            <UpcomingBatchesTable batches={trek.batches} trekName={trek.name} trekSlug={trek.slug} />
          </section>

          <!-- Day-by-Day Itinerary -->
          <section id="itinerary" class="space-y-6">
            <h2 class="text-2xl sm:text-3xl font-display font-bold text-white">Day-by-Day Trail Itinerary</h2>
            <ItineraryTimeline days={trek.itinerary} />
          </section>

          <!-- SVG Elevation Profile & Weather -->
          <section id="elevation" class="space-y-6">
            <h2 class="text-2xl sm:text-3xl font-display font-bold text-white">Camp-to-Camp Elevation Profile</h2>
            <ElevationProfile points={trek.altitudeProfile} maxAltitudeM={trek.maxAltitudeM} />
            <WeatherWidget />
          </section>

          <!-- Acclimatization Lab -->
          <section class="space-y-4">
            <AltitudeAcclimatizationLab initialAltitudeM={trek.maxAltitudeM} trekName={`${trek.name} Summit`} />
          </section>

          <!-- Inclusions & Exclusions -->
          <section id="inclusions" class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="rounded-2xl border border-[#34D399]/30 bg-[#0B111E] p-6 space-y-4">
              <h3 class="font-display text-lg font-bold text-[#34D399] uppercase tracking-wide">Included in Package</h3>
              <ul class="space-y-2.5 text-sm text-[#e2e8f0]">
                {trek.inclusions.map((inc) => (
                  <li class="flex items-start gap-2.5">
                    <span class="text-[#34D399] font-bold">&check;</span>
                    <span>{inc}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="rounded-2xl border border-[#FB7185]/30 bg-[#0B111E] p-6 space-y-4">
              <h3 class="font-display text-lg font-bold text-[#FB7185] uppercase tracking-wide">Exclusions</h3>
              <ul class="space-y-2.5 text-sm text-[#e2e8f0]">
                {trek.exclusions.map((exc) => (
                  <li class="flex items-start gap-2.5">
                    <span class="text-[#FB7185] font-bold">&times;</span>
                    <span>{exc}</span>
                  </li>
                ))}
              </ul>
            </div>
          </section>

          <!-- How to Reach & FAQs -->
          <section id="logistics" class="space-y-6">
            <h2 class="text-2xl sm:text-3xl font-display font-bold text-white">How to Reach Basecamp &amp; FAQs</h2>
            <div class="rounded-2xl border border-white/15 bg-[#0B111E] p-6 space-y-4">
              <h3 class="font-display font-bold text-lg text-white">Basecamp Reporting: {trek.startPoint}</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <div class="p-4 rounded-xl bg-[#05080F] border border-white/10">
                  <div class="font-mono text-xs text-[#00F2FE] uppercase font-bold mb-1">Nearest Airport</div>
                  <div class="text-[#e2e8f0]">{trek.howToReach.nearestAirport}</div>
                </div>
                <div class="p-4 rounded-xl bg-[#05080F] border border-white/10">
                  <div class="font-mono text-xs text-[#00F2FE] uppercase font-bold mb-1">Nearest Railway Station</div>
                  <div class="text-[#e2e8f0]">{trek.howToReach.nearestRailway}</div>
                </div>
              </div>
              <p class="text-sm text-[#cbd5e1] pt-2">{trek.howToReach.commuteDetails}</p>
            </div>
            <FAQAccordion items={trek.faqs} />
          </section>
        </div>

        <!-- Right 1/3 Sticky Utility Column -->
        <div id="gear" class="lg:col-span-1">
          <div class="sticky top-36 space-y-6">
            <GearChecklist />
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Sticky Bottom Booking Bar -->
  <div class="fixed bottom-0 left-0 w-full z-40 bg-[#070B12]/95 backdrop-blur-xl border-t border-white/15 shadow-2xl">
    <div class="container mx-auto px-6 max-w-7xl h-20 flex items-center justify-between gap-4">
      <div class="hidden md:flex items-center gap-6 font-mono text-xs">
        <div>
          <span class="block text-[10px] text-[#94A3B8] uppercase">Duration</span>
          <strong class="text-white">{trek.durationDays}D / {trek.durationDays - 1}N</strong>
        </div>
        <div class="h-7 w-px bg-white/15"></div>
        <div>
          <span class="block text-[10px] text-[#94A3B8] uppercase">Max Altitude</span>
          <strong class="text-[#00F2FE]">{trek.maxAltitudeM.toLocaleString('en-IN')} m</strong>
        </div>
        <div class="h-7 w-px bg-white/15"></div>
        <div>
          <span class="block text-[10px] text-[#94A3B8] uppercase">Basecamp</span>
          <strong class="text-white">{trek.startPoint.split(',')[0]}</strong>
        </div>
      </div>

      <div class="flex items-center justify-between w-full md:w-auto gap-6">
        <div>
          <span class="block text-[10px] font-mono text-[#94A3B8] uppercase">All-Inclusive From</span>
          <span class="text-2xl font-display font-extrabold text-white">₹{trek.fromPrice.toLocaleString('en-IN')}</span>
        </div>

        <button
          type="button"
          data-open-modal="booking-modal"
          class="btn-tactile open-booking-trigger px-6 py-3.5 bg-[#00F2FE] hover:bg-[#00b4d8] text-[#050505] font-mono text-xs font-bold uppercase tracking-wider rounded-xl shadow-lg cursor-pointer"
        >
          Request Booking &rarr;
        </button>
      </div>
    </div>
  </div>

  <BookingModal trek={trek} />
  <WhatsAppFab />
  <Footer />
</Layout>
