# ===========================================
# Strapi CMS - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit .env to git

# Server Configuration
# --------------------
HOST=0.0.0.0
PORT=1337

# Database - Neon Postgres
# ------------------------
# Primary: Use DATABASE_URL from Neon console (pooled connection)
# Get from: https://console.neon.tech
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://neondb_owner:xxx@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Alternative individual fields (DATABASE_URL takes precedence)
# DATABASE_HOST=ep-xxx.us-east-2.aws.neon.tech
# DATABASE_PORT=5432
# DATABASE_NAME=neondb
# DATABASE_USERNAME=neondb_owner
# DATABASE_PASSWORD=xxx
# DATABASE_SSL=true

# Cloudinary Media Storage
# ------------------------
# Free tier: 25GB storage
# Get credentials from: https://cloudinary.com/console
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_KEY=your_cloudinary_key
CLOUDINARY_SECRET=your_cloudinary_secret

# Strapi Security Secrets
# -----------------------
# Generate with: openssl rand -base64 32
# Must be exactly 4 keys for APP_KEYS (comma-separated)
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=generate_with_openssl_rand
ADMIN_JWT_SECRET=generate_with_openssl_rand
JWT_SECRET=generate_with_openssl_rand
TRANSFER_TOKEN_SALT=generate_with_openssl_rand
ENCRYPTION_KEY=generate_with_openssl_rand

# Webhook: Astro Revalidation
# ---------------------------
# Called when content changes to purge Cloudflare cache
# This is the /api/revalidate endpoint on your Astro site
WEB_REVALIDATE_URL=https://yourdomain.com/api/revalidate

# Must match STRAPI_WEBHOOK_SECRET in apps/web/.env
WEB_REVALIDATE_SECRET=your_shared_webhook_secret

# Email Notifications (Resend or SMTP)
# ------------------------------------
# Used for booking request notifications
# Option 1: Resend
RESEND_API_KEY=

# Option 2: SMTP (alternative)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourdomain.com
