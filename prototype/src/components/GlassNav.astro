---
import { SITE_CONFIG } from '../lib/site';
---

<header class="fixed top-0 left-0 right-0 z-50 p-4 md:px-8 pointer-events-none" transition:persist>
  <nav class="glass lens-edge pointer-events-auto max-w-7xl mx-auto flex items-center justify-between px-5 md:px-7 py-3.5 rounded-2xl bg-alpine/85 shadow-2xl" aria-label="Primary">
    <a href="/" class="flex items-center gap-2.5 font-display font-bold text-base md:text-lg text-ink hover:text-glacier transition-colors" transition:name="brand">
      <svg class="w-5 h-5 text-glacier" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m8 3 4 8 5-5 5 15H2L8 3z" />
      </svg>
      <span class="tracking-tight">{SITE_CONFIG.name}</span>
    </a>

    <ul class="hidden md:flex items-center gap-8 list-none">
      <li><a href="/treks" class="text-sm font-medium text-frost hover:text-glacier transition-colors">Treks</a></li>
      <li><a href="/#map" class="text-sm font-medium text-frost hover:text-glacier transition-colors">Map</a></li>
      <li><a href="/#departures" class="text-sm font-medium text-frost hover:text-glacier transition-colors">Departures</a></li>
    </ul>

    <a
      href="/#booking"
      class="hidden sm:inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-glacier/40 bg-glacier/10 text-xs font-mono font-bold text-glacier uppercase tracking-wider hover:bg-glacier/20 transition-colors btn-tactile"
    >
      Reserve Batch <span aria-hidden="true">&rarr;</span>
    </a>

    <!-- Mobile menu: CSS-only checkbox pattern -->
    <div class="md:hidden flex items-center">
      <input type="checkbox" id="mobile-menu-toggle" class="peer hidden" />
      <label for="mobile-menu-toggle" class="cursor-pointer text-frost hover:text-glacier p-1.5" aria-label="Toggle mobile menu">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </label>
      <div class="absolute top-20 left-4 right-4 glass bg-obsidian/95 rounded-2xl hidden peer-checked:block shadow-2xl p-5">
        <ul class="flex flex-col gap-3 list-none">
          <li><a href="/treks" class="block py-2 text-frost hover:text-glacier font-medium">Treks</a></li>
          <li><a href="/#map" class="block py-2 text-frost hover:text-glacier font-medium">Map</a></li>
          <li><a href="/#departures" class="block py-2 text-frost hover:text-glacier font-medium">Departures</a></li>
          <li><a href="/#booking" class="block py-2 text-glacier font-bold">Reserve a Batch</a></li>
        </ul>
      </div>
    </div>
  </nav>
</header>
