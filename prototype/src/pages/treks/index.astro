---
import Layout from '../../layouts/Layout.astro';
import TrekCard from '../../components/TrekCard.astro';
import { getTreks, difficultyLabel } from '../../lib/data';

const treks = await getTreks();

const regionCounts = {
  all: treks.length,
  Garhwal: treks.filter((t) => t.region === 'Garhwal').length,
  Kumaon: treks.filter((t) => t.region === 'Kumaon').length,
  Himachal: treks.filter((t) => t.region === 'Himachal').length,
};
const altitudeCounts = {
  all: treks.length,
  sub4k: treks.filter((t) => t.maxAltitudeM < 4000).length,
  mid4k: treks.filter((t) => t.maxAltitudeM >= 4000 && t.maxAltitudeM <= 5000).length,
  above5k: treks.filter((t) => t.maxAltitudeM > 5000).length,
};
const difficultyCounts = {
  all: treks.length,
  easy: treks.filter((t) => t.difficulty === 'easy').length,
  moderate: treks.filter((t) => t.difficulty === 'moderate').length,
  difficult: treks.filter((t) => t.difficulty === 'difficult').length,
};
---

<Layout title="Expedition Catalog | Dream of The Holy Himalayas">
  <main class="pt-32 pb-24 min-h-screen">
    <div class="container mx-auto px-6 max-w-7xl">
      <!-- Header -->
      <div class="mt-2 mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-white/10">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="h-[2px] w-8 bg-glacier" aria-hidden="true"></span>
            <span class="text-glacier font-mono text-xs tracking-widest uppercase font-bold">Himalayan Route Roster</span>
          </div>
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-display font-extrabold text-ink tracking-tight">EXPEDITION CATALOG</h1>
          <p class="text-silver text-sm sm:text-base mt-3 max-w-2xl font-light max-w-[65ch]">
            {treks.length} precision-scouted alpine routes across Garhwal, Kumaon, and Himachal Pradesh. Intimate micro-batches led by native Mautar mountain guides.
          </p>
        </div>
        <div class="flex items-center gap-2 p-3 rounded-xl border border-white/10 glass bg-alpine/80 font-mono text-xs self-start md:self-auto">
          <span class="w-2 h-2 rounded-full bg-glacier ping-ring" aria-hidden="true"></span>
          <span class="text-silver uppercase tracking-wider">Matching Routes:</span>
          <span id="active-routes-count" class="font-bold text-glacier text-sm tnum">{treks.length}</span>
        </div>
      </div>

      <!-- Filter matrix -->
      <div class="double-bezel-outer mb-10">
        <div class="double-bezel-inner p-5 sm:p-6">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-5 border-b border-white/10">
            <div class="relative flex-1 max-w-md">
              <span class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none text-muted" aria-hidden="true">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </span>
              <input type="text" id="trekSearchInput" placeholder="Search summit, pass, valley, or region..."
                class="w-full bg-obsidian border border-white/15 focus:border-glacier rounded-xl pl-10 pr-4 py-2 text-sm text-ink placeholder-muted outline-none transition-all font-mono" />
            </div>

            <div class="flex items-center gap-3 self-end md:self-auto">
              <div class="inline-flex rounded-lg border border-white/10 bg-obsidian p-1 font-mono text-xs" role="group" aria-label="View mode">
                <button type="button" id="viewBentoBtn" aria-pressed="true" class="btn-tactile flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-glacier text-obsidian font-bold transition-all cursor-pointer">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                  </svg>
                  <span>Cards</span>
                </button>
                <button type="button" id="viewMatrixBtn" aria-pressed="false" class="btn-tactile flex items-center gap-1.5 px-3 py-1.5 rounded-md text-muted hover:text-ink transition-all cursor-pointer">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                  </svg>
                  <span>Matrix</span>
                </button>
              </div>
              <button type="button" id="resetAllFiltersBtn" class="btn-tactile px-3 py-2 rounded-lg border border-white/10 text-[11px] font-mono text-muted hover:border-difficult/40 hover:text-difficult uppercase tracking-wider transition-all cursor-pointer">Reset</button>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-5">
            <div>
              <div class="flex items-center gap-2 mb-2.5">
                <svg class="w-3.5 h-3.5 text-glacier" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                </svg>
                <span class="text-[10px] font-mono uppercase tracking-widest text-frost font-bold">Himalayan Region</span>
              </div>
              <div class="flex flex-wrap gap-1.5" data-filter-group="region">
                <button type="button" data-value="all" class="filter-pill btn-tactile px-2.5 py-1 rounded-md text-xs font-mono border border-glacier bg-glacier text-obsidian font-bold cursor-pointer">All ({regionCounts.all})</button>
                {(['Garhwal', 'Kumaon', 'Himachal'] as const).map((r) => (
                  <button type="button" data-value={r} class="filter-pill btn-tactile px-2.5 py-1 rounded-md text-xs font-mono border border-white/10 text-frost hover:border-glacier/40 cursor-pointer">{r} ({regionCounts[r]})</button>
                ))}
              </div>
            </div>

            <div>
              <div class="flex items-center gap-2 mb-2.5">
                <svg class="w-3.5 h-3.5 text-glacier" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
                <span class="text-[10px] font-mono uppercase tracking-widest text-frost font-bold">Max Altitude Band</span>
              </div>
              <div class="flex flex-wrap gap-1.5" data-filter-group="altitude">
                <button type="button" data-value="all" class="filter-pill btn-tactile px-2.5 py-1 rounded-md text-xs font-mono border border-glacier bg-glacier text-obsidian font-bold cursor-pointer">All ({altitudeCounts.all})</button>
                <button type="button" data-value="sub4k" class="filter-pill btn-tactile px-2.5 py-1 rounded-md text-xs font-mono border border-white/10 text-frost hover:border-glacier/40 cursor-pointer">&lt; 4,000m ({altitudeCounts.sub4k})</button>
                <button type="button" data-value="mid4k" class="filter-pill btn-tactile px-2.5 py-1 rounded-md text-xs font-mono border border-white/10 text-frost hover:border-glacier/40 cursor-pointer">4,000-5,000m ({altitudeCounts.mid4k})</button>
                <button type="button" data-value="above5k" class="filter-pill btn-tactile px-2.5 py-1 rounded-md text-xs font-mono border border-white/10 text-frost hover:border-glacier/40 cursor-pointer">&gt; 5,000m ({altitudeCounts.above5k})</button>
              </div>
            </div>

            <div>
              <div class="flex items-center gap-2 mb-2.5">
                <svg class="w-3.5 h-3.5 text-glacier" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span class="text-[10px] font-mono uppercase tracking-widest text-frost font-bold">Trail Rigor</span>
              </div>
              <div class="flex flex-wrap gap-1.5" data-filter-group="difficulty">
                <button type="button" data-value="all" class="filter-pill btn-tactile px-2.5 py-1 rounded-md text-xs font-mono border border-glacier bg-glacier text-obsidian font-bold cursor-pointer">All ({difficultyCounts.all})</button>
                {(['easy', 'moderate', 'difficult'] as const).map((d) => (
                  <button type="button" data-value={d} class="filter-pill btn-tactile px-2.5 py-1 rounded-md text-xs font-mono border border-white/10 text-frost hover:border-glacier/40 cursor-pointer">{difficultyLabel(d)} ({difficultyCounts[d]})</button>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Bento view -->
      <div id="treks-bento-view" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {treks.map((trek) => (
          <div class="trek-item-wrapper" data-name={trek.name.toLowerCase()} data-region={trek.region} data-altitude={trek.maxAltitudeM} data-difficulty={trek.difficulty}>
            <TrekCard trek={trek} />
          </div>
        ))}
      </div>

      <!-- Matrix view -->
      <div id="treks-matrix-view" class="hidden double-bezel-outer overflow-hidden">
        <div class="double-bezel-inner overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse font-mono">
            <thead>
              <tr class="border-b border-white/10 bg-obsidian/60 text-[11px] uppercase tracking-wider text-silver">
                <th class="p-4">Expedition Route</th>
                <th class="p-4">Sector</th>
                <th class="p-4">Peak Datum</th>
                <th class="p-4">Distance</th>
                <th class="p-4">Duration</th>
                <th class="p-4">Rigor</th>
                <th class="p-4 text-right">Starting Fee</th>
                <th class="p-4 text-center">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {treks.map((trek) => (
                <tr class="trek-matrix-row hover:bg-white/[0.02] transition-colors" data-name={trek.name.toLowerCase()} data-region={trek.region} data-altitude={trek.maxAltitudeM} data-difficulty={trek.difficulty}>
                  <td class="p-4 font-bold text-ink font-display">
                    <a href={`/treks/${trek.slug}`} class="hover:text-glacier transition-colors">{trek.name}</a>
                  </td>
                  <td class="p-4 text-silver/80 text-xs">{trek.region}</td>
                  <td class="p-4 text-ink font-bold tnum">
                    {trek.maxAltitudeM.toLocaleString('en-IN')}m
                    <span class="text-[10px] text-muted block font-normal tnum">({Math.round(trek.maxAltitudeM * 3.28084).toLocaleString('en-IN')} ft)</span>
                  </td>
                  <td class="p-4 text-silver/80 text-xs tnum">{trek.trekDistanceKm} km</td>
                  <td class="p-4 text-silver/80 text-xs">{trek.durationDays} Days</td>
                  <td class="p-4">
                    <span class={`px-2 py-0.5 rounded-sm text-[10px] font-mono uppercase border ${
                      trek.difficulty === 'easy' ? 'text-easy border-easy/30 bg-easy/10' : trek.difficulty === 'moderate' ? 'text-moderate border-moderate/30 bg-moderate/10' : 'text-difficult border-difficult/30 bg-difficult/10'
                    }`}>{trek.difficulty}</span>
                  </td>
                  <td class="p-4 text-right font-bold text-glacier tnum">&#8377;{trek.fromPrice.toLocaleString('en-IN')}</td>
                  <td class="p-4 text-center">
                    <a href={`/treks/${trek.slug}`} class="btn-tactile inline-flex items-center gap-1 px-3 py-1 rounded border border-white/15 text-[11px] text-ink hover:border-glacier hover:text-glacier transition-all font-mono cursor-pointer">
                      Inspect <span aria-hidden="true">&rarr;</span>
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Empty state -->
      <div id="no-treks-empty" class="hidden text-center py-20 rounded-2xl border border-white/10 bg-alpine/60 p-8 mt-6">
        <h3 class="font-display text-xl font-bold text-ink mb-2">No Matching Routes Found</h3>
        <p class="text-sm text-muted mb-6 max-w-md mx-auto">No expeditions match your current search query and filter criteria. Adjust your criteria or reset filters.</p>
        <button type="button" id="reset-empty-btn" class="btn-tactile bg-glacier text-obsidian font-bold font-mono px-6 py-2.5 rounded-lg text-xs uppercase tracking-wider cursor-pointer">Reset All Filters</button>
      </div>
    </div>
  </main>
</Layout>

<script>
  const state = { search: '', region: 'all', altitude: 'all', difficulty: 'all' };

  const searchInput = document.getElementById('trekSearchInput') as HTMLInputElement | null;
  const bentoCards = document.querySelectorAll<HTMLElement>('.trek-item-wrapper');
  const matrixRows = document.querySelectorAll<HTMLElement>('.trek-matrix-row');
  const bentoView = document.getElementById('treks-bento-view');
  const matrixView = document.getElementById('treks-matrix-view');
  const viewBentoBtn = document.getElementById('viewBentoBtn') as HTMLButtonElement | null;
  const viewMatrixBtn = document.getElementById('viewMatrixBtn') as HTMLButtonElement | null;
  const counterEl = document.getElementById('active-routes-count');
  const emptyState = document.getElementById('no-treks-empty');
  const resetBtn = document.getElementById('resetAllFiltersBtn');
  const resetEmptyBtn = document.getElementById('reset-empty-btn');

  const ACTIVE = ['border-glacier', 'bg-glacier', 'text-obsidian', 'font-bold'];
  const INACTIVE = ['border-white/10', 'text-frost'];

  function evaluateFilters() {
    const query = state.search.trim().toLowerCase();
    let visible = 0;

    const match = (item: HTMLElement) => {
      const name = item.dataset.name || '';
      const region = item.dataset.region || '';
      const altitude = parseInt(item.dataset.altitude || '0', 10);
      const difficulty = item.dataset.difficulty || '';

      if (query && !name.includes(query) && !region.toLowerCase().includes(query)) return false;
      if (state.region !== 'all' && region !== state.region) return false;
      if (state.altitude === 'sub4k' && altitude >= 4000) return false;
      if (state.altitude === 'mid4k' && (altitude < 4000 || altitude > 5000)) return false;
      if (state.altitude === 'above5k' && altitude <= 5000) return false;
      if (state.difficulty !== 'all' && difficulty !== state.difficulty) return false;
      return true;
    };

    bentoCards.forEach((card) => {
      card.style.display = match(card) ? '' : 'none';
      if (match(card)) visible++;
    });
    matrixRows.forEach((row) => {
      row.style.display = match(row) ? '' : 'none';
    });

    if (counterEl) counterEl.textContent = String(visible);
    emptyState?.classList.toggle('hidden', visible !== 0);
  }

  document.querySelectorAll<HTMLElement>('[data-filter-group]').forEach((group) => {
    const groupName = group.dataset.filterGroup as keyof typeof state;
    group.querySelectorAll<HTMLButtonElement>('.filter-pill').forEach((pill) => {
      pill.addEventListener('click', () => {
        (state as any)[groupName] = pill.dataset.value || 'all';
        group.querySelectorAll('.filter-pill').forEach((p) => {
          p.classList.add(...INACTIVE);
          p.classList.remove(...ACTIVE);
        });
        pill.classList.add(...ACTIVE);
        pill.classList.remove(...INACTIVE);
        evaluateFilters();
      });
    });
  });

  searchInput?.addEventListener('input', () => {
    state.search = searchInput.value;
    evaluateFilters();
  });

  function setView(view: 'bento' | 'matrix') {
    const isBento = view === 'bento';
    bentoView?.classList.toggle('hidden', !isBento);
    matrixView?.classList.toggle('hidden', isBento);
    viewBentoBtn?.setAttribute('aria-pressed', String(isBento));
    viewMatrixBtn?.setAttribute('aria-pressed', String(!isBento));
    viewBentoBtn?.classList.toggle('bg-glacier', isBento);
    viewBentoBtn?.classList.toggle('text-obsidian', isBento);
    viewBentoBtn?.classList.toggle('text-muted', !isBento);
    viewMatrixBtn?.classList.toggle('bg-glacier', !isBento);
    viewMatrixBtn?.classList.toggle('text-obsidian', !isBento);
    viewMatrixBtn?.classList.toggle('text-muted', isBento);
  }
  viewBentoBtn?.addEventListener('click', () => setView('bento'));
  viewMatrixBtn?.addEventListener('click', () => setView('matrix'));

  function resetAll() {
    state.search = '';
    state.region = 'all';
    state.altitude = 'all';
    state.difficulty = 'all';
    if (searchInput) searchInput.value = '';
    document.querySelectorAll<HTMLElement>('[data-filter-group]').forEach((group) => {
      group.querySelectorAll<HTMLButtonElement>('.filter-pill').forEach((p) => {
        const isAll = p.dataset.value === 'all';
        p.classList.toggle('border-glacier', isAll);
        p.classList.toggle('bg-glacier', isAll);
        p.classList.toggle('text-obsidian', isAll);
        p.classList.toggle('font-bold', isAll);
        p.classList.toggle('border-white/10', !isAll);
        p.classList.toggle('text-frost', !isAll);
      });
    });
    evaluateFilters();
  }
  resetBtn?.addEventListener('click', resetAll);
  resetEmptyBtn?.addEventListener('click', resetAll);
</script>
